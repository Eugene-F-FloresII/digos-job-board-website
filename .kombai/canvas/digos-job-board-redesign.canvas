      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#2b2622] text-[#f7f5f0] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:Inter,system-ui,sans-serif\">\n    <header class=\"border-b border-[#3f3a36] bg-[#2b2622]\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"flex h-[58px] items-center justify-between px-5\" data-kid=\"1-1-1\" data-name=\"header top row with logo and menu\">\n            <a class=\"flex items-center gap-2.5 text-[15px] font-medium tracking-[-.2px] text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#jobs\">\n                <span class=\"flex h-7 w-7 items-center justify-center rounded-[3px] bg-[#f7f5f0] text-[13px] font-semibold text-[#2b2622]\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram badge\">\n                    D\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DigosJobs\n                </span>\n            </a>\n            <button aria-label=\"Open navigation\" class=\"flex h-10 w-10 items-center justify-center rounded-full text-[18px] text-[#c9c0ad]\" data-kid=\"1-1-1-2\" data-name=\"open navigation toggle button\" type=\"button\">\n                <i class=\"icon-menu\" data-kid=\"1-1-1-2-1\" data-name=\"menu hamburger icon\">\n                </i>\n            </button>\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"flex h-[42px] items-center gap-7 overflow-x-auto border-t border-[#3f3a36] px-5 text-[13px] font-medium\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n            <a aria-current=\"page\" class=\"flex h-full items-center border-b border-[#f7f5f0] text-[#f7f5f0] no-underline\" data-kid=\"1-1-2-1\" data-name=\"jobs navigation link\" href=\"#jobs\">\n                Jobs\n            </a>\n            <a class=\"whitespace-nowrap text-[#aea69c] no-underline\" data-kid=\"1-1-2-2\" data-name=\"applications navigation link\" href=\"#applications\">\n                Applications\n            </a>\n            <a class=\"whitespace-nowrap text-[#aea69c] no-underline\" data-kid=\"1-1-2-3\" data-name=\"employer portal navigation link\" href=\"#employer\">\n                Employer portal\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto w-full max-w-[720px] px-5 pb-[126px] pt-5\" data-kid=\"1-2\" data-name=\"main content area\">\n        <a class=\"inline-flex min-h-[40px] items-center gap-2 text-[14px] font-medium text-[#c9c0ad] no-underline\" data-kid=\"1-2-1\" data-name=\"back to jobs link\" href=\"#jobs\">\n            <i class=\"icon-arrow-left text-[16px]\" data-kid=\"1-2-1-1\" data-name=\"left arrow icon\">\n            </i>\n            <span data-kid=\"1-2-1-2\" data-name=\"back link label text\">\n                Back to jobs\n            </span>\n        </a>\n        <section class=\"pt-4\" data-kid=\"1-2-2\" data-name=\"job title section\">\n            <p class=\"mb-2 text-[12px] text-[#aea69c]\" data-kid=\"1-2-2-1\" data-name=\"job location text\">\n                Digos Central Mall\n            </p>\n            <h1 class=\"m-0 text-[30px] font-medium leading-[1.12] tracking-[-1px] text-[#f7f5f0]\" data-kid=\"1-2-2-2\" data-name=\"job title headline\">\n                Store Manager\n            </h1>\n            <div class=\"mt-3 flex items-center gap-2 text-[13px] text-[#dad2c1]\" data-kid=\"1-2-2-3\" data-name=\"verified employer badge row\">\n                <i class=\"icon-shield-check text-[15px] text-[#c9c0ad]\" data-kid=\"1-2-2-3-1\" data-name=\"shield check icon\">\n                </i>\n                <span data-kid=\"1-2-2-3-2\" data-name=\"verified employer label text\">\n                    Employer documents reviewed\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Job facts\" class=\"mt-6 border-y border-[#3f3a36] py-4\" data-kid=\"1-2-3\" data-name=\"job facts summary section\">\n            <div class=\"grid grid-cols-2 gap-x-4 gap-y-4\" data-kid=\"1-2-3-1\" data-name=\"job facts grid layout\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"pay fact card\">\n                    <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-1\" data-name=\"pay label text\">\n                        Pay\n                    </p>\n                    <p class=\"m-0 text-[17px] font-medium tracking-[-.35px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1-2\" data-name=\"pay amount value\" style=\"font-family:'DM Mono',monospace\">\n                        ₱15k–₱20k\n                    </p>\n                    <p class=\"m-0 mt-0.5 text-[13px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-1-3\" data-name=\"pay period text\">\n                        per month\n                    </p>\n                </div>\n                <div data-kid=\"1-2-3-1-2\" data-name=\"employment type fact card\">\n                    <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-2-1\" data-name=\"employment label text\">\n                        Employment\n                    </p>\n                    <p class=\"m-0 text-[14px] font-medium text-[#f7f5f0]\" data-kid=\"1-2-3-1-2-2\" data-name=\"employment type value\">\n                        Full-time\n                    </p>\n                </div>\n                <div data-kid=\"1-2-3-1-3\" data-name=\"barangay area fact card\">\n                    <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-3-1\" data-name=\"barangay area label text\">\n                        Barangay / area\n                    </p>\n                    <p class=\"m-0 flex items-center gap-1.5 text-[14px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-3-2\" data-name=\"barangay area value row\">\n                        <i class=\"icon-map-pin text-[14px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-3-2-1\" data-name=\"map pin icon\">\n                        </i>\n                        Zone 1 (Poblacion)\n                    </p>\n                </div>\n                <div data-kid=\"1-2-3-1-4\" data-name=\"work setup fact card\">\n                    <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-4-1\" data-name=\"work setup label text\">\n                        Work setup\n                    </p>\n                    <p class=\"m-0 text-[14px] text-[#dad2c1]\" data-kid=\"1-2-3-1-4-2\" data-name=\"work setup value text\">\n                        Not specified\n                    </p>\n                </div>\n                <div class=\"col-span-2 border-t border-[#3f3a36] pt-3\" data-kid=\"1-2-3-1-5\" data-name=\"getting there fact card\">\n                    <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-5-1\" data-name=\"getting there label text\">\n                        Getting there\n                    </p>\n                    <p class=\"m-0 flex items-center gap-1.5 text-[14px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-5-2\" data-name=\"getting there value row\">\n                        <i class=\"icon-bus-front text-[15px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-5-2-1\" data-name=\"bus front icon\">\n                        </i>\n                        Walk from Public Market\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-6\" data-kid=\"1-2-4\" data-name=\"how to apply section\">\n            <h2 class=\"mb-2 text-[18px] font-medium tracking-[-.35px] text-[#f7f5f0]\" data-kid=\"1-2-4-1\" data-name=\"how to apply headline\">\n                What you’ll need to apply\n            </h2>\n            <p class=\"mb-3 text-[13px] leading-[1.55] text-[#c9c0ad]\" data-kid=\"1-2-4-2\" data-name=\"how to apply description text\">\n                The Digos Talent Form asks for your name, phone, barangay, education, and skills or experience.\n            </p>\n            <p class=\"m-0 text-[13px] leading-[1.5] text-[#dad2c1]\" data-kid=\"1-2-4-3\" data-name=\"résumé optional note text\">\n                A résumé is optional.\n            </p>\n        </section>\n        <section class=\"mt-6 border-t border-[#3f3a36] pt-5\" data-kid=\"1-2-5\" data-name=\"requirements section\">\n            <h2 class=\"mb-2 text-[18px] font-medium tracking-[-.35px] text-[#f7f5f0]\" data-kid=\"1-2-5-1\" data-name=\"requirements headline\">\n                Requirements\n            </h2>\n            <ul class=\"m-0 list-disc space-y-2 pl-5 text-[13px] leading-[1.5] text-[#dad2c1]\" data-kid=\"1-2-5-2\" data-name=\"requirements list\">\n                <li data-kid=\"1-2-5-2-1\" data-name=\"requirements list item\">\n                    Digos City resident, preferably near Zone 1 (Poblacion).\n                </li>\n                <li data-kid=\"1-2-5-2-2\" data-name=\"requirements list item\">\n                    At least 6 months of related experience.\n                </li>\n                <li data-kid=\"1-2-5-2-3\" data-name=\"requirements list item\">\n                    Clear communication and a customer-first attitude.\n                </li>\n                <li data-kid=\"1-2-5-2-4\" data-name=\"requirements list item\">\n                    Available to start immediately.\n                </li>\n            </ul>\n        </section>\n        <section class=\"mt-6 border-t border-[#3f3a36] pt-5\" data-kid=\"1-2-6\" data-name=\"about the work section\">\n            <h2 class=\"mb-2 text-[18px] font-medium tracking-[-.35px] text-[#f7f5f0]\" data-kid=\"1-2-6-1\" data-name=\"about the work headline\">\n                About this work\n            </h2>\n            <p class=\"m-0 text-[13px] leading-[1.6] text-[#c9c0ad]\" data-kid=\"1-2-6-2\" data-name=\"about the work description text\">\n                Support daily store operations, customer service, and local inventory. The employer is looking for someone nearby who can commit to standard operating hours.\n            </p>\n        </section>\n    </main>\n    <footer class=\"fixed inset-x-0 bottom-0 border-t border-[#3f3a36] bg-[#2b2622] px-5 pb-[max(16px,env(safe-area-inset-bottom))] pt-3\" data-kid=\"1-3\" data-name=\"fixed footer action bar\">\n        <p class=\"mx-auto mb-2 max-w-[720px] text-[12px] leading-4 text-[#aea69c]\" data-kid=\"1-3-1\" data-name=\"footer help text\">\n            Apply with the short talent form. You can add a résumé if you have one.\n        </p>\n        <button class=\"mx-auto flex min-h-[48px] w-full max-w-[720px] items-center justify-between rounded-[3px] bg-[#f7f5f0] px-4 text-[14px] font-medium text-[#2b2622]\" data-kid=\"1-3-2\" data-name=\"primary apply button\" type=\"button\">\n            <span data-kid=\"1-3-2-1\" data-name=\"apply button label text\">\n                Apply for Store Manager\n            </span>\n            <i class=\"icon-arrow-right text-[17px]\" data-kid=\"1-3-2-2\" data-name=\"right arrow icon\">\n            </i>\n        </button>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-11T13:21:56.797164+00:00",
      "modified": "2026-10-11T13:22:08.316739+00:00",
      "id": "var_f60145b8850e",
      "contentHeight": 1127
    },
    "var_09d42213c817": {
      "type": "variant",
      "label": "B · Local vacancies",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7140,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.bulletin-shell { background:#2b2622; color:#f7f5f0; font-family:Inter,system-ui,sans-serif; min-height:100vh; }\n.bulletin-main { width:min(1120px, calc(100% - 64px)); margin:0 auto; padding:46px 0 64px; }\n.bulletin-grid { display:grid; grid-template-columns:minmax(0,1fr) 210px; gap:48px; }\n.bulletin-search { display:grid; grid-template-columns:minmax(210px,1fr) minmax(180px,.58fr) auto; align-items:end; gap:12px; }\n.bulletin-row { display:grid; grid-template-columns:minmax(230px,1.3fr) minmax(170px,.8fr) minmax(130px,.65fr) minmax(190px,1fr) 104px; align-items:center; gap:20px; min-height:86px; border-bottom:1px solid #3f3a36; }\n.bulletin-row:first-of-type { border-top:1px solid #3f3a36; }\n.bulletin-aside { align-self:start; border-left:1px solid #3f3a36; padding-left:24px; }\n@media (max-width:760px) {\n .bulletin-main { width:calc(100% - 32px); padding:28px 0 42px; }\n .bulletin-grid { grid-template-columns:1fr; gap:28px; }\n .bulletin-search { grid-template-columns:1fr; gap:10px; }\n .bulletin-row { grid-template-columns:minmax(0,1fr) auto; gap:5px 16px; padding:16px 0; min-height:auto; }\n .bulletin-role { grid-column:1/-1; }\n .bulletin-commute { grid-column:1/-1; }\n .bulletin-aside { border-left:0; border-top:1px solid #3f3a36; padding:18px 0 0; }\n .bulletin-navlinks { display:none!important; }\n .bulletin-mobile-nav { display:flex!important; }\n}\n</style>\n<div class=\"bulletin-shell\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#3f3a36] bg-[#2b2622]\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"mx-auto flex h-[68px] w-[min(1280px,calc(100%-48px))] items-center justify-between max-sm:w-[calc(100%-32px)]\" data-kid=\"1-1-1\" data-name=\"header inner flex container\">\n            <a class=\"flex items-center gap-3 text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#jobs\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-[4px] border border-[#aea69c] text-[14px] font-medium\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram box\">\n                    D\n                </span>\n                <span class=\"text-[16px] font-medium tracking-[-0.2px]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DigosJobs\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"bulletin-navlinks flex items-center gap-8 text-[14px]\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n                <a class=\"text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"navigation jobs link\" href=\"#jobs\">\n                    Jobs\n                </a>\n                <a class=\"text-[#c9c0ad] no-underline\" data-kid=\"1-1-1-2-2\" data-name=\"navigation applications link\" href=\"#applications\">\n                    Applications\n                </a>\n                <a class=\"text-[#c9c0ad] no-underline\" data-kid=\"1-1-1-2-3\" data-name=\"navigation employer portal link\" href=\"#employers\">\n                    Employer portal\n                </a>\n            </nav>\n            <a class=\"hidden rounded-[3px] px-3 py-2 text-[13px] text-[#c9c0ad] underline decoration-[#6d655d] underline-offset-4 no-underline max-sm:block\" data-kid=\"1-1-1-3\" data-name=\"mobile applications shortcut link\" href=\"#applications\">\n                Applications\n            </a>\n        </div>\n    </header>\n    <main class=\"bulletin-main\" data-kid=\"1-2\" data-name=\"main content area\" id=\"jobs\">\n        <div class=\"bulletin-grid\" data-kid=\"1-2-1\" data-name=\"two-column jobs grid\">\n            <section data-kid=\"1-2-1-1\" data-name=\"jobs list section\">\n                <div class=\"mb-7 max-w-[720px]\" data-kid=\"1-2-1-1-1\" data-name=\"page headline wrapper\">\n                    <h1 class=\"mb-3 text-[38px] font-normal leading-[1.12] tracking-[-1.1px] max-sm:text-[30px]\" data-kid=\"1-2-1-1-1-1\" data-name=\"page hero headline\">\n                        Jobs open in Digos City\n                    </h1>\n                    <p class=\"max-w-[600px] text-[16px] leading-6 text-[#c9c0ad]\" data-kid=\"1-2-1-1-1-2\" data-name=\"page hero description text\">\n                        Compare pay, location and employment type before you apply. Search local roles by title or barangay.\n                    </p>\n                </div>\n                <form aria-label=\"Search local jobs\" class=\"bulletin-search mb-8 border-b border-[#3f3a36] pb-7\" data-kid=\"1-2-1-1-2\" data-name=\"jobs search form\">\n                    <div data-kid=\"1-2-1-1-2-1\" data-name=\"keyword search field container\">\n                        <label class=\"mb-2 block text-[13px] font-medium text-[#dad2c1]\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"keyword search label\" for=\"role-search\">\n                            Role or keyword\n                        </label>\n                        <div class=\"flex h-11 items-center gap-3 rounded-[4px] border border-[#3f3a36] bg-[#383330] px-3\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"keyword search input wrapper\">\n                            <i aria-hidden=\"true\" class=\"icon-search text-[16px] text-[#aea69c]\" data-kid=\"1-2-1-1-2-1-2-1\" data-name=\"search magnifier icon\">\n                            </i>\n                            <input class=\"h-full w-full bg-transparent text-[14px] text-[#f7f5f0] outline-none placeholder:text-[#aea69c]\" data-kid=\"1-2-1-1-2-1-2-2\" data-name=\"keyword search input field\" id=\"role-search\" placeholder=\"e.g. cashier\" type=\"search\"/>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-1-1-2-2\" data-name=\"area search field container\">\n                        <label class=\"mb-2 block text-[13px] font-medium text-[#dad2c1]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"area search label\" for=\"area-search\">\n                            Barangay or area\n                        </label>\n                        <select class=\"h-11 w-full rounded-[4px] border border-[#3f3a36] bg-[#383330] px-3 text-[14px] text-[#f7f5f0] outline-none\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"area selection dropdown\" id=\"area-search\">\n                            <option data-kid=\"1-2-1-1-2-2-2-1\" data-name=\"all areas dropdown option\">\n                                All Digos City\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-2-2\" data-name=\"zone 1 dropdown option\">\n                                Zone 1 (Poblacion)\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-2-3\" data-name=\"tres de mayo dropdown option\">\n                                Tres de Mayo\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-2-4\" data-name=\"matti area dropdown option\">\n                                Matti Area\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-2-5\" data-name=\"cogon dropdown option\">\n                                Cogon\n                            </option>\n                        </select>\n                    </div>\n                    <button class=\"h-11 rounded-[3px] bg-[#f7f5f0] px-5 text-[14px] font-medium text-[#2b2622] hover:bg-[#dad2c1]\" data-kid=\"1-2-1-1-2-3\" data-name=\"search jobs submit button\" type=\"button\">\n                        Search jobs\n                    </button>\n                </form>\n                <div class=\"mb-7 flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-2-1-1-3\" data-name=\"results toolbar row\">\n                    <p class=\"m-0 text-[13px] text-[#aea69c]\" data-kid=\"1-2-1-1-3-1\" data-name=\"results count label text\">\n                        Browse open roles in Digos\n                    </p>\n                    <button class=\"inline-flex min-h-[40px] items-center gap-2 rounded-[3px] border border-[#3f3a36] px-3 text-[13px] text-[#dad2c1] hover:bg-[#383330]\" data-kid=\"1-2-1-1-3-2\" data-name=\"verified employers filter button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-sliders-horizontal text-[14px]\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"filter sliders icon\">\n                        </i>\n                        Verified employers\n                    </button>\n                </div>\n                <section aria-labelledby=\"monthly-heading\" class=\"mb-9\" data-kid=\"1-2-1-1-4\" data-name=\"monthly pay job group\">\n                    <div class=\"mb-2 flex items-baseline justify-between gap-3\" data-kid=\"1-2-1-1-4-1\" data-name=\"monthly pay section header row\">\n                        <h2 class=\"m-0 text-[20px] font-medium tracking-[-0.25px]\" data-kid=\"1-2-1-1-4-1-1\" data-name=\"monthly pay section heading\" id=\"monthly-heading\">\n                            Monthly pay\n                        </h2>\n                        <span class=\"text-[12px] text-[#aea69c]\" data-kid=\"1-2-1-1-4-1-2\" data-name=\"monthly salary note caption\">\n                            Salary shown as listed\n                        </span>\n                    </div>\n                    <div class=\"bulletin-row text-[13px] text-[#c9c0ad]\" data-kid=\"1-2-1-1-4-2\" data-name=\"store manager job row\">\n                        <div class=\"bulletin-role py-3\" data-kid=\"1-2-1-1-4-2-1\" data-name=\"store manager role cell\">\n                            <a class=\"block text-[16px] font-medium text-[#f7f5f0] underline decoration-[#6d655d] underline-offset-4\" data-kid=\"1-2-1-1-4-2-1-1\" data-name=\"store manager job title link\" href=\"#store-manager\">\n                                Store Manager\n                            </a>\n                            <span class=\"mt-1 block text-[13px] text-[#aea69c]\" data-kid=\"1-2-1-1-4-2-1-2\" data-name=\"store manager employer name caption\">\n                                Digos Central Mall\n                            </span>\n                        </div>\n                        <span class=\"font-mono text-[14px] text-[#f7f5f0]\" data-kid=\"1-2-1-1-4-2-2\" data-name=\"store manager salary amount\">\n                            ₱15k - ₱20k / mo\n                        </span>\n                        <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-1-1-4-2-3\" data-name=\"store manager location tag\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin text-[14px]\" data-kid=\"1-2-1-1-4-2-3-1\" data-name=\"map pin location icon\">\n                            </i>\n                            Zone 1 (Poblacion)\n                        </span>\n                        <span data-kid=\"1-2-1-1-4-2-4\" data-name=\"store manager employment type and commute text\">\n                            Full-time · Walk from Public Market\n                        </span>\n                        <span class=\"justify-self-end text-[12px] text-[#dad2c1]\" data-kid=\"1-2-1-1-4-2-5\" data-name=\"store manager verification status badge\">\n                            Documents reviewed\n                        </span>\n                    </div>\n                    <div class=\"bulletin-row text-[13px] text-[#c9c0ad]\" data-kid=\"1-2-1-1-4-3\" data-name=\"customer service job row\">\n                        <div class=\"bulletin-role py-3\" data-kid=\"1-2-1-1-4-3-1\" data-name=\"customer service role cell\">\n                            <a class=\"block text-[16px] font-medium text-[#f7f5f0] underline decoration-[#6d655d] underline-offset-4\" data-kid=\"1-2-1-1-4-3-1-1\" data-name=\"customer service job title link\" href=\"#customer-service\">\n                                Customer Service\n                            </a>\n                            <span class=\"mt-1 block text-[13px] text-[#aea69c]\" data-kid=\"1-2-1-1-4-3-1-2\" data-name=\"customer service employer name caption\">\n                                Local Telco Branch\n                            </span>\n                        </div>\n                        <span class=\"font-mono text-[14px] text-[#f7f5f0]\" data-kid=\"1-2-1-1-4-3-2\" data-name=\"customer service salary amount\">\n                            ₱14k / mo\n                        </span>\n                        <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-1-1-4-3-3\" data-name=\"customer service location tag\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin text-[14px]\" data-kid=\"1-2-1-1-4-3-3-1\" data-name=\"map pin location icon\">\n                            </i>\n                            Matti Area\n                        </span>\n                        <span data-kid=\"1-2-1-1-4-3-4\" data-name=\"customer service employment type and commute text\">\n                            Full-time · Near Capitol\n                        </span>\n                        <span class=\"justify-self-end text-[12px] text-[#dad2c1]\" data-kid=\"1-2-1-1-4-3-5\" data-name=\"customer service verification status badge\">\n                            Documents reviewed\n                        </span>\n                    </div>\n                </section>\n                <section aria-labelledby=\"daily-heading\" class=\"mb-8\" data-kid=\"1-2-1-1-5\" data-name=\"daily contract jobs group\">\n                    <h2 class=\"mb-2 text-[20px] font-medium tracking-[-0.25px]\" data-kid=\"1-2-1-1-5-1\" data-name=\"daily jobs section heading\" id=\"daily-heading\">\n                        Daily and contract work\n                    </h2>\n                    <div class=\"bulletin-row text-[13px] text-[#c9c0ad]\" data-kid=\"1-2-1-1-5-2\" data-name=\"barista job row\">\n                        <div class=\"bulletin-role py-3\" data-kid=\"1-2-1-1-5-2-1\" data-name=\"barista role cell\">\n                            <a class=\"block text-[16px] font-medium text-[#f7f5f0] underline decoration-[#6d655d] underline-offset-4\" data-kid=\"1-2-1-1-5-2-1-1\" data-name=\"barista job title link\" href=\"#barista\">\n                                Barista\n                            </a>\n                            <span class=\"mt-1 block text-[13px] text-[#aea69c]\" data-kid=\"1-2-1-1-5-2-1-2\" data-name=\"barista employer name caption\">\n                                Kapehan sa Digos\n                            </span>\n                        </div>\n                        <span class=\"font-mono text-[14px] text-[#f7f5f0]\" data-kid=\"1-2-1-1-5-2-2\" data-name=\"barista salary amount\">\n                            ₱400 / day\n                        </span>\n                        <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-1-1-5-2-3\" data-name=\"barista location tag\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin text-[14px]\" data-kid=\"1-2-1-1-5-2-3-1\" data-name=\"map pin location icon\">\n                            </i>\n                            Tres de Mayo\n                        </span>\n                        <span data-kid=\"1-2-1-1-5-2-4\" data-name=\"barista employment type and commute text\">\n                            Daily Gig · 1 trike ride from Gaisano\n                        </span>\n                        <span class=\"justify-self-end text-[12px] text-[#dad2c1]\" data-kid=\"1-2-1-1-5-2-5\" data-name=\"barista verification status badge\">\n                            Documents reviewed\n                        </span>\n                    </div>\n                    <div class=\"bulletin-row text-[13px] text-[#c9c0ad]\" data-kid=\"1-2-1-1-5-3\" data-name=\"delivery rider job row\">\n                        <div class=\"bulletin-role py-3\" data-kid=\"1-2-1-1-5-3-1\" data-name=\"delivery rider role cell\">\n                            <a class=\"block text-[16px] font-medium text-[#f7f5f0] underline decoration-[#6d655d] underline-offset-4\" data-kid=\"1-2-1-1-5-3-1-1\" data-name=\"delivery rider job title link\" href=\"#delivery-rider\">\n                                Delivery Rider\n                            </a>\n                            <span class=\"mt-1 block text-[13px] text-[#aea69c]\" data-kid=\"1-2-1-1-5-3-1-2\" data-name=\"delivery rider employer name caption\">\n                                QuickDeliver\n                            </span>\n                        </div>\n                        <span class=\"font-mono text-[14px] text-[#f7f5f0]\" data-kid=\"1-2-1-1-5-3-2\" data-name=\"delivery rider salary amount\">\n                            ₱12k + tips\n                        </span>\n                        <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-1-1-5-3-3\" data-name=\"delivery rider location tag\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin text-[14px]\" data-kid=\"1-2-1-1-5-3-3-1\" data-name=\"map pin location icon\">\n                            </i>\n                            Cogon\n                        </span>\n                        <span data-kid=\"1-2-1-1-5-3-4\" data-name=\"delivery rider employment type and commute text\">\n                            Contract · Has own motorcycle\n                        </span>\n                        <span class=\"justify-self-end text-[12px] text-[#aea69c]\" data-kid=\"1-2-1-1-5-3-5\" data-name=\"delivery rider verification status badge\">\n                            Not verified\n                        </span>\n                    </div>\n                </section>\n                <p class=\"max-w-[780px] border-t border-[#3f3a36] pt-4 text-[13px] leading-5 text-[#aea69c]\" data-kid=\"1-2-1-1-6\" data-name=\"verification note disclaimer text\">\n                    “Documents reviewed” means the employer’s submitted documents were checked. Jobs without this label remain available to browse.\n                </p>\n                <footer class=\"mt-8 flex flex-wrap gap-x-6 gap-y-3 border-t border-[#3f3a36] pt-5 text-[13px]\" data-kid=\"1-2-1-1-7\" data-name=\"page footer links bar\">\n                    <a class=\"text-[#c9c0ad] underline decoration-[#6d655d] underline-offset-4\" data-kid=\"1-2-1-1-7-1\" data-name=\"application status footer link\" href=\"#applications\" id=\"applications\">\n                        Already applied? Check application status\n                    </a>\n                    <a class=\"text-[#c9c0ad] underline decoration-[#6d655d] underline-offset-4\" data-kid=\"1-2-1-1-7-2\" data-name=\"employer portal footer link\" href=\"#employers\" id=\"employers\">\n                        Posting a job? Employer portal\n                    </a>\n                </footer>\n            </section>\n            <aside class=\"bulletin-aside pt-1\" data-kid=\"1-2-1-2\" data-name=\"aside info panel\">\n                <h2 class=\"mb-3 text-[14px] font-medium text-[#f7f5f0]\" data-kid=\"1-2-1-2-1\" data-name=\"aside heading text\">\n                    Before you apply\n                </h2>\n                <p class=\"mb-4 text-[13px] leading-5 text-[#c9c0ad]\" data-kid=\"1-2-1-2-2\" data-name=\"aside description text\">\n                    Review the pay period, location and employer details on each listing.\n                </p>\n                <div class=\"border-t border-[#3f3a36] pt-4\" data-kid=\"1-2-1-2-3\" data-name=\"resume optional info block\">\n                    <p class=\"mb-2 text-[13px] font-medium text-[#dad2c1]\" data-kid=\"1-2-1-2-3-1\" data-name=\"resume optional heading text\">\n                        No résumé required to start\n                    </p>\n                    <p class=\"text-[13px] leading-5 text-[#aea69c]\" data-kid=\"1-2-1-2-3-2\" data-name=\"resume optional description text\">\n                        The Digos Talent Form lets you share your details. A résumé is optional.\n                    </p>\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n",
