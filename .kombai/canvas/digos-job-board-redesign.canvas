    "var_69bed242bd25": {
      "type": "variant",
      "label": "B · Applicant",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8680,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n.applicant-page { min-height: 100vh; background: #2b2622; color: #f7f5f0; font-family: Inter, system-ui, sans-serif; }\n.applicant-page * { box-sizing: border-box; }\n.applicant-page a { color: inherit; }\n.applicant-header { border-bottom: 1px solid #3f3a36; height: 68px; display: flex; align-items: center; }\n.applicant-nav { width: min(1200px, calc(100% - 64px)); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 32px; }\n.applicant-brand { display: inline-flex; align-items: center; gap: 11px; color: #f7f5f0; text-decoration: none; font-size: 15px; font-weight: 600; letter-spacing: -.25px; }\n.applicant-mark { width: 30px; height: 30px; display: grid; place-items: center; background: #f7f5f0; color: #2b2622; border-radius: 4px; font-size: 12px; font-weight: 600; }\n.applicant-links { display: flex; align-items: center; gap: 30px; margin-left: auto; }\n.applicant-links a { text-decoration: none; color: #c9c0ad; font-size: 13px; line-height: 20px; }\n.applicant-links a.active { color: #f7f5f0; border-bottom: 1px solid #f7f5f0; padding: 24px 0 21px; }\n.applicant-user { display: inline-flex; align-items: center; gap: 9px; color: #dad2c1; font-size: 12px; text-decoration: none; }\n.applicant-avatar { width: 30px; height: 30px; border: 1px solid #5b544d; border-radius: 50%; display: grid; place-items: center; color: #dad2c1; font-size: 10px; }\n.applicant-main { width: min(1120px, calc(100% - 64px)); margin: 0 auto; padding: 54px 0 72px; }\n.applicant-titlebar { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; border-bottom: 1px solid #3f3a36; padding-bottom: 25px; }\n.applicant-title { margin: 0; font-size: 36px; line-height: 1.15; font-weight: 400; letter-spacing: -1.1px; }\n.applicant-intro { margin: 10px 0 0; color: #c9c0ad; font-size: 15px; line-height: 23px; }\n.applicant-count { display: flex; align-items: center; gap: 10px; color: #aea69c; font-size: 13px; white-space: nowrap; padding-bottom: 5px; }\n.applicant-count strong { color: #dad2c1; font-family: 'DM Mono', monospace; font-size: 14px; font-weight: 400; }\n.applicant-content { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 64px; padding-top: 34px; align-items: start; }\n.application-record { border: 1px solid #3f3a36; border-radius: 4px; background: #383330; overflow: hidden; }\n.record-top { padding: 25px 28px 22px; border-bottom: 1px solid #3f3a36; }\n.record-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }\n.record-title { margin: 0; font-size: 21px; line-height: 28px; font-weight: 500; letter-spacing: -.3px; }\n.record-employer { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin-top: 7px; color: #c9c0ad; font-size: 14px; line-height: 20px; }\n.verified-copy { display: inline-flex; align-items: center; gap: 5px; color: #dad2c1; border: 1px solid #5b544d; border-radius: 9999px; padding: 3px 8px; font-size: 11px; line-height: 14px; }\n.record-meta { display: flex; flex-wrap: wrap; column-gap: 22px; row-gap: 9px; margin-top: 19px; color: #aea69c; font-size: 12px; line-height: 18px; }\n.record-meta span { display: inline-flex; align-items: center; gap: 7px; }\n.record-meta i { font-size: 13px; color: #dad2c1; }\n.current-state { display: grid; grid-template-columns: 10px minmax(0,1fr); gap: 11px; padding: 23px 28px 21px; }\n.state-mark { width: 7px; height: 7px; background: #f7f5f0; border-radius: 50%; margin-top: 7px; }\n.current-label { display: flex; align-items: center; gap: 11px; flex-wrap: wrap; margin: 0; font-size: 16px; line-height: 23px; font-weight: 500; }\n.current-label small { color: #aea69c; font-family: 'DM Mono', monospace; font-size: 10px; font-weight: 400; letter-spacing: .3px; }\n.current-description { margin: 6px 0 0; color: #c9c0ad; font-size: 13px; line-height: 20px; }\n.timeline { margin: 0 28px; padding: 17px 0 23px; border-top: 1px solid #4a443f; }\n.timeline-title { margin: 0 0 19px; color: #aea69c; font-size: 11px; font-weight: 500; letter-spacing: .45px; text-transform: uppercase; }\n.timeline-list { position: relative; display: grid; gap: 20px; }\n.timeline-list:before { content: ''; position: absolute; left: 4px; top: 10px; bottom: 11px; border-left: 1px solid #5b544d; }\n.timeline-item { position: relative; display: grid; grid-template-columns: 9px minmax(0,1fr) auto; gap: 12px; align-items: start; }\n.timeline-dot { width: 9px; height: 9px; margin-top: 4px; background: #2b2622; border: 1px solid #c9c0ad; border-radius: 50%; z-index: 1; }\n.timeline-item.current .timeline-dot { background: #f7f5f0; border-color: #f7f5f0; }\n.timeline-label { margin: 0; color: #dad2c1; font-size: 13px; line-height: 18px; font-weight: 500; }\n.timeline-item.current .timeline-label { color: #f7f5f0; }\n.timeline-date { color: #aea69c; font-family: 'DM Mono', monospace; font-size: 10px; line-height: 17px; white-space: nowrap; }\n.record-footer { display: flex; align-items: center; justify-content: flex-start; gap: 20px; padding: 17px 28px; border-top: 1px solid #3f3a36; }\n.text-link { display: inline-flex; align-items: center; gap: 8px; color: #f7f5f0; font-size: 13px; line-height: 20px; text-decoration: none; font-weight: 500; }\n.text-link:hover { text-decoration: underline; text-underline-offset: 4px; }\n.text-link i { font-size: 14px; }\n.side-panel { padding-top: 3px; }\n.side-title { margin: 0; color: #f7f5f0; font-size: 14px; line-height: 20px; font-weight: 500; }\n.side-copy { margin: 9px 0 0; color: #c9c0ad; font-size: 13px; line-height: 20px; }\n.job-facts { margin: 21px 0 0; border-top: 1px solid #3f3a36; }\n.job-fact { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; padding: 12px 0; border-bottom: 1px solid #3f3a36; font-size: 12px; line-height: 18px; }\n.job-fact dt { color: #aea69c; }\n.job-fact dd { margin: 0; color: #dad2c1; text-align: right; }\n.side-actions { display: grid; gap: 11px; margin-top: 22px; }\n.primary-link { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 10px 15px; color: #2b2622 !important; background: #f7f5f0; border: 1px solid #f7f5f0; border-radius: 3px; text-decoration: none; font-size: 13px; font-weight: 500; transition: background .15s ease; }\n.primary-link:hover { background: #dad2c1; border-color: #dad2c1; }\n.secondary-link { min-height: 42px; display: inline-flex; align-items: center; justify-content: center; color: #dad2c1 !important; border: 1px solid #5b544d; border-radius: 3px; text-decoration: none; font-size: 12px; }\n.secondary-link:hover { border-color: #aea69c; }\n.side-divider { margin: 25px 0 19px; border: 0; border-top: 1px solid #3f3a36; }\n.assist-label { display: flex; align-items: center; gap: 8px; color: #aea69c; font-size: 11px; line-height: 17px; }\n.assist-label i { font-size: 13px; }\n.assist-copy { margin: 8px 0 0; color: #c9c0ad; font-size: 12px; line-height: 19px; }\n@media (max-width: 760px) {\n .applicant-header { height: 60px; }\n .applicant-nav { width: calc(100% - 32px); gap: 14px; }\n .applicant-brand { gap: 8px; font-size: 13px; }\n .applicant-mark { width: 27px; height: 27px; }\n .applicant-links { gap: 13px; }\n .applicant-links a { font-size: 11px; }\n .applicant-links a.active { padding: 20px 0 18px; }\n .applicant-user { display: none; }\n .applicant-main { width: calc(100% - 32px); padding: 34px 0 48px; }\n .applicant-titlebar { align-items: flex-start; flex-direction: column; gap: 13px; padding-bottom: 20px; }\n .applicant-title { font-size: 30px; letter-spacing: -.8px; }\n .applicant-intro { max-width: 340px; font-size: 14px; }\n .applicant-content { grid-template-columns: 1fr; gap: 27px; padding-top: 24px; }\n .record-top { padding: 21px 18px 18px; }\n .record-heading { gap: 10px; }\n .record-title { font-size: 19px; }\n .record-meta { column-gap: 13px; font-size: 11px; }\n .current-state { padding: 19px 18px; }\n .timeline { margin: 0 18px; }\n .timeline-item { grid-template-columns: 9px minmax(0,1fr); }\n .timeline-date { grid-column: 2; margin-top: -3px; }\n .record-footer { padding: 15px 18px; }\n .side-panel { padding: 0 2px; }\n .side-actions { grid-template-columns: 1fr 1fr; }\n .primary-link, .secondary-link { padding-left: 10px; padding-right: 10px; font-size: 11px; }\n}\n@media (max-width: 360px) {\n .applicant-links { gap: 9px; }\n .applicant-links a { font-size: 10px; }\n .applicant-brand span:last-child { display: none; }\n}\n</style>\n<div class=\"applicant-page\" data-kid=\"1\" data-name=\"applicant page layout\">\n    <header class=\"applicant-header\" data-kid=\"1-1\" data-name=\"page header bar\">\n        <nav aria-label=\"Main navigation\" class=\"applicant-nav\" data-kid=\"1-1-1\" data-name=\"main navigation bar\">\n            <a aria-label=\"DigosJobs home\" class=\"applicant-brand\" data-kid=\"1-1-1-1\" data-name=\"brand home link\" href=\"#jobs\">\n                <span class=\"applicant-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo mark\">\n                    D\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DigosJobs\n                </span>\n            </a>\n            <div class=\"applicant-links\" data-kid=\"1-1-1-2\" data-name=\"primary nav links container\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"jobs navigation link\" href=\"#jobs\">\n                    Jobs\n                </a>\n                <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-1-2-2\" data-name=\"applications navigation link active\" href=\"#applications\">\n                    Applications\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"employers navigation link\" href=\"#employer\">\n                    Employers\n                </a>\n            </div>\n            <a class=\"applicant-user\" data-kid=\"1-1-1-3\" data-name=\"user account link\" href=\"#profile\">\n                <span class=\"applicant-avatar\" data-kid=\"1-1-1-3-1\" data-name=\"user avatar initials\">\n                    JS\n                </span>\n                <span data-kid=\"1-1-1-3-2\" data-name=\"user account label\">\n                    Applicant\n                </span>\n            </a>\n        </nav>\n    </header>\n    <main class=\"applicant-main\" data-kid=\"1-2\" data-name=\"main applicant content area\" id=\"applications\">\n        <div class=\"applicant-titlebar\" data-kid=\"1-2-1\" data-name=\"page title and count bar\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title block\">\n                <h1 class=\"applicant-title\" data-kid=\"1-2-1-1-1\" data-name=\"page main heading\">\n                    My applications\n                </h1>\n                <p class=\"applicant-intro\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    See the latest status of the jobs you’ve applied for.\n                </p>\n            </div>\n            <div class=\"applicant-count\" data-kid=\"1-2-1-2\" data-name=\"application count indicator\">\n                <strong data-kid=\"1-2-1-2-1\" data-name=\"application count number\">\n                    01\n                </strong>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"application count label\">\n                    application\n                </span>\n            </div>\n        </div>\n        <div class=\"applicant-content\" data-kid=\"1-2-2\" data-name=\"two column content grid\">\n            <section aria-labelledby=\"application-title\" class=\"application-record\" data-kid=\"1-2-2-1\" data-name=\"application record card\">\n                <div class=\"record-top\" data-kid=\"1-2-2-1-1\" data-name=\"record top section\">\n                    <div class=\"record-heading\" data-kid=\"1-2-2-1-1-1\" data-name=\"record heading layout\">\n                        <div data-kid=\"1-2-2-1-1-1-1\" data-name=\"job title group\">\n                            <h2 class=\"record-title\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"applied job title heading\" id=\"application-title\">\n                                Store Manager\n                            </h2>\n                            <div class=\"record-employer\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"employer name row\">\n                                <span data-kid=\"1-2-2-1-1-1-1-2-1\" data-name=\"employer name text\">\n                                    Digos Central Mall\n                                </span>\n                                <span class=\"verified-copy\" data-kid=\"1-2-2-1-1-1-1-2-2\" data-name=\"verified employer badge\">\n                                    <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-2-1-1-1-1-2-2-1\" data-name=\"shield check verification icon\">\n                                    </i>\n                                    Verified employer\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"record-meta\" data-kid=\"1-2-2-1-1-2\" data-name=\"job meta details row\">\n                        <span data-kid=\"1-2-2-1-1-2-1\" data-name=\"location meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"map pin location icon\">\n                            </i>\n                            Zone 1 (Poblacion)\n                        </span>\n                        <span data-kid=\"1-2-2-1-1-2-2\" data-name=\"work type meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-briefcase\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"briefcase work type icon\">\n                            </i>\n                            Full-time\n                        </span>\n                        <span data-kid=\"1-2-2-1-1-2-3\" data-name=\"salary meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-coins\" data-kid=\"1-2-2-1-1-2-3-1\" data-name=\"coins salary icon\">\n                            </i>\n                            ₱15k–₱20k / month\n                        </span>\n                    </div>\n                </div>\n                <div class=\"current-state\" data-kid=\"1-2-2-1-2\" data-name=\"current status section\">\n                    <span aria-hidden=\"true\" class=\"state-mark\" data-kid=\"1-2-2-1-2-1\" data-name=\"current status dot marker\">\n                    </span>\n                    <div data-kid=\"1-2-2-1-2-2\" data-name=\"status text group\">\n                        <p class=\"current-label\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"current status label\">\n                            Under review\n                            <small data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"status category small text\">\n                                CURRENT STATUS\n                            </small>\n                        </p>\n                        <p class=\"current-description\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"current status description\">\n                            The employer is reviewing your profile.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"timeline\" data-kid=\"1-2-2-1-3\" data-name=\"application timeline section\">\n                    <h3 class=\"timeline-title\" data-kid=\"1-2-2-1-3-1\" data-name=\"timeline section title\">\n                        Application updates\n                    </h3>\n                    <div class=\"timeline-list\" data-kid=\"1-2-2-1-3-2\" data-name=\"timeline list container\">\n                        <div class=\"timeline-item\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"submitted timeline item\">\n                            <span aria-hidden=\"true\" class=\"timeline-dot\" data-kid=\"1-2-2-1-3-2-1-1\" data-name=\"timeline dot marker\">\n                            </span>\n                            <p class=\"timeline-label\" data-kid=\"1-2-2-1-3-2-1-2\" data-name=\"submitted timeline label\">\n                                Application submitted\n                            </p>\n                            <time class=\"timeline-date\" data-kid=\"1-2-2-1-3-2-1-3\" data-name=\"submitted timeline date\" datetime=\"2026-10-02T10:00\">\n                                Oct 2, 2026 · 10:00 AM\n                            </time>\n                        </div>\n                        <div class=\"timeline-item current\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"current timeline item\">\n                            <span aria-hidden=\"true\" class=\"timeline-dot\" data-kid=\"1-2-2-1-3-2-2-1\" data-name=\"current timeline dot marker\">\n                            </span>\n                            <p class=\"timeline-label\" data-kid=\"1-2-2-1-3-2-2-2\" data-name=\"current timeline label\">\n                                Under review\n                            </p>\n                            <span class=\"timeline-date\" data-kid=\"1-2-2-1-3-2-2-3\" data-name=\"current timeline status text\">\n                                Current status\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"record-footer\" data-kid=\"1-2-2-1-4\" data-name=\"record footer bar\">\n                    <a class=\"text-link\" data-kid=\"1-2-2-1-4-1\" data-name=\"view job details link\" href=\"#job-details\">\n                        View job details\n                        <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"arrow up right link icon\">\n                        </i>\n                    </a>\n                </div>\n            </section>\n            <aside aria-label=\"Related job information\" class=\"side-panel\" data-kid=\"1-2-2-2\" data-name=\"related job sidebar panel\" id=\"job-details\">\n                <h2 class=\"side-title\" data-kid=\"1-2-2-2-1\" data-name=\"sidebar job title heading\">\n                    Store Manager at Digos Central Mall\n                </h2>\n                <p class=\"side-copy\" data-kid=\"1-2-2-2-2\" data-name=\"sidebar description text\">\n                    Return to this listing or browse other opportunities around Digos City.\n                </p>\n                <dl class=\"job-facts\" data-kid=\"1-2-2-2-3\" data-name=\"job facts definition list\">\n                    <div class=\"job-fact\" data-kid=\"1-2-2-2-3-1\" data-name=\"pay fact row\">\n                        <dt data-kid=\"1-2-2-2-3-1-1\" data-name=\"pay fact label\">\n                            Pay\n                        </dt>\n                        <dd data-kid=\"1-2-2-2-3-1-2\" data-name=\"pay fact value\">\n                            ₱15k–₱20k / month\n                        </dd>\n                    </div>\n                    <div class=\"job-fact\" data-kid=\"1-2-2-2-3-2\" data-name=\"location fact row\">\n                        <dt data-kid=\"1-2-2-2-3-2-1\" data-name=\"location fact label\">\n                            Location\n                        </dt>\n                        <dd data-kid=\"1-2-2-2-3-2-2\" data-name=\"location fact value\">\n                            Zone 1 (Poblacion)\n                        </dd>\n                    </div>\n                    <div class=\"job-fact\" data-kid=\"1-2-2-2-3-3\" data-name=\"work type fact row\">\n                        <dt data-kid=\"1-2-2-2-3-3-1\" data-name=\"work type fact label\">\n                            Work type\n                        </dt>\n                        <dd data-kid=\"1-2-2-2-3-3-2\" data-name=\"work type fact value\">\n                            Full-time\n                        </dd>\n                    </div>\n                </dl>\n                <div class=\"side-actions\" data-kid=\"1-2-2-2-4\" data-name=\"sidebar action buttons container\">\n                    <a class=\"primary-link\" data-kid=\"1-2-2-2-4-1\" data-name=\"open job listing primary button link\" href=\"#job-details\">\n                        Open job listing\n                        <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"arrow up right button icon\">\n                        </i>\n                    </a>\n                    <a class=\"secondary-link\" data-kid=\"1-2-2-2-4-2\" data-name=\"browse other jobs secondary button link\" href=\"#jobs\">\n                        Browse other jobs\n                    </a>\n                </div>\n                <hr class=\"side-divider\" data-kid=\"1-2-2-2-5\" data-name=\"sidebar section divider\"/>\n                <div class=\"assist-label\" data-kid=\"1-2-2-2-6\" data-name=\"about status label\">\n                    <i aria-hidden=\"true\" class=\"icon-info\" data-kid=\"1-2-2-2-6-1\" data-name=\"info circle icon\">\n                    </i>\n                    About this status\n                </div>\n                <p class=\"assist-copy\" data-kid=\"1-2-2-2-7\" data-name=\"about status explanation text\">\n                    “Under review” means the employer is considering your application. No further update is shown yet.\n                </p>\n            </aside>\n        </div>\n    </main>\n</div>\n",
