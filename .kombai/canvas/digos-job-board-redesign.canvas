        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.d-employer{min-height:100vh;background:#2b2622;color:#f7f5f0;font-family:Inter,system-ui,sans-serif;line-height:1.5}\n.d-employer *{box-sizing:border-box}\n.d-employer a{color:inherit;text-decoration:none}\n.d-employer .topbar{border-bottom:1px solid #3f3a36}\n.d-employer .topbar-inner{max-width:1320px;margin:0 auto;min-height:68px;padding:0 34px;display:flex;align-items:center;justify-content:space-between;gap:28px}\n.d-employer .brand{display:flex;align-items:center;gap:10px;white-space:nowrap;font-size:15px;font-weight:500;letter-spacing:-.2px}\n.d-employer .brand-mark{width:30px;height:30px;border:1px solid #aea69c;display:grid;place-items:center;font-size:13px;color:#f7f5f0;border-radius:3px}\n.d-employer .brand-place{padding-left:12px;margin-left:2px;border-left:1px solid #3f3a36;color:#aea69c;font-size:12px;font-weight:400}\n.d-employer .nav{display:flex;align-items:stretch;gap:26px;height:68px}\n.d-employer .nav a{display:flex;align-items:center;padding:0 2px;color:#c9c0ad;font-size:13px;border-bottom:1px solid transparent}\n.d-employer .nav a:hover,.d-employer .nav a[aria-current=\"page\"]{color:#f7f5f0}\n.d-employer .nav a[aria-current=\"page\"]{border-bottom-color:#f7f5f0}\n.d-employer .profile{font-size:12px;color:#aea69c;white-space:nowrap}\n.d-employer main{max-width:1180px;margin:0 auto;padding:46px 34px 42px}\n.d-employer .page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;padding-bottom:30px;border-bottom:1px solid #3f3a36}\n.d-employer h1{margin:0;color:#f7f5f0;font-size:32px;line-height:1.2;font-weight:500;letter-spacing:-1px}\n.d-employer .company-line{margin:9px 0 0;color:#c9c0ad;font-size:15px}\n.d-employer .button-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 17px;background:#f7f5f0;color:#2b2622;border:1px solid #f7f5f0;border-radius:3px;font-size:13px;font-weight:500;white-space:nowrap;transition:background .15s ease,color .15s ease}\n.d-employer .button-primary:hover{background:#dad2c1;border-color:#dad2c1}\n.d-employer .button-primary:focus-visible,.d-employer a:focus-visible{outline:2px solid #f7f5f0;outline-offset:3px}\n.d-employer .section{padding:29px 0 31px;border-bottom:1px solid #3f3a36}\n.d-employer .section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:16px}\n.d-employer h2{margin:0;color:#f7f5f0;font-size:18px;font-weight:500;letter-spacing:-.3px}\n.d-employer .subtle{color:#aea69c;font-size:13px}\n.d-employer .tasks{display:grid;grid-template-columns:1fr 1fr;gap:0}\n.d-employer .task{min-height:102px;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:15px 23px 15px 0}\n.d-employer .task+.task{border-left:1px solid #3f3a36;padding-left:24px}\n.d-employer .task-copy{min-width:0}\n.d-employer .task-title{display:block;color:#f7f5f0;font-size:16px;font-weight:500;letter-spacing:-.2px}\n.d-employer .task-meta{margin-top:5px;color:#c9c0ad;font-size:13px}\n.d-employer .task-action{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 14px;border:1px solid #3f3a36;border-radius:3px;color:#f7f5f0;font-size:13px;font-weight:500;white-space:nowrap;transition:border-color .15s ease,background .15s ease}\n.d-employer .task-action:hover{background:#383330;border-color:#aea69c}\n.d-employer .task-action.primary{background:#f7f5f0;color:#2b2622;border-color:#f7f5f0}\n.d-employer .task-action.primary:hover{background:#dad2c1;border-color:#dad2c1}\n.d-employer .listings{padding-top:30px}\n.d-employer .listings-title{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:19px}\n.d-employer .listing-group+.listing-group{margin-top:25px}\n.d-employer .group-heading{display:flex;align-items:center;justify-content:space-between;padding:0 0 10px;border-bottom:1px solid #3f3a36;color:#dad2c1;font-size:13px;font-weight:500}\n.d-employer .group-count{color:#aea69c;font:12px 'DM Mono',monospace}\n.d-employer .listing-row{display:grid;grid-template-columns:minmax(240px,1.5fr) minmax(180px,1.2fr) minmax(130px,.8fr) auto;align-items:center;gap:20px;min-height:92px;padding:15px 0;border-bottom:1px solid #3f3a36}\n.d-employer .listing-name{display:flex;align-items:center;gap:10px;flex-wrap:wrap;color:#f7f5f0;font-size:16px;font-weight:500}\n.d-employer .state{display:inline-flex;align-items:center;gap:7px;color:#dad2c1;font-size:12px;font-weight:400}\n.d-employer .state-dot{width:6px;height:6px;border:1px solid #dad2c1;border-radius:50%;display:inline-block}\n.d-employer .listing-meta{color:#c9c0ad;font-size:13px;line-height:1.65}\n.d-employer .listing-meta span+span:before{content:'·';padding:0 7px;color:#aea69c}\n.d-employer .listing-action{display:inline-flex;align-items:center;justify-content:flex-end;gap:9px;min-height:44px;padding:8px 2px 8px 12px;color:#f7f5f0;font-size:13px;font-weight:500;white-space:nowrap;text-decoration:underline!important;text-decoration-color:#6d655d!important;text-underline-offset:4px}\n.d-employer .listing-action:hover{text-decoration-color:#f7f5f0!important}\n.d-employer .listing-action .icon{font-size:14px}\n.d-employer .guidance{margin-top:27px;padding-top:18px;border-top:1px solid #3f3a36;color:#aea69c;font-size:13px;max-width:720px}\n.d-employer .footer{max-width:1180px;margin:0 auto;padding:22px 34px 30px;border-top:1px solid #3f3a36;display:flex;justify-content:space-between;gap:20px;color:#aea69c;font-size:12px}\n@media(max-width:760px){\n .d-employer .topbar-inner{min-height:70px;padding:8px 17px;gap:8px;flex-wrap:wrap}\n .d-employer .brand{gap:7px;font-size:13px}\n .d-employer .brand-mark{width:27px;height:27px;font-size:12px}\n .d-employer .brand-place,.d-employer .profile{display:none}\n .d-employer .nav{height:46px;gap:clamp(7px,3vw,14px)}\n .d-employer .nav a{font-size:11px;white-space:nowrap}\n .d-employer main{padding:28px 18px 30px}\n .d-employer .page-heading{align-items:flex-start;gap:15px;padding-bottom:23px}\n .d-employer h1{font-size:25px;letter-spacing:-.7px}\n .d-employer .company-line{font-size:14px;max-width:220px}\n .d-employer .button-primary{font-size:12px;padding:9px 10px;min-height:44px}\n .d-employer .button-primary .icon{display:none}\n .d-employer .section{padding:23px 0 24px}\n .d-employer .section-heading{margin-bottom:9px}\n .d-employer h2{font-size:17px}\n .d-employer .tasks{grid-template-columns:1fr}\n .d-employer .task{min-height:0;padding:13px 0;gap:12px}\n .d-employer .task+.task{border-left:0;border-top:1px solid #3f3a36;padding:13px 0}\n .d-employer .task-title{font-size:15px}\n .d-employer .task-meta{font-size:13px;line-height:1.5}\n .d-employer .task-action{font-size:12px;white-space:normal;text-align:center;line-height:1.3;padding:8px 10px;min-height:44px;max-width:142px}\n .d-employer .listings{padding-top:23px}\n .d-employer .listings-title{align-items:flex-start;flex-direction:column;gap:4px;margin-bottom:18px}\n .d-employer .listing-group+.listing-group{margin-top:21px}\n .d-employer .listing-row{grid-template-columns:minmax(0,1fr) auto;gap:5px 12px;min-height:0;padding:14px 0 12px}\n .d-employer .listing-name{grid-column:1/-1;font-size:15px}\n .d-employer .listing-meta{font-size:13px;line-height:1.55}\n .d-employer .listing-meta span+span:before{padding:0 4px}\n .d-employer .listing-action{grid-column:1/-1;justify-content:flex-start;padding:7px 0 2px;min-height:44px}\n .d-employer .guidance{margin-top:23px;font-size:13px;line-height:1.6}\n .d-employer .footer{padding:17px 18px 24px;flex-direction:column;gap:5px}\n}\n@media(max-width:390px){\n .d-employer .topbar-inner{padding-left:14px;padding-right:14px}\n .d-employer .nav{gap:7px}\n .d-employer .nav a{font-size:10px}\n .d-employer main{padding-left:15px;padding-right:15px}\n .d-employer .page-heading{gap:8px}\n .d-employer .page-heading .button-primary{max-width:122px;white-space:normal;line-height:1.25;text-align:center}\n .d-employer .task{align-items:flex-start;flex-direction:column;gap:7px}\n .d-employer .task-action{max-width:none;width:auto}\n}\n</style>\n<div class=\"d-employer\" data-kid=\"1\" data-name=\"employer portal page container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"site top bar\">\n        <div class=\"topbar-inner\" data-kid=\"1-1-1\" data-name=\"top bar inner layout\">\n            <a aria-label=\"DigosJobs home\" class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand home link\" href=\"#home\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand mark letter D\">\n                    D\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DigosJobs\n                </span>\n                <span class=\"brand-place\" data-kid=\"1-1-1-1-3\" data-name=\"brand location tag\">\n                    Digos City\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"find jobs navigation link\" href=\"#jobs\">\n                    Find jobs\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"applications navigation link\" href=\"#applications\">\n                    Applications\n                </a>\n                <a aria-current=\"page\" data-kid=\"1-1-1-2-3\" data-name=\"employer portal navigation link (current page)\" href=\"#employer\">\n                    Employer portal\n                </a>\n            </nav>\n            <span class=\"profile\" data-kid=\"1-1-1-3\" data-name=\"profile company name label\">\n                Digos Central Mall\n            </span>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main employer workspace content\">\n        <section aria-labelledby=\"page-title\" class=\"page-heading\" data-kid=\"1-2-1\" data-name=\"page heading section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title container\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"employer workspace headline\" id=\"page-title\">\n                    Employer workspace\n                </h1>\n                <p class=\"company-line\" data-kid=\"1-2-1-1-2\" data-name=\"company identification line\">\n                    Digos Central Mall\n                    <span aria-hidden=\"true\" data-kid=\"1-2-1-1-2-1\" data-name=\"company and location separator dot\">\n                        ·\n                    </span>\n                    Digos City\n                </p>\n            </div>\n            <a class=\"button-primary\" data-kid=\"1-2-1-2\" data-name=\"primary start job draft button\" href=\"#create-draft\">\n                <i aria-hidden=\"true\" class=\"icon icon-plus\" data-kid=\"1-2-1-2-1\" data-name=\"plus icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"button label text\">\n                    Start a job draft\n                </span>\n            </a>\n        </section>\n        <section aria-labelledby=\"next-steps-title\" class=\"section\" data-kid=\"1-2-2\" data-name=\"needs your attention section\">\n            <div class=\"section-heading\" data-kid=\"1-2-2-1\" data-name=\"section heading bar\">\n                <h2 data-kid=\"1-2-2-1-1\" data-name=\"section heading title\" id=\"next-steps-title\">\n                    Needs your attention\n                </h2>\n                <span class=\"subtle\" data-kid=\"1-2-2-1-2\" data-name=\"next steps count label\">\n                    2 next steps\n                </span>\n            </div>\n            <div class=\"tasks\" data-kid=\"1-2-2-2\" data-name=\"tasks grid container\">\n                <div class=\"task\" data-kid=\"1-2-2-2-1\" data-name=\"task card for reviewing applicants\">\n                    <div class=\"task-copy\" data-kid=\"1-2-2-2-1-1\" data-name=\"task copy container\">\n                        <span class=\"task-title\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"task title text\">\n                            Review Store Manager applicants\n                        </span>\n                        <div class=\"task-meta\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"task meta info line\">\n                            12 applicants · Digos Central Mall\n                        </div>\n                    </div>\n                    <a class=\"task-action primary\" data-kid=\"1-2-2-2-1-2\" data-name=\"task primary action button\" href=\"#applicants\">\n                        Review 12 applicants\n                        <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"arrow up-right icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"task\" data-kid=\"1-2-2-2-2\" data-name=\"task card for finishing cashier listing\">\n                    <div class=\"task-copy\" data-kid=\"1-2-2-2-2-1\" data-name=\"task copy container\">\n                        <span class=\"task-title\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"task title text\">\n                            Finish the Cashier listing\n                        </span>\n                        <div class=\"task-meta\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"task meta info line\">\n                            Draft · Part-time · 0 applicants\n                        </div>\n                    </div>\n                    <a class=\"task-action\" data-kid=\"1-2-2-2-2-2\" data-name=\"task secondary action button\" href=\"#cashier-draft\">\n                        Continue Cashier draft\n                        <i aria-hidden=\"true\" class=\"icon icon-arrow-right\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"listings-title\" class=\"listings\" data-kid=\"1-2-3\" data-name=\"job listings section\">\n            <div class=\"listings-title\" data-kid=\"1-2-3-1\" data-name=\"listings title bar\">\n                <h2 data-kid=\"1-2-3-1-1\" data-name=\"listings section title\" id=\"listings-title\">\n                    Job listings\n                </h2>\n                <span class=\"subtle\" data-kid=\"1-2-3-1-2\" data-name=\"listings summary count label\">\n                    2 total · 1 published · 1 draft\n                </span>\n            </div>\n            <div class=\"listing-group\" data-kid=\"1-2-3-2\" data-name=\"published listings group\">\n                <div class=\"group-heading\" data-kid=\"1-2-3-2-1\" data-name=\"published group heading\">\n                    <span data-kid=\"1-2-3-2-1-1\" data-name=\"published group label\">\n                        Published\n                    </span>\n                    <span class=\"group-count\" data-kid=\"1-2-3-2-1-2\" data-name=\"published group count\">\n                        01 listing\n                    </span>\n                </div>\n                <article class=\"listing-row\" data-kid=\"1-2-3-2-2\" data-name=\"published listing row for store manager\">\n                    <div class=\"listing-name\" data-kid=\"1-2-3-2-2-1\" data-name=\"listing name with state container\">\n                        Store Manager\n                        <span class=\"state\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"listing state badge (active)\">\n                            <span aria-hidden=\"true\" class=\"state-dot\" data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"state dot indicator\">\n                            </span>\n                            Active\n                        </span>\n                    </div>\n                    <div class=\"listing-meta\" data-kid=\"1-2-3-2-2-2\" data-name=\"job type and salary meta\">\n                        <span data-kid=\"1-2-3-2-2-2-1\" data-name=\"work arrangement span\">\n                            Full-time\n                        </span>\n                        <span data-kid=\"1-2-3-2-2-2-2\" data-name=\"salary range span\">\n                            ₱15k–₱20k / month\n                        </span>\n                    </div>\n                    <div class=\"listing-meta\" data-kid=\"1-2-3-2-2-3\" data-name=\"applicant count and posted date meta\">\n                        <span data-kid=\"1-2-3-2-2-3-1\" data-name=\"applicant count span\">\n                            12 applicants\n                        </span>\n                        <span data-kid=\"1-2-3-2-2-3-2\" data-name=\"posted date span\">\n                            Posted Oct 1\n                        </span>\n                    </div>\n                    <a class=\"listing-action\" data-kid=\"1-2-3-2-2-4\" data-name=\"list applicants action link\" href=\"#applicants\">\n                        View applicants\n                        <i aria-hidden=\"true\" class=\"icon icon-arrow-right\" data-kid=\"1-2-3-2-2-4-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </article>\n            </div>\n            <div class=\"listing-group\" data-kid=\"1-2-3-3\" data-name=\"drafts listings group\">\n                <div class=\"group-heading\" data-kid=\"1-2-3-3-1\" data-name=\"drafts group heading\">\n                    <span data-kid=\"1-2-3-3-1-1\" data-name=\"drafts group label\">\n                        Drafts\n                    </span>\n                    <span class=\"group-count\" data-kid=\"1-2-3-3-1-2\" data-name=\"drafts group count\">\n                        01 listing\n                    </span>\n                </div>\n                <article class=\"listing-row\" data-kid=\"1-2-3-3-2\" data-name=\"draft listing row for cashier\" id=\"cashier-draft\">\n                    <div class=\"listing-name\" data-kid=\"1-2-3-3-2-1\" data-name=\"listing name with state container\">\n                        Cashier\n                        <span class=\"state\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"listing state badge (draft)\">\n                            <span aria-hidden=\"true\" class=\"state-dot\" data-kid=\"1-2-3-3-2-1-1-1\" data-name=\"state dot indicator\">\n                            </span>\n                            Draft\n                        </span>\n                    </div>\n                    <div class=\"listing-meta\" data-kid=\"1-2-3-3-2-2\" data-name=\"work arrangement and applicant meta\">\n                        <span data-kid=\"1-2-3-3-2-2-1\" data-name=\"work arrangement span\">\n                            Part-time\n                        </span>\n                        <span data-kid=\"1-2-3-3-2-2-2\" data-name=\"applicant count span\">\n                            0 applicants\n                        </span>\n                    </div>\n                    <div class=\"listing-meta\" data-kid=\"1-2-3-3-2-3\" data-name=\"last edited date meta\">\n                        <span data-kid=\"1-2-3-3-2-3-1\" data-name=\"last edited span\">\n                            Last edited 2h ago\n                        </span>\n                    </div>\n                    <a class=\"listing-action\" data-kid=\"1-2-3-3-2-4\" data-name=\"continue editing action link\" href=\"#cashier-draft\">\n                        Continue editing\n                        <i aria-hidden=\"true\" class=\"icon icon-arrow-right\" data-kid=\"1-2-3-3-2-4-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </article>\n            </div>\n            <p class=\"guidance\" data-kid=\"1-2-3-4\" data-name=\"job listing guidance note\">\n                Job details shown to applicants come from the information provided when each listing is created. Add salary, job address, and work setup to help local job seekers decide whether a role fits.\n            </p>\n        </section>\n    </main>\n    <footer class=\"footer\" data-kid=\"1-3\" data-name=\"site footer\">\n        <span data-kid=\"1-3-1\" data-name=\"footer brand and location text\">\n            DigosJobs · Digos City\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"footer tagline text\">\n            For local applicants and employers\n        </span>\n    </footer>\n</div>\n",
