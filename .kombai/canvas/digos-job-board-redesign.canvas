      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#2b2622] text-[#f7f5f0] font-[Inter,sans-serif] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#3f3a36] bg-[#2b2622]\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"mx-auto flex h-[68px] max-w-[1440px] items-center justify-between px-7 lg:px-10\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <a class=\"flex items-center gap-3 text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"#\">\n                <div class=\"flex h-9 w-9 items-center justify-center border border-[#aea69c]/35 text-[14px] font-medium tracking-[-0.04em]\" data-kid=\"1-1-1-1-1\" data-name=\"logo letter mark box\">\n                    D\n                </div>\n                <span class=\"text-[17px] font-medium tracking-[-0.04em]\" data-kid=\"1-1-1-1-2\" data-name=\"site name label\">\n                    Digos\n                    <span class=\"text-[#c9c0ad]\" data-kid=\"1-1-1-1-2-1\" data-name=\"site name secondary word\">\n                        Jobs\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"hidden items-center gap-8 text-[14px] font-medium text-[#c9c0ad] md:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a aria-current=\"page\" class=\"border-b border-[#f7f5f0] py-[25px] text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"current page navigation link\" href=\"#\">\n                    Find jobs\n                </a>\n                <a class=\"py-3 text-[#c9c0ad] no-underline hover:text-[#f7f5f0]\" data-kid=\"1-1-1-2-2\" data-name=\"my applications navigation link\" href=\"#\">\n                    My applications\n                </a>\n                <a class=\"py-3 text-[#c9c0ad] no-underline hover:text-[#f7f5f0]\" data-kid=\"1-1-1-2-3\" data-name=\"for employers navigation link\" href=\"#\">\n                    For employers\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header actions container\">\n                <button aria-label=\"Open menu\" class=\"flex h-10 w-10 items-center justify-center border border-[#3f3a36] text-[18px] text-[#dad2c1] md:hidden\" data-kid=\"1-1-1-3-1\" data-name=\"mobile menu hamburger button\">\n                    <i class=\"icon-menu\" data-kid=\"1-1-1-3-1-1\" data-name=\"menu hamburger icon\">\n                    </i>\n                </button>\n                <button class=\"hidden h-10 items-center gap-2 border border-[#3f3a36] px-3 text-[13px] font-medium text-[#dad2c1] sm:flex\" data-kid=\"1-1-1-3-2\" data-name=\"user role identity button\">\n                    <span class=\"flex h-6 w-6 items-center justify-center border border-[#aea69c]/35 font-mono text-[11px]\" data-kid=\"1-1-1-3-2-1\" data-name=\"user initials avatar badge\">\n                        JS\n                    </span>\n                    Job seeker\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px] px-6 pb-12 pt-8 lg:px-10 lg:pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-7 flex flex-col justify-between gap-5 xl:flex-row xl:items-end\" data-kid=\"1-2-1\" data-name=\"page title and badges header row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page introduction text container\">\n                <h1 class=\"m-0 text-[32px] font-normal leading-[1.2] tracking-[-0.055em] text-[#f7f5f0] sm:text-[38px]\" data-kid=\"1-2-1-1-1\" data-name=\"page hero headline\">\n                    Work near where you live.\n                </h1>\n                <p class=\"mb-0 mt-2 text-[15px] leading-6 text-[#c9c0ad]\" data-kid=\"1-2-1-1-2\" data-name=\"page hero subheading\">\n                    Browse current opportunities in Digos City. Check pay, barangay and commute before you apply.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap gap-2 text-[12px] text-[#aea69c]\" data-kid=\"1-2-1-2\" data-name=\"feature badge list\">\n                <span class=\"border border-[#3f3a36] px-3 py-2\" data-kid=\"1-2-1-2-1\" data-name=\"local listings badge\">\n                    Local listings\n                </span>\n                <span class=\"border border-[#3f3a36] px-3 py-2\" data-kid=\"1-2-1-2-2\" data-name=\"no account needed badge\">\n                    No account needed to browse\n                </span>\n            </div>\n        </div>\n        <section aria-label=\"Search and filter jobs\" class=\"border-y border-[#3f3a36] bg-[#383330] px-4 py-4 md:px-5\" data-kid=\"1-2-2\" data-name=\"search and filter section\">\n            <div class=\"grid grid-cols-1 gap-3 md:grid-cols-[minmax(0,1fr)_220px_auto] md:items-end\" data-kid=\"1-2-2-1\" data-name=\"search form grid\">\n                <label class=\"block\" data-kid=\"1-2-2-1-1\" data-name=\"role keyword search field group\">\n                    <span class=\"mb-1.5 block text-[12px] font-medium text-[#dad2c1]\" data-kid=\"1-2-2-1-1-1\" data-name=\"role keyword field label\">\n                        Role or keyword\n                    </span>\n                    <span class=\"flex h-11 items-center gap-3 border border-[#3f3a36] bg-[#2b2622] px-3.5 text-[#aea69c]\" data-kid=\"1-2-2-1-1-2\" data-name=\"search keyword input box\">\n                        <i class=\"icon-search text-[17px]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"search magnifying glass icon\">\n                        </i>\n                        <span class=\"text-[14px]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"search placeholder hint text\">\n                            Try “cashier” or “rider”\n                        </span>\n                    </span>\n                </label>\n                <label class=\"block\" data-kid=\"1-2-2-1-2\" data-name=\"barangay select field group\">\n                    <span class=\"mb-1.5 block text-[12px] font-medium text-[#dad2c1]\" data-kid=\"1-2-2-1-2-1\" data-name=\"barangay field label\">\n                        Barangay\n                    </span>\n                    <span class=\"flex h-11 items-center justify-between border border-[#3f3a36] bg-[#2b2622] px-3.5 text-[14px] text-[#f7f5f0]\" data-kid=\"1-2-2-1-2-2\" data-name=\"barangay dropdown box\">\n                        All Digos City\n                        <i class=\"icon-chevron-down text-[15px] text-[#aea69c]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"chevron down dropdown icon\">\n                        </i>\n                    </span>\n                </label>\n                <button class=\"h-11 border border-[#f7f5f0] bg-[#f7f5f0] px-5 text-[14px] font-medium text-[#2b2622] hover:bg-[#dad2c1]\" data-kid=\"1-2-2-1-3\" data-name=\"search jobs submit button\">\n                    Search jobs\n                </button>\n            </div>\n            <div class=\"mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-[#3f3a36] pt-3 text-[13px] text-[#c9c0ad]\" data-kid=\"1-2-2-2\" data-name=\"filter controls row\">\n                <span class=\"text-[#aea69c]\" data-kid=\"1-2-2-2-1\" data-name=\"filter label text\">\n                    Filter by\n                </span>\n                <button class=\"border border-[#aea69c]/70 px-3 py-1.5 text-[#f7f5f0]\" data-kid=\"1-2-2-2-2\" data-name=\"all jobs filter chip\">\n                    All jobs\n                    <span class=\"ml-1 font-mono text-[11px] text-[#c9c0ad]\" data-kid=\"1-2-2-2-2-1\" data-name=\"all jobs filter count badge\">\n                        4\n                    </span>\n                </button>\n                <button class=\"px-2 py-1.5 text-[#c9c0ad] hover:text-[#f7f5f0]\" data-kid=\"1-2-2-2-3\" data-name=\"verified employers filter toggle\">\n                    Verified employers\n                </button>\n                <button class=\"px-2 py-1.5 text-[#c9c0ad] hover:text-[#f7f5f0]\" data-kid=\"1-2-2-2-4\" data-name=\"daily gigs filter toggle\">\n                    Daily gigs\n                </button>\n                <span class=\"ml-auto font-mono text-[12px] text-[#aea69c]\" data-kid=\"1-2-2-2-5\" data-name=\"result count summary text\">\n                    4 opportunities\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Job results and selected job\" class=\"mt-6 overflow-hidden border border-[#3f3a36]\" data-kid=\"1-2-3\" data-name=\"job results and detail section\">\n            <div class=\"grid min-h-[680px] grid-cols-1 md:grid-cols-[minmax(310px,39%)_minmax(0,1fr)]\" data-kid=\"1-2-3-1\" data-name=\"job list and detail grid\">\n                <div class=\"border-b border-[#3f3a36] md:border-b-0 md:border-r\" data-kid=\"1-2-3-1-1\" data-name=\"job list panel\">\n                    <div class=\"flex items-center justify-between border-b border-[#3f3a36] px-5 py-3.5\" data-kid=\"1-2-3-1-1-1\" data-name=\"job list header bar\">\n                        <h2 class=\"m-0 text-[13px] font-medium text-[#dad2c1]\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"job list heading text\">\n                            Jobs in Digos City\n                        </h2>\n                        <button aria-label=\"Sort jobs\" class=\"flex items-center gap-2 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"sort jobs button\">\n                            Most relevant\n                            <i class=\"icon-chevrons-up-down text-[14px]\" data-kid=\"1-2-3-1-1-1-2-1\" data-name=\"sort chevrons icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"divide-y divide-[#3f3a36]\" data-kid=\"1-2-3-1-1-2\" data-name=\"job listing items container\">\n                        <article aria-current=\"true\" class=\"bg-[#383330] px-5 py-5\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"selected job card - store manager\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-1-1-2-1-1\" data-name=\"store manager card top row\">\n                                <h3 class=\"m-0 text-[17px] font-medium tracking-[-0.03em] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1-2-1-1-1\" data-name=\"store manager job title\">\n                                    Store Manager\n                                </h3>\n                                <span class=\"shrink-0 pt-1 font-mono text-[11px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-2-1-1-2\" data-name=\"store manager posted time\">\n                                    2h ago\n                                </span>\n                            </div>\n                            <p class=\"mb-0 mt-1 text-[13px] text-[#dad2c1]\" data-kid=\"1-2-3-1-1-2-1-2\" data-name=\"store manager employer name line\">\n                                Digos Central Mall\n                                <span class=\"ml-1 inline-flex items-center gap-1 text-[11px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-1-2-1-2-1\" data-name=\"store manager verified badge\">\n                                    <i class=\"icon-badge-check text-[13px]\" data-kid=\"1-2-3-1-1-2-1-2-1-1\" data-name=\"verified badge check icon\">\n                                    </i>\n                                    Documents reviewed\n                                </span>\n                            </p>\n                            <p class=\"mb-0 mt-4 font-mono text-[13px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1-2-1-3\" data-name=\"store manager salary line\">\n                                ₱15k–₱20k\n                                <span class=\"font-[Inter,sans-serif] text-[12px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-1-2-1-3-1\" data-name=\"store manager salary period\">\n                                    / month\n                                </span>\n                            </p>\n                            <div class=\"mt-2 flex flex-wrap gap-x-4 gap-y-1.5 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-2-1-4\" data-name=\"store manager meta info row\">\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-2-1-4-1\" data-name=\"store manager location meta\">\n                                    <i class=\"icon-map-pin text-[13px]\" data-kid=\"1-2-3-1-1-2-1-4-1-1\" data-name=\"location map pin icon\">\n                                    </i>\n                                    Zone 1, Poblacion\n                                </span>\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-2-1-4-2\" data-name=\"store manager commute meta\">\n                                    <i class=\"icon-footprints text-[13px]\" data-kid=\"1-2-3-1-1-2-1-4-2-1\" data-name=\"commute footprints icon\">\n                                    </i>\n                                    Walk from Public Market\n                                </span>\n                            </div>\n                        </article>\n                        <article class=\"px-5 py-5 hover:bg-[#383330]/50\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"job card - barista\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-1-1-2-2-1\" data-name=\"barista card top row\">\n                                <h3 class=\"m-0 text-[17px] font-medium tracking-[-0.03em] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1-2-2-1-1\" data-name=\"barista job title\">\n                                    Barista\n                                </h3>\n                                <span class=\"shrink-0 pt-1 font-mono text-[11px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-2-2-1-2\" data-name=\"barista posted time\">\n                                    5h ago\n                                </span>\n                            </div>\n                            <p class=\"mb-0 mt-1 text-[13px] text-[#dad2c1]\" data-kid=\"1-2-3-1-1-2-2-2\" data-name=\"barista employer name line\">\n                                Kapehan sa Digos\n                                <span class=\"ml-1 inline-flex items-center gap-1 text-[11px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-1-2-2-2-1\" data-name=\"barista verified badge\">\n                                    <i class=\"icon-badge-check text-[13px]\" data-kid=\"1-2-3-1-1-2-2-2-1-1\" data-name=\"verified badge check icon\">\n                                    </i>\n                                    Documents reviewed\n                                </span>\n                            </p>\n                            <p class=\"mb-0 mt-4 font-mono text-[13px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1-2-2-3\" data-name=\"barista salary line\">\n                                ₱400\n                                <span class=\"font-[Inter,sans-serif] text-[12px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-1-2-2-3-1\" data-name=\"barista salary period\">\n                                    / day\n                                </span>\n                            </p>\n                            <div class=\"mt-2 flex flex-wrap gap-x-4 gap-y-1.5 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-2-2-4\" data-name=\"barista meta info row\">\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-2-2-4-1\" data-name=\"barista location meta\">\n                                    <i class=\"icon-map-pin text-[13px]\" data-kid=\"1-2-3-1-1-2-2-4-1-1\" data-name=\"location map pin icon\">\n                                    </i>\n                                    Tres de Mayo\n                                </span>\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-2-2-4-2\" data-name=\"barista commute meta\">\n                                    <i class=\"icon-bus-front text-[13px]\" data-kid=\"1-2-3-1-1-2-2-4-2-1\" data-name=\"commute bus icon\">\n                                    </i>\n                                    1 trike ride from Gaisano\n                                </span>\n                            </div>\n                        </article>\n                        <article class=\"px-5 py-5 hover:bg-[#383330]/50\" data-kid=\"1-2-3-1-1-2-3\" data-name=\"job card - customer service\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-1-1-2-3-1\" data-name=\"customer service card top row\">\n                                <h3 class=\"m-0 text-[17px] font-medium tracking-[-0.03em] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1-2-3-1-1\" data-name=\"customer service job title\">\n                                    Customer Service\n                                </h3>\n                                <span class=\"shrink-0 pt-1 font-mono text-[11px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-2-3-1-2\" data-name=\"customer service posted time\">\n                                    1d ago\n                                </span>\n                            </div>\n                            <p class=\"mb-0 mt-1 text-[13px] text-[#dad2c1]\" data-kid=\"1-2-3-1-1-2-3-2\" data-name=\"customer service employer name line\">\n                                Local Telco Branch\n                                <span class=\"ml-1 inline-flex items-center gap-1 text-[11px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-1-2-3-2-1\" data-name=\"customer service verified badge\">\n                                    <i class=\"icon-badge-check text-[13px]\" data-kid=\"1-2-3-1-1-2-3-2-1-1\" data-name=\"verified badge check icon\">\n                                    </i>\n                                    Documents reviewed\n                                </span>\n                            </p>\n                            <p class=\"mb-0 mt-4 font-mono text-[13px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1-2-3-3\" data-name=\"customer service salary line\">\n                                ₱14k\n                                <span class=\"font-[Inter,sans-serif] text-[12px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-1-2-3-3-1\" data-name=\"customer service salary period\">\n                                    / month\n                                </span>\n                            </p>\n                            <div class=\"mt-2 flex flex-wrap gap-x-4 gap-y-1.5 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-2-3-4\" data-name=\"customer service meta info row\">\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-2-3-4-1\" data-name=\"customer service location meta\">\n                                    <i class=\"icon-map-pin text-[13px]\" data-kid=\"1-2-3-1-1-2-3-4-1-1\" data-name=\"location map pin icon\">\n                                    </i>\n                                    Matti Area\n                                </span>\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-2-3-4-2\" data-name=\"customer service area meta\">\n                                    <i class=\"icon-map-pin text-[13px]\" data-kid=\"1-2-3-1-1-2-3-4-2-1\" data-name=\"area map pin icon\">\n                                    </i>\n                                    Near Capitol\n                                </span>\n                            </div>\n                        </article>\n                        <article class=\"px-5 py-5 hover:bg-[#383330]/50\" data-kid=\"1-2-3-1-1-2-4\" data-name=\"job card - delivery rider\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-1-1-2-4-1\" data-name=\"delivery rider card top row\">\n                                <h3 class=\"m-0 text-[17px] font-medium tracking-[-0.03em] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1-2-4-1-1\" data-name=\"delivery rider job title\">\n                                    Delivery Rider\n                                </h3>\n                                <span class=\"shrink-0 pt-1 font-mono text-[11px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-2-4-1-2\" data-name=\"delivery rider posted time\">\n                                    2d ago\n                                </span>\n                            </div>\n                            <p class=\"mb-0 mt-1 text-[13px] text-[#dad2c1]\" data-kid=\"1-2-3-1-1-2-4-2\" data-name=\"delivery rider employer name line\">\n                                QuickDeliver\n                                <span class=\"ml-1 text-[11px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-2-4-2-1\" data-name=\"delivery rider unverified label\">\n                                    Not verified\n                                </span>\n                            </p>\n                            <p class=\"mb-0 mt-4 font-mono text-[13px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1-2-4-3\" data-name=\"delivery rider salary line\">\n                                ₱12k + tips\n                                <span class=\"font-[Inter,sans-serif] text-[12px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-1-2-4-3-1\" data-name=\"delivery rider pay period note\">\n                                    / pay period not specified\n                                </span>\n                            </p>\n                            <div class=\"mt-2 flex flex-wrap gap-x-4 gap-y-1.5 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-1-2-4-4\" data-name=\"delivery rider meta info row\">\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-2-4-4-1\" data-name=\"delivery rider location meta\">\n                                    <i class=\"icon-map-pin text-[13px]\" data-kid=\"1-2-3-1-1-2-4-4-1-1\" data-name=\"location map pin icon\">\n                                    </i>\n                                    Cogon\n                                </span>\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-2-4-4-2\" data-name=\"delivery rider vehicle requirement meta\">\n                                    <i class=\"icon-bike text-[13px]\" data-kid=\"1-2-3-1-1-2-4-4-2-1\" data-name=\"vehicle bike icon\">\n                                    </i>\n                                    Own motorcycle required\n                                </span>\n                            </div>\n                        </article>\n                    </div>\n                </div>\n                <div class=\"relative flex min-h-[600px] flex-col bg-[#2b2622]\" data-kid=\"1-2-3-1-2\" data-name=\"job detail panel\">\n                    <div class=\"border-b border-[#3f3a36] px-7 py-7 lg:px-9\" data-kid=\"1-2-3-1-2-1\" data-name=\"job detail header\">\n                        <div class=\"flex flex-wrap items-start justify-between gap-5\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"job detail top header row\">\n                            <div class=\"min-w-0\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"job detail title container\">\n                                <div class=\"mb-3 flex items-center gap-2 text-[12px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-2-1-1-1-1\" data-name=\"job detail location row\">\n                                    <i class=\"icon-map-pin text-[14px]\" data-kid=\"1-2-3-1-2-1-1-1-1-1\" data-name=\"job detail location pin icon\">\n                                    </i>\n                                    Zone 1, Poblacion, Digos City\n                                </div>\n                                <h2 class=\"m-0 text-[31px] font-normal leading-tight tracking-[-0.055em] text-[#f7f5f0] lg:text-[36px]\" data-kid=\"1-2-3-1-2-1-1-1-2\" data-name=\"job detail main headline\">\n                                    Store Manager\n                                </h2>\n                                <p class=\"mb-0 mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[14px] text-[#dad2c1]\" data-kid=\"1-2-3-1-2-1-1-1-3\" data-name=\"job detail employer line\">\n                                    Digos Central Mall\n                                    <span aria-label=\"Employer documents reviewed\" class=\"inline-flex items-center gap-1.5 text-[12px] text-[#c9c0ad]\" data-kid=\"1-2-3-1-2-1-1-1-3-1\" data-name=\"job detail verified employer badge\">\n                                        <i class=\"icon-badge-check text-[15px]\" data-kid=\"1-2-3-1-2-1-1-1-3-1-1\" data-name=\"verified badge check icon\">\n                                        </i>\n                                        Employer documents reviewed\n                                    </span>\n                                </p>\n                            </div>\n                            <button aria-label=\"Save Store Manager job\" class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#3f3a36] text-[17px] text-[#dad2c1]\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"save job bookmark button\">\n                                <i class=\"icon-bookmark\" data-kid=\"1-2-3-1-2-1-1-2-1\" data-name=\"bookmark save icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"mt-6 grid grid-cols-1 gap-0 border-y border-[#3f3a36] sm:grid-cols-3\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"job detail quick stats row\">\n                            <div class=\"border-b border-[#3f3a36] py-3.5 sm:border-b-0 sm:border-r sm:pr-4\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"pay stat cell\">\n                                <p class=\"m-0 text-[11px] font-medium text-[#aea69c]\" data-kid=\"1-2-3-1-2-1-2-1-1\" data-name=\"pay stat label\">\n                                    Pay\n                                </p>\n                                <p class=\"mb-0 mt-1 font-mono text-[15px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-2-1-2-1-2\" data-name=\"pay stat value\">\n                                    ₱15k–₱20k / month\n                                </p>\n                            </div>\n                            <div class=\"border-b border-[#3f3a36] py-3.5 sm:border-b-0 sm:px-4\" data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"employment stat cell\">\n                                <p class=\"m-0 text-[11px] font-medium text-[#aea69c]\" data-kid=\"1-2-3-1-2-1-2-2-1\" data-name=\"employment stat label\">\n                                    Employment\n                                </p>\n                                <p class=\"mb-0 mt-1 text-[14px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-2-1-2-2-2\" data-name=\"employment stat value\">\n                                    Full-time\n                                </p>\n                            </div>\n                            <div class=\"py-3.5 sm:border-l sm:border-[#3f3a36] sm:pl-4\" data-kid=\"1-2-3-1-2-1-2-3\" data-name=\"getting there stat cell\">\n                                <p class=\"m-0 text-[11px] font-medium text-[#aea69c]\" data-kid=\"1-2-3-1-2-1-2-3-1\" data-name=\"getting there stat label\">\n                                    Getting there\n                                </p>\n                                <p class=\"mb-0 mt-1 text-[14px] text-[#f7f5f0]\" data-kid=\"1-2-3-1-2-1-2-3-2\" data-name=\"getting there stat value\">\n                                    Walk from Public Market\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex-1 px-7 py-7 lg:px-9\" data-kid=\"1-2-3-1-2-2\" data-name=\"job detail body sections\">\n                        <section data-kid=\"1-2-3-1-2-2-1\" data-name=\"about the role section\">\n                            <h3 class=\"m-0 text-[14px] font-medium text-[#f7f5f0]\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"about the role heading\">\n                                About the role\n                            </h3>\n                            <p class=\"mb-0 mt-3 max-w-[62ch] text-[14px] leading-[1.8] text-[#c9c0ad]\" data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"about the role description text\">\n                                We are looking for a reliable and energetic individual to join our team in Digos City. You will be responsible for daily operations, ensuring customer satisfaction, and managing local inventory. This role requires someone who lives nearby and can commit to our standard operating hours.\n                            </p>\n                        </section>\n                        <section class=\"mt-7 border-t border-[#3f3a36] pt-5\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"requirements section\">\n                            <h3 class=\"m-0 text-[14px] font-medium text-[#f7f5f0]\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"requirements section heading\">\n                                What you’ll need\n                            </h3>\n                            <ul class=\"mb-0 mt-3 max-w-[62ch] space-y-2 pl-5 text-[13px] leading-6 text-[#c9c0ad]\" data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"requirements list\">\n                                <li data-kid=\"1-2-3-1-2-2-2-2-1\" data-name=\"requirement list item 1\">\n                                    Resident of Digos City, preferably near Zone 1, Poblacion.\n                                </li>\n                                <li data-kid=\"1-2-3-1-2-2-2-2-2\" data-name=\"requirement list item 2\">\n                                    At least 6 months of experience in a related field.\n                                </li>\n                                <li data-kid=\"1-2-3-1-2-2-2-2-3\" data-name=\"requirement list item 3\">\n                                    Strong communication skills and a customer-first attitude.\n                                </li>\n                                <li data-kid=\"1-2-3-1-2-2-2-2-4\" data-name=\"requirement list item 4\">\n                                    Available to start immediately.\n                                </li>\n                            </ul>\n                        </section>\n                        <section class=\"mt-7 border-t border-[#3f3a36] pt-5\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"application section\">\n                            <h3 class=\"m-0 text-[14px] font-medium text-[#f7f5f0]\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"application section heading\">\n                                Application\n                            </h3>\n                            <p class=\"mb-0 mt-2 text-[13px] leading-5 text-[#c9c0ad]\" data-kid=\"1-2-3-1-2-2-3-2\" data-name=\"application description text\">\n                                Apply using the Digos Talent Form. A résumé is optional.\n                            </p>\n                        </section>\n                    </div>\n                    <div class=\"sticky bottom-0 mt-auto flex flex-wrap items-center justify-between gap-4 border-t border-[#3f3a36] bg-[#2b2622] px-7 py-4 lg:px-9\" data-kid=\"1-2-3-1-2-3\" data-name=\"job detail sticky apply bar\">\n                        <p class=\"m-0 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"apply bar note text\">\n                            A short talent form is enough to apply.\n                        </p>\n                        <button class=\"inline-flex min-h-[44px] items-center justify-center gap-2 bg-[#f7f5f0] px-5 text-[14px] font-medium text-[#2b2622] hover:bg-[#dad2c1]\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"primary apply for job button\">\n                            Apply for Store Manager\n                            <i class=\"icon-arrow-up-right text-[16px]\" data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"apply arrow up right icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-5 flex flex-wrap items-center justify-between gap-2 text-[11px] text-[#aea69c]\" data-kid=\"1-2-4\" data-name=\"page footer bar\">\n            <span data-kid=\"1-2-4-1\" data-name=\"footer browse jobs label\">\n                Browse jobs in Digos City\n            </span>\n            <span data-kid=\"1-2-4-2\" data-name=\"footer verification disclosure text\">\n                Employer verification is based on document review; unverified jobs remain browseable.\n            </span>\n        </footer>\n    </main>\n</div>\n",
      "comments": [],
