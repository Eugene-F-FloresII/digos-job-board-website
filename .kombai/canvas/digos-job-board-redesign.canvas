      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n* { box-sizing: border-box; }\n.digos-employer { min-height: 100vh; background: #2b2622; color: #f7f5f0; font-family: Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }\n.digos-employer a { color: inherit; text-decoration: none; }\n.digos-employer button { font: inherit; }\n.employer-wrap { width: min(100% - 64px, 1216px); margin: 0 auto; }\n.employer-header { min-height: 68px; border-bottom: 1px solid #3f3a36; display: flex; align-items: center; }\n.employer-nav { display:flex; align-items:center; justify-content:space-between; gap:40px; }\n.employer-brand-nav { display:flex; align-items:center; gap:56px; }\n.employer-brand { font-size:16px; font-weight:600; letter-spacing:-.4px; display:flex; align-items:center; gap:10px; white-space:nowrap; }\n.employer-brand-mark { width:26px; height:26px; border:1px solid #aea69c; display:grid; place-items:center; border-radius:3px; font-size:12px; font-weight:500; }\n.employer-links { display:flex; align-items:center; gap:30px; color:#c9c0ad; font-size:14px; }\n.employer-links a { min-height:42px; display:flex; align-items:center; border-bottom:1px solid transparent; }\n.employer-links a.active { color:#f7f5f0; border-bottom-color:#f7f5f0; }\n.employer-locale { color:#aea69c; font-size:13px; white-space:nowrap; }\n.employer-main { padding:54px 0 74px; }\n.employer-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:30px; margin-bottom:42px; }\n.employer-heading h1 { font-size:34px; line-height:1.16; font-weight:500; letter-spacing:-1.05px; margin:0; }\n.employer-heading p { color:#c9c0ad; font-size:15px; margin:10px 0 0; line-height:1.55; }\n.employer-post { height:44px; display:inline-flex; align-items:center; justify-content:center; gap:9px; padding:0 17px; background:#f7f5f0; color:#2b2622!important; border:1px solid #f7f5f0; border-radius:3px; font-size:14px; font-weight:500; white-space:nowrap; }\n.employer-layout { display:grid; grid-template-columns:minmax(0, 1fr) 310px; gap:66px; align-items:start; }\n.employer-section { margin:0 0 42px; }\n.employer-section-head { display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding-bottom:13px; border-bottom:1px solid #3f3a36; }\n.employer-section-head h2 { margin:0; font-size:19px; line-height:1.4; font-weight:500; letter-spacing:-.25px; }\n.employer-count { color:#aea69c; font-family:'DM Mono',monospace; font-size:13px; }\n.employer-row { display:grid; grid-template-columns:minmax(210px,1.2fr) minmax(115px,.7fr) minmax(128px,.72fr) auto; align-items:center; column-gap:25px; min-height:92px; padding:18px 2px; border-bottom:1px solid #3f3a36; }\n.employer-role { display:flex; flex-direction:column; gap:7px; min-width:0; }\n.employer-role strong { font-size:16px; line-height:1.4; font-weight:500; letter-spacing:-.2px; }\n.employer-verified { color:#c9c0ad; font-size:12px; display:inline-flex; gap:6px; align-items:center; }\n.employer-verified .icon { font-size:14px; }\n.employer-detail { color:#c9c0ad; font-size:14px; line-height:1.45; }\n.employer-date { color:#aea69c; font-size:13px; text-align:right; white-space:nowrap; }\n.employer-row-action { display:inline-flex; align-items:center; justify-content:flex-end; gap:8px; color:#f7f5f0!important; font-size:14px; font-weight:500; white-space:nowrap; min-height:44px; }\n.employer-row-action .icon { font-size:15px; color:#aea69c; }\n.employer-drafts { margin-top:42px; }\n.employer-aside { padding-top:2px; }\n.employer-aside h2 { margin:0 0 17px; font-size:16px; line-height:1.4; font-weight:500; }\n.employer-note { border-top:1px solid #3f3a36; padding:17px 0 18px; }\n.employer-note:first-of-type { border-top:1px solid #3f3a36; }\n.employer-note h3 { margin:0 0 7px; font-size:14px; font-weight:500; line-height:1.45; }\n.employer-note p { margin:0; color:#c9c0ad; font-size:13px; line-height:1.7; }\n.employer-note a { display:inline-flex; align-items:center; gap:7px; margin-top:13px; color:#f7f5f0; font-size:13px; font-weight:500; text-decoration:underline; text-decoration-color:#6d655d; text-underline-offset:4px; }\n.employer-footer { width:min(100% - 64px,1216px); margin:0 auto; border-top:1px solid #3f3a36; padding:17px 0 30px; display:flex; align-items:center; justify-content:space-between; gap:16px; color:#aea69c; font-size:12px; }\n@media(max-width:900px){.employer-wrap,.employer-footer{width:min(100% - 40px,680px)}.employer-layout{grid-template-columns:1fr;gap:32px}.employer-aside{border-top:1px solid #3f3a36;padding-top:27px;display:grid;grid-template-columns:1fr 1fr;gap:0 30px}.employer-aside h2{grid-column:1/-1;margin-bottom:10px}.employer-note{padding:14px 0}.employer-row{grid-template-columns:minmax(180px,1fr) minmax(100px,.55fr) auto;column-gap:16px}.employer-date{grid-column:2;grid-row:2;text-align:left;font-size:12px}.employer-row-action{grid-column:3;grid-row:1/3}}\n@media(max-width:560px){.employer-wrap,.employer-footer{width:calc(100% - 36px)}.employer-header{min-height:60px}.employer-brand-nav{gap:18px}.employer-brand{font-size:14px;gap:7px}.employer-brand-mark{width:23px;height:23px}.employer-links{gap:13px;font-size:12px}.employer-links a{min-height:42px}.employer-locale{display:none}.employer-main{padding:34px 0 48px}.employer-heading{align-items:flex-start;flex-direction:column;gap:20px;margin-bottom:34px}.employer-heading h1{font-size:28px;letter-spacing:-.8px}.employer-heading p{font-size:14px}.employer-post{width:100%;min-height:46px}.employer-layout{gap:27px}.employer-section{margin-bottom:28px}.employer-section-head h2{font-size:17px}.employer-row{grid-template-columns:minmax(0,1fr) auto;row-gap:10px;column-gap:12px;min-height:unset;padding:17px 0}.employer-role{grid-column:1;grid-row:1}.employer-detail{grid-column:1;grid-row:2;font-size:13px}.employer-date{grid-column:1;grid-row:3}.employer-row-action{grid-column:2;grid-row:1/4;white-space:normal;text-align:right;max-width:140px;font-size:13px}.employer-aside{grid-template-columns:1fr;gap:0}.employer-aside h2{grid-column:auto}.employer-footer{font-size:11px;align-items:flex-start;flex-direction:column;gap:5px;padding-bottom:23px}}\n</style>\n<div class=\"digos-employer\" data-kid=\"1\" data-name=\"employer dashboard page\">\n    <header class=\"employer-header\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"employer-wrap employer-nav\" data-kid=\"1-1-1\" data-name=\"header navigation bar\">\n            <div class=\"employer-brand-nav\" data-kid=\"1-1-1-1\" data-name=\"brand and nav links container\">\n                <a aria-label=\"DigosJobs home\" class=\"employer-brand\" data-kid=\"1-1-1-1-1\" data-name=\"site brand link\" href=\"#\">\n                    <span class=\"employer-brand-mark\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand mark box\">\n                        D\n                    </span>\n                    <span data-kid=\"1-1-1-1-1-2\" data-name=\"brand name text\">\n                        DigosJobs\n                    </span>\n                </a>\n                <nav aria-label=\"Main navigation\" class=\"employer-links\" data-kid=\"1-1-1-1-2\" data-name=\"main navigation links\">\n                    <a data-kid=\"1-1-1-1-2-1\" data-name=\"jobs nav link\" href=\"#jobs\">\n                        Jobs\n                    </a>\n                    <a data-kid=\"1-1-1-1-2-2\" data-name=\"applications nav link\" href=\"#applications\">\n                        Applications\n                    </a>\n                    <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-1-1-2-3\" data-name=\"employer nav link active\" href=\"#employer\">\n                        Employer\n                    </a>\n                </nav>\n            </div>\n            <div class=\"employer-locale\" data-kid=\"1-1-1-2\" data-name=\"locale location label\">\n                Digos City\n            </div>\n        </div>\n    </header>\n    <main class=\"employer-wrap employer-main\" data-kid=\"1-2\" data-name=\"main employer content\">\n        <section class=\"employer-heading\" data-kid=\"1-2-1\" data-name=\"employer profile heading row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"employer heading text container\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"employer name headline\">\n                    Digos Central Mall\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"employer subtitle text\">\n                    Employer workspace · Digos City\n                </p>\n            </div>\n            <a class=\"employer-post\" data-kid=\"1-2-1-2\" data-name=\"post a job call-to-action button\" href=\"#post-job\">\n                <i aria-hidden=\"true\" class=\"icon icon-plus\" data-kid=\"1-2-1-2-1\" data-name=\"plus icon\">\n                </i>\n                Post a job\n            </a>\n        </section>\n        <div class=\"employer-layout\" data-kid=\"1-2-2\" data-name=\"main layout grid\">\n            <div data-kid=\"1-2-2-1\" data-name=\"job listings container\">\n                <section aria-labelledby=\"published-heading\" class=\"employer-section\" data-kid=\"1-2-2-1-1\" data-name=\"published jobs section\">\n                    <div class=\"employer-section-head\" data-kid=\"1-2-2-1-1-1\" data-name=\"published section header\">\n                        <h2 data-kid=\"1-2-2-1-1-1-1\" data-name=\"published section title\" id=\"published-heading\">\n                            Published\n                        </h2>\n                        <span class=\"employer-count\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"published listing count\">\n                            1 listing\n                        </span>\n                    </div>\n                    <article class=\"employer-row\" data-kid=\"1-2-2-1-1-2\" data-name=\"published job row card\">\n                        <div class=\"employer-role\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"job role details container\">\n                            <strong data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"job role title\">\n                                Store Manager\n                            </strong>\n                            <span class=\"employer-verified\" data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"verified employer badge\">\n                                <i aria-hidden=\"true\" class=\"icon icon-shield-check\" data-kid=\"1-2-2-1-1-2-1-2-1\" data-name=\"shield check icon\">\n                                </i>\n                                Verified employer\n                            </span>\n                        </div>\n                        <div class=\"employer-detail\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"job contract type detail\">\n                            Full-time\n                        </div>\n                        <div class=\"employer-date\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"job post date\">\n                            Posted Oct 1\n                        </div>\n                        <a class=\"employer-row-action\" data-kid=\"1-2-2-1-1-2-4\" data-name=\"view applicants action link\" href=\"#applicants\">\n                            View 12 applicants\n                            <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right\" data-kid=\"1-2-2-1-1-2-4-1\" data-name=\"arrow up-right icon\">\n                            </i>\n                        </a>\n                    </article>\n                </section>\n                <section aria-labelledby=\"drafts-heading\" class=\"employer-section employer-drafts\" data-kid=\"1-2-2-1-2\" data-name=\"drafts section\">\n                    <div class=\"employer-section-head\" data-kid=\"1-2-2-1-2-1\" data-name=\"drafts section header\">\n                        <h2 data-kid=\"1-2-2-1-2-1-1\" data-name=\"drafts section title\" id=\"drafts-heading\">\n                            Drafts\n                        </h2>\n                        <span class=\"employer-count\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"draft listing count\">\n                            1 listing\n                        </span>\n                    </div>\n                    <article class=\"employer-row\" data-kid=\"1-2-2-1-2-2\" data-name=\"draft job row card\">\n                        <div class=\"employer-role\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"draft job role container\">\n                            <strong data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"draft job role title\">\n                                Cashier\n                            </strong>\n                        </div>\n                        <div class=\"employer-detail\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"draft contract type detail\">\n                            Part-time\n                        </div>\n                        <div class=\"employer-date\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"draft last edited date\">\n                            Last edited 2h ago\n                        </div>\n                        <a class=\"employer-row-action\" data-kid=\"1-2-2-1-2-2-4\" data-name=\"continue editing action link\" href=\"#edit-draft\">\n                            Continue editing\n                            <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right\" data-kid=\"1-2-2-1-2-2-4-1\" data-name=\"arrow up-right icon\">\n                            </i>\n                        </a>\n                    </article>\n                </section>\n            </div>\n            <aside aria-label=\"Employer information\" class=\"employer-aside\" data-kid=\"1-2-2-2\" data-name=\"employer info aside\">\n                <h2 data-kid=\"1-2-2-2-1\" data-name=\"employer info heading\">\n                    Employer information\n                </h2>\n                <div class=\"employer-note\" data-kid=\"1-2-2-2-2\" data-name=\"verified employer info note\">\n                    <h3 data-kid=\"1-2-2-2-2-1\" data-name=\"verified employer note title\">\n                        Verified employer\n                    </h3>\n                    <p data-kid=\"1-2-2-2-2-2\" data-name=\"verified employer note description\">\n                        The employer’s business documents have been reviewed. This badge reflects document review, not a government endorsement.\n                    </p>\n                </div>\n                <div class=\"employer-note\" data-kid=\"1-2-2-2-3\" data-name=\"publishing job info note\">\n                    <h3 data-kid=\"1-2-2-2-3-1\" data-name=\"publishing job note title\">\n                        Publishing a job\n                    </h3>\n                    <p data-kid=\"1-2-2-2-3-2\" data-name=\"publishing job note description\">\n                        Include salary, job address, and work setup so local applicants can decide whether a role fits.\n                    </p>\n                    <a data-kid=\"1-2-2-2-3-3\" data-name=\"post a job info link\" href=\"#post-job\">\n                        Post a job\n                        <i aria-hidden=\"true\" class=\"icon icon-arrow-right\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n            </aside>\n        </div>\n    </main>\n    <footer class=\"employer-footer\" data-kid=\"1-3\" data-name=\"site footer bar\">\n        <span data-kid=\"1-3-1\" data-name=\"footer brand location text\">\n            DigosJobs · Digos City\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"footer tagline text\">\n            Local job information for applicants and employers\n        </span>\n    </footer>\n</div>\n",
