      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#2b2622] text-[#f7f5f0] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: Inter, sans-serif;\">\n    <header class=\"border-b border-[#3f3a36]\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"mx-auto flex min-h-[68px] max-w-[1200px] items-center justify-between gap-8 px-6 md:px-10\" data-kid=\"1-1-1\" data-name=\"header inner layout container\">\n            <a class=\"flex shrink-0 items-center gap-3 text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-[4px] border border-[#6d655d] text-[14px] font-medium tracking-[-0.04em]\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram icon\">\n                    D\n                </span>\n                <span class=\"text-[15px] font-medium tracking-[-0.02em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DigosJobs\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-2 text-[14px] font-medium sm:gap-5\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a class=\"rounded-[3px] px-2 py-3 text-[#c9c0ad] no-underline hover:text-[#f7f5f0]\" data-kid=\"1-1-1-2-1\" data-name=\"browse jobs nav link\" href=\"/jobs\">\n                    Browse jobs\n                </a>\n                <a aria-current=\"page\" class=\"border-b border-[#f7f5f0] px-2 py-3 text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-2-2\" data-name=\"my applications nav link (active)\" href=\"/applicant\">\n                    My applications\n                </a>\n                <a class=\"hidden rounded-[3px] px-2 py-3 text-[#c9c0ad] no-underline hover:text-[#f7f5f0] sm:inline-flex\" data-kid=\"1-1-1-2-3\" data-name=\"employer portal nav link\" href=\"/employer\">\n                    Employer portal\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[1120px] px-6 pb-20 pt-12 md:px-10 md:pt-16\" data-kid=\"1-2\" data-name=\"main application content area\">\n        <div class=\"flex flex-wrap items-end justify-between gap-4 border-b border-[#3f3a36] pb-7\" data-kid=\"1-2-1\" data-name=\"page heading header row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title block\">\n                <h1 class=\"m-0 text-[32px] font-medium leading-[1.15] tracking-[-0.045em] text-[#f7f5f0] md:text-[38px]\" data-kid=\"1-2-1-1-1\" data-name=\"page title heading\">\n                    My applications\n                </h1>\n                <p class=\"mb-0 mt-3 text-[15px] leading-6 text-[#c9c0ad]\" data-kid=\"1-2-1-1-2\" data-name=\"page subtitle text\">\n                    Check the status of jobs you’ve applied for.\n                </p>\n            </div>\n            <span class=\"pb-1 text-[13px] text-[#aea69c]\" data-kid=\"1-2-1-2\" data-name=\"application count badge text\">\n                1 application\n            </span>\n        </div>\n        <div class=\"grid grid-cols-1 gap-10 pt-9 lg:grid-cols-[minmax(0,1fr)_270px] lg:gap-14\" data-kid=\"1-2-2\" data-name=\"two-column grid layout\">\n            <section aria-labelledby=\"application-title\" data-kid=\"1-2-2-1\" data-name=\"application list section\">\n                <article class=\"overflow-hidden rounded-[6px] border border-[#3f3a36] bg-[#383330]\" data-kid=\"1-2-2-1-1\" data-name=\"application card\">\n                    <div class=\"flex flex-wrap items-start justify-between gap-x-8 gap-y-5 px-6 py-6 md:px-8 md:py-7\" data-kid=\"1-2-2-1-1-1\" data-name=\"application card top row\">\n                        <div class=\"min-w-[220px] flex-1\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"job details block\">\n                            <div class=\"mb-3 inline-flex items-center gap-2 rounded-full border border-[#6d655d] px-3 py-1.5 text-[12px] font-medium leading-4 text-[#f7f5f0]\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"status pill badge\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#f7f5f0]\" data-kid=\"1-2-2-1-1-1-1-1-1\" data-name=\"status dot indicator\">\n                                </span>\n                                Under review\n                            </div>\n                            <h2 class=\"m-0 text-[23px] font-medium leading-[1.25] tracking-[-0.035em] text-[#f7f5f0] md:text-[26px]\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"job title heading\" id=\"application-title\">\n                                Store Manager\n                            </h2>\n                            <p class=\"mb-0 mt-2 text-[14px] leading-5 text-[#dad2c1]\" data-kid=\"1-2-2-1-1-1-1-3\" data-name=\"job location text\">\n                                Digos Central Mall\n                                <span class=\"px-1.5 text-[#aea69c]\" data-kid=\"1-2-2-1-1-1-1-3-1\" data-name=\"location separator dot\">\n                                    ·\n                                </span>\n                                Zone 1 (Poblacion)\n                            </p>\n                        </div>\n                        <div class=\"pt-1 text-left md:text-right\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"pay block\">\n                            <p class=\"m-0 text-[12px] leading-4 text-[#aea69c]\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"pay label text\">\n                                Pay listed\n                            </p>\n                            <p class=\"mb-0 mt-1.5 text-[15px] font-medium leading-5 text-[#f7f5f0]\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"pay range amount text\">\n                                ₱15k–₱20k\n                                <span class=\"font-normal text-[#c9c0ad]\" data-kid=\"1-2-2-1-1-1-2-2-1\" data-name=\"pay period suffix text\">\n                                    / month\n                                </span>\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"border-t border-[#3f3a36] px-6 py-6 md:px-8 md:py-7\" data-kid=\"1-2-2-1-1-2\" data-name=\"application history block\">\n                        <h3 class=\"m-0 text-[16px] font-medium leading-6 text-[#f7f5f0]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"application history heading\">\n                            Application history\n                        </h3>\n                        <ol class=\"mb-0 mt-5 list-none p-0\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"application timeline list\">\n                            <li class=\"relative flex gap-4 pb-6\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"timeline item\">\n                                <span class=\"absolute bottom-0 left-[5px] top-[11px] w-px bg-[#6d655d]\" data-kid=\"1-2-2-1-1-2-2-1-1\" data-name=\"timeline connector line\">\n                                </span>\n                                <span class=\"relative z-10 mt-[4px] h-[11px] w-[11px] shrink-0 rounded-full border border-[#f7f5f0] bg-[#f7f5f0]\" data-kid=\"1-2-2-1-1-2-2-1-2\" data-name=\"timeline active dot\">\n                                </span>\n                                <div data-kid=\"1-2-2-1-1-2-2-1-3\" data-name=\"timeline item text block\">\n                                    <p class=\"m-0 text-[14px] font-medium leading-5 text-[#f7f5f0]\" data-kid=\"1-2-2-1-1-2-2-1-3-1\" data-name=\"timeline event title\">\n                                        Application submitted\n                                    </p>\n                                    <p class=\"mb-0 mt-1 text-[13px] leading-5 text-[#aea69c]\" data-kid=\"1-2-2-1-1-2-2-1-3-2\" data-name=\"timeline event date text\">\n                                        October 2, 2026 · 10:00 AM\n                                    </p>\n                                </div>\n                            </li>\n                            <li class=\"relative flex gap-4\" data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"timeline item\">\n                                <span class=\"relative z-10 mt-[4px] h-[11px] w-[11px] shrink-0 rounded-full border border-[#f7f5f0] bg-[#383330]\" data-kid=\"1-2-2-1-1-2-2-2-1\" data-name=\"timeline hollow dot\">\n                                </span>\n                                <div data-kid=\"1-2-2-1-1-2-2-2-2\" data-name=\"timeline item text block\">\n                                    <p class=\"m-0 text-[14px] font-medium leading-5 text-[#f7f5f0]\" data-kid=\"1-2-2-1-1-2-2-2-2-1\" data-name=\"timeline event title\">\n                                        Under review\n                                    </p>\n                                    <p class=\"mb-0 mt-1 max-w-[540px] text-[14px] leading-[1.55] text-[#c9c0ad]\" data-kid=\"1-2-2-1-1-2-2-2-2-2\" data-name=\"timeline event description\">\n                                        The employer is currently reviewing your profile.\n                                    </p>\n                                </div>\n                            </li>\n                        </ol>\n                    </div>\n                </article>\n            </section>\n            <aside aria-label=\"Application actions\" class=\"border-t border-[#3f3a36] pt-5 lg:border-l lg:border-t-0 lg:pl-7 lg:pt-1\" data-kid=\"1-2-2-2\" data-name=\"action sidebar\">\n                <h3 class=\"m-0 text-[15px] font-medium leading-6 text-[#f7f5f0]\" data-kid=\"1-2-2-2-1\" data-name=\"sidebar section heading\">\n                    For this application\n                </h3>\n                <p class=\"mb-0 mt-2 text-[14px] leading-[1.6] text-[#c9c0ad]\" data-kid=\"1-2-2-2-2\" data-name=\"sidebar description text\">\n                    Review the Store Manager role and its requirements at any time.\n                </p>\n                <a class=\"mt-5 inline-flex min-h-[44px] items-center justify-center gap-2 rounded-[3px] bg-[#f7f5f0] px-4 py-2.5 text-[14px] font-medium leading-5 text-[#2b2622] no-underline hover:bg-[#dad2c1] focus:outline-none focus:ring-2 focus:ring-[#f7f5f0] focus:ring-offset-2 focus:ring-offset-[#2b2622]\" data-kid=\"1-2-2-2-3\" data-name=\"view job details button\" href=\"/jobs?jobId=1\">\n                    View job details\n                    <i aria-hidden=\"true\" class=\"icon-arrow-right text-[15px]\" data-kid=\"1-2-2-2-3-1\" data-name=\"right arrow icon\">\n                    </i>\n                </a>\n                <div class=\"mt-8 border-t border-[#3f3a36] pt-5\" data-kid=\"1-2-2-2-4\" data-name=\"secondary action block\">\n                    <a class=\"inline-flex min-h-[44px] items-center text-[14px] font-medium text-[#dad2c1] underline decoration-[#6d655d] underline-offset-4 hover:text-[#f7f5f0]\" data-kid=\"1-2-2-2-4-1\" data-name=\"browse more jobs link\" href=\"/jobs\">\n                        Browse more jobs\n                    </a>\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n",
