    "var_92a264160e76": {
      "type": "variant",
      "label": "D · Job detail mobile",
      "parentId": "var_22a30fe0008c",
      "themeId": null,
      "rect": {
        "x": 18410,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#2b2622] text-[#f7f5f0] antialiased\" data-kid=\"1\" data-name=\"page shell with dark background\" style=\"font-family:Inter,system-ui,sans-serif\">\n    <header class=\"border-b border-[#3f3a36]\" data-kid=\"1-1\" data-name=\"site header\">\n        <div class=\"mx-auto flex h-[54px] max-w-[1120px] items-center justify-between px-5\" data-kid=\"1-1-1\" data-name=\"header top bar with brand and location\">\n            <a aria-label=\"DigosJobs home\" class=\"flex items-center gap-2.5 text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-1\" data-name=\"site logo link to home\" href=\"#jobs\">\n                <span class=\"flex h-7 w-7 items-center justify-center border border-[#aea69c] text-[12px] font-medium\" data-kid=\"1-1-1-1-1\" data-name=\"brand letter mark box\">\n                    D\n                </span>\n                <span class=\"text-[14px] font-medium tracking-[-0.25px]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DigosJobs\n                </span>\n            </a>\n            <span class=\"text-[12px] text-[#aea69c]\" data-kid=\"1-1-1-2\" data-name=\"location label Digos City\">\n                Digos City\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"mx-auto flex h-[42px] max-w-[1120px] items-stretch gap-6 px-5 text-[13px]\" data-kid=\"1-1-2\" data-name=\"primary horizontal navigation\">\n            <a aria-current=\"page\" class=\"flex items-center border-b border-[#f7f5f0] px-1 font-medium text-[#f7f5f0] no-underline\" data-kid=\"1-1-2-1\" data-name=\"jobs nav link (active page)\" href=\"#jobs\">\n                Jobs\n            </a>\n            <a class=\"flex items-center px-1 text-[#c9c0ad] no-underline\" data-kid=\"1-1-2-2\" data-name=\"applications nav link\" href=\"#applications\">\n                Applications\n            </a>\n            <a class=\"flex items-center px-1 text-[#c9c0ad] no-underline\" data-kid=\"1-1-2-3\" data-name=\"employer portal nav link\" href=\"#employer\">\n                Employer portal\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto max-w-[760px] px-5 pb-8 pt-5\" data-kid=\"1-2\" data-name=\"main job detail content\">\n        <a class=\"inline-flex min-h-[44px] items-center gap-2 text-[13px] font-medium text-[#dad2c1] no-underline\" data-kid=\"1-2-1\" data-name=\"back to jobs link\" href=\"#jobs\">\n            <i aria-hidden=\"true\" class=\"icon-arrow-left text-[16px]\" data-kid=\"1-2-1-1\" data-name=\"left arrow icon\">\n            </i>\n            <span data-kid=\"1-2-1-2\" data-name=\"back to jobs label\">\n                Back to jobs\n            </span>\n        </a>\n        <section aria-labelledby=\"job-title\" class=\"border-b border-[#3f3a36] pb-5 pt-2\" data-kid=\"1-2-2\" data-name=\"job title section\">\n            <p class=\"mb-2 text-[13px] text-[#c9c0ad]\" data-kid=\"1-2-2-1\" data-name=\"employer location line\">\n                Digos Central Mall\n            </p>\n            <h1 class=\"mb-2 text-[28px] font-medium leading-[1.12] tracking-[-0.8px] text-[#f7f5f0]\" data-kid=\"1-2-2-2\" data-name=\"job title headline\" id=\"job-title\">\n                Store Manager\n            </h1>\n            <p class=\"flex items-start gap-2 text-[12px] leading-[18px] text-[#dad2c1]\" data-kid=\"1-2-2-3\" data-name=\"verified employer notice row\">\n                <i aria-hidden=\"true\" class=\"icon-shield-check mt-[1px] text-[14px]\" data-kid=\"1-2-2-3-1\" data-name=\"shield check icon\">\n                </i>\n                <span data-kid=\"1-2-2-3-2\" data-name=\"verified employer notice text\">\n                    Employer documents reviewed\n                </span>\n            </p>\n        </section>\n        <section aria-label=\"Job details\" class=\"grid grid-cols-2 gap-x-5 gap-y-4 border-b border-[#3f3a36] py-5\" data-kid=\"1-2-3\" data-name=\"job details grid\">\n            <div data-kid=\"1-2-3-1\" data-name=\"pay detail block\">\n                <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-1\" data-name=\"pay detail label\">\n                    Pay\n                </p>\n                <p class=\"font-mono text-[15px] font-medium leading-5 text-[#f7f5f0]\" data-kid=\"1-2-3-1-2\" data-name=\"pay amount value\">\n                    ₱15k–₱20k\n                    <span class=\"ml-1.5 font-sans text-[13px] font-normal text-[#c9c0ad]\" data-kid=\"1-2-3-1-2-1\" data-name=\"pay per-month unit suffix\">\n                        / month\n                    </span>\n                </p>\n            </div>\n            <div data-kid=\"1-2-3-2\" data-name=\"employment detail block\">\n                <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-2-1\" data-name=\"employment detail label\">\n                    Employment\n                </p>\n                <p class=\"text-[14px] font-medium leading-5 text-[#f7f5f0]\" data-kid=\"1-2-3-2-2\" data-name=\"employment type value\">\n                    Full-time\n                </p>\n            </div>\n            <div data-kid=\"1-2-3-3\" data-name=\"area detail block\">\n                <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-3-1\" data-name=\"area detail label\">\n                    Area\n                </p>\n                <p class=\"flex items-center gap-1.5 text-[14px] font-medium leading-5 text-[#f7f5f0]\" data-kid=\"1-2-3-3-2\" data-name=\"area value with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin text-[14px] text-[#c9c0ad]\" data-kid=\"1-2-3-3-2-1\" data-name=\"map pin icon\">\n                    </i>\n                    Zone 1 (Poblacion)\n                </p>\n            </div>\n            <div data-kid=\"1-2-3-4\" data-name=\"work setup detail block\">\n                <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-4-1\" data-name=\"work setup detail label\">\n                    Work setup\n                </p>\n                <p class=\"text-[14px] leading-5 text-[#dad2c1]\" data-kid=\"1-2-3-4-2\" data-name=\"work setup value\">\n                    Not specified\n                </p>\n            </div>\n            <div class=\"col-span-2 border-t border-[#3f3a36] pt-3\" data-kid=\"1-2-3-5\" data-name=\"getting there detail block\">\n                <p class=\"mb-1 text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-5-1\" data-name=\"getting there label\">\n                    Getting there\n                </p>\n                <p class=\"flex items-center gap-2 text-[14px] leading-5 text-[#f7f5f0]\" data-kid=\"1-2-3-5-2\" data-name=\"transport direction row\">\n                    <i aria-hidden=\"true\" class=\"icon-bus-front text-[15px] text-[#c9c0ad]\" data-kid=\"1-2-3-5-2-1\" data-name=\"bus front icon\">\n                    </i>\n                    Walk from Public Market\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"apply-info\" class=\"border-b border-[#3f3a36] py-5\" data-kid=\"1-2-4\" data-name=\"what to prepare section\">\n            <h2 class=\"mb-2 text-[17px] font-medium tracking-[-0.2px] text-[#f7f5f0]\" data-kid=\"1-2-4-1\" data-name=\"what to prepare heading\" id=\"apply-info\">\n                What to prepare\n            </h2>\n            <p class=\"text-[14px] leading-[21px] text-[#dad2c1]\" data-kid=\"1-2-4-2\" data-name=\"what to prepare description\">\n                Apply with the Digos Talent Form. It asks for your name, phone number, barangay, education, and skills or experience. A résumé is optional.\n            </p>\n        </section>\n        <section aria-labelledby=\"listing-info\" class=\"py-5\" data-kid=\"1-2-5\" data-name=\"about this listing section\">\n            <h2 class=\"mb-2 text-[17px] font-medium tracking-[-0.2px] text-[#f7f5f0]\" data-kid=\"1-2-5-1\" data-name=\"about this listing heading\" id=\"listing-info\">\n                About this listing\n            </h2>\n            <p class=\"text-[14px] leading-[21px] text-[#dad2c1]\" data-kid=\"1-2-5-2\" data-name=\"about this listing description\">\n                A job-specific role description and requirements were not provided in this sample listing.\n            </p>\n        </section>\n        <footer class=\"mt-1 border-t border-[#3f3a36] pb-3 pt-4\" data-kid=\"1-2-6\" data-name=\"apply footer block\">\n            <a class=\"flex min-h-[48px] w-full items-center justify-between rounded-[4px] bg-[#f7f5f0] px-4 text-[14px] font-medium text-[#2b2622] no-underline\" data-kid=\"1-2-6-1\" data-name=\"primary apply call-to-action button\" href=\"#apply\">\n                <span data-kid=\"1-2-6-1-1\" data-name=\"apply button label\">\n                    Apply for Store Manager\n                </span>\n                <i aria-hidden=\"true\" class=\"icon-arrow-right text-[16px]\" data-kid=\"1-2-6-1-2\" data-name=\"right arrow icon\">\n                </i>\n            </a>\n            <p class=\"mb-0 mt-2 text-center text-[12px] leading-[17px] text-[#aea69c]\" data-kid=\"1-2-6-2\" data-name=\"apply disclaimer footnote\">\n                This opens the application form; your application is not sent until you submit it.\n            </p>\n        </footer>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-11T13:29:01.272625+00:00",
      "modified": "2026-10-11T13:29:11.522802+00:00",
      "id": "var_92a264160e76",
      "contentHeight": 1000
    },
    "var_36eb7d3f6783": {
      "type": "variant",
      "label": "D · Applications",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 21980,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.d-apps{min-height:100vh;background:#2b2622;color:#f7f5f0;font-family:Inter,system-ui,sans-serif;font-size:14px;line-height:1.5}\n.d-apps *{box-sizing:border-box}\n.d-apps a{color:inherit;text-decoration:none}\n.d-apps button{font:inherit}\n.d-apps .topbar{border-bottom:1px solid #3f3a36}\n.d-apps .top-inner{max-width:1180px;margin:0 auto;padding:0 28px;min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:28px}\n.d-apps .brand{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;font-size:14px;font-weight:500;letter-spacing:-.02em}\n.d-apps .brand-mark{width:29px;height:29px;border:1px solid #aea69c;display:grid;place-items:center;border-radius:3px;font-size:12px;font-weight:500}\n.d-apps .brand-city{color:#aea69c;font-size:12px;font-weight:400;letter-spacing:0;margin-left:5px}\n.d-apps .nav{display:flex;align-items:stretch;gap:30px;min-height:68px}\n.d-apps .nav a{display:flex;align-items:center;color:#c9c0ad;border-bottom:1px solid transparent;font-size:13px;transition:color .15s,border-color .15s}\n.d-apps .nav a:hover,.d-apps .nav a:focus-visible{color:#f7f5f0}\n.d-apps .nav a[aria-current=\"page\"]{color:#f7f5f0;border-color:#f7f5f0}\n.d-apps .nav a:focus-visible,.d-apps .action:focus-visible,.d-apps .text-link:focus-visible{outline:2px solid #f7f5f0;outline-offset:4px}\n.d-apps main{max-width:1120px;margin:0 auto;padding:52px 28px 72px}\n.d-apps .page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;padding-bottom:28px;border-bottom:1px solid #3f3a36}\n.d-apps h1{margin:0;color:#f7f5f0;font-size:36px;font-weight:400;letter-spacing:-1.1px;line-height:1.15}\n.d-apps .intro{margin:10px 0 0;color:#c9c0ad;font-size:15px;line-height:1.55;max-width:560px}\n.d-apps .heading-meta{color:#aea69c;font:12px 'DM Mono',monospace;white-space:nowrap;padding-bottom:3px}\n.d-apps .content-grid{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(230px,.8fr);gap:54px;align-items:start;padding-top:34px}\n.d-apps .application{background:#383330;border:1px solid #3f3a36;border-radius:4px;overflow:hidden}\n.d-apps .application-head{padding:25px 28px 23px;display:flex;flex-direction:column;align-items:stretch;gap:20px;border-bottom:1px solid #3f3a36}\n.d-apps .role{margin:0;color:#f7f5f0;font-size:23px;font-weight:500;letter-spacing:-.45px;line-height:1.3}\n.d-apps .company{margin:4px 0 0;color:#dad2c1;font-size:14px}\n.d-apps .status{display:inline-flex;align-items:center;gap:9px;white-space:nowrap;color:#f7f5f0;border:1px solid #6d655d;padding:6px 10px;border-radius:9999px;font-size:12px;line-height:1.2}\n.d-apps .status-dot{width:7px;height:7px;background:#f7f5f0;border-radius:50%;display:inline-block}\n.d-apps .job-facts{display:flex;align-items:center;flex-wrap:wrap;gap:9px 22px;margin-top:21px;color:#c9c0ad;font-size:13px}\n.d-apps .fact{display:inline-flex;align-items:center;gap:7px}\n.d-apps .fact i{font-size:14px;color:#aea69c}\n.d-apps .amount{font:500 13px 'DM Mono',monospace;color:#f7f5f0}\n.d-apps .history{padding:24px 28px 27px}\n.d-apps .section-title{margin:0 0 19px;color:#dad2c1;font-size:13px;font-weight:500;letter-spacing:.01em}\n.d-apps .timeline{position:relative;margin:0;padding:0;list-style:none}\n.d-apps .timeline:before{content:\"\";position:absolute;left:5px;top:9px;bottom:12px;width:1px;background:#6d655d}\n.d-apps .event{position:relative;padding:0 0 23px 24px;color:#dad2c1}\n.d-apps .event:last-child{padding-bottom:0}\n.d-apps .event-dot{position:absolute;left:0;top:5px;width:11px;height:11px;border:1px solid #f7f5f0;background:#383330;border-radius:50%}\n.d-apps .event:first-child .event-dot{background:#f7f5f0}\n.d-apps .event-title{display:block;color:#f7f5f0;font-weight:500;font-size:14px}\n.d-apps .event-note{margin:4px 0 0;color:#c9c0ad;font-size:13px;line-height:1.55}\n.d-apps .event-date{margin-top:4px;color:#aea69c;font:12px 'DM Mono',monospace}\n.d-apps .application-foot{padding:15px 28px;border-top:1px solid #3f3a36;color:#aea69c;font-size:12px}\n.d-apps .side{padding-top:2px}\n.d-apps .side-section{padding:0 0 24px;margin:0 0 24px;border-bottom:1px solid #3f3a36}\n.d-apps .side-section:last-child{border-bottom:0;margin-bottom:0}\n.d-apps .side-title{margin:0 0 9px;color:#f7f5f0;font-size:15px;font-weight:500;letter-spacing:-.1px}\n.d-apps .side-copy{margin:0;color:#c9c0ad;font-size:13px;line-height:1.6}\n.d-apps .side-job{margin-top:14px;padding:12px 0;border-top:1px solid #3f3a36;border-bottom:1px solid #3f3a36;display:grid;grid-template-columns:1fr auto;gap:8px 18px;color:#aea69c;font-size:12px}\n.d-apps .side-job strong{color:#dad2c1;font-weight:500;text-align:right}\n.d-apps .action{margin-top:16px;min-height:44px;padding:11px 15px;background:#f7f5f0;border:1px solid #f7f5f0;border-radius:3px;color:#2b2622;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:13px;font-weight:500;transition:background .15s,color .15s}\n.d-apps .action:hover{background:#dad2c1;border-color:#dad2c1}\n.d-apps .action i{font-size:15px}\n.d-apps .text-link{display:inline-flex;align-items:center;gap:8px;margin-top:14px;color:#dad2c1;font-size:13px;text-decoration:underline;text-underline-offset:4px}\n.d-apps .text-link:hover{color:#f7f5f0}\n.d-apps .footer{max-width:1120px;margin:0 auto;padding:0 28px 28px;display:flex;justify-content:space-between;gap:20px;color:#aea69c;font-size:12px}\n@media(max-width:760px){\n .d-apps .top-inner{padding:0 18px;min-height:0;display:flex;flex-wrap:wrap;gap:0}\n .d-apps .brand{height:55px}\n .d-apps .brand-city{display:none}\n .d-apps .nav{min-height:45px;height:45px;width:100%;justify-content:space-between;gap:12px;border-top:1px solid #3f3a36}\n .d-apps .nav a{font-size:12px;min-height:44px}\n .d-apps main{padding:34px 18px 48px}\n .d-apps .page-heading{align-items:flex-start;padding-bottom:21px}\n .d-apps h1{font-size:30px;letter-spacing:-.8px}\n .d-apps .intro{font-size:14px;max-width:390px}\n .d-apps .heading-meta{display:none}\n .d-apps .content-grid{grid-template-columns:1fr;gap:26px;padding-top:22px}\n .d-apps .application-head{padding:20px 18px;display:block}\n .d-apps .role-line{display:flex;flex-direction:column;align-items:flex-start;gap:12px}\n .d-apps .role{font-size:21px}\n .d-apps .job-facts{margin-top:16px;gap:10px 18px}\n .d-apps .history{padding:21px 18px 23px}\n .d-apps .application-foot{padding:13px 18px}\n .d-apps .side{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n .d-apps .side-section{padding:0 0 18px;margin:0;border-bottom:1px solid #3f3a36}\n .d-apps .side-section:last-child{grid-column:1/-1}\n .d-apps .action{width:100%}\n .d-apps .footer{padding:0 18px 22px;display:block}\n .d-apps .footer span{display:block;margin-top:5px}\n}\n@media(max-width:430px){\n .d-apps .side{grid-template-columns:1fr;gap:18px}\n .d-apps .side-section:last-child{grid-column:auto}\n .d-apps .page-heading{display:block}\n .d-apps .content-grid{gap:21px}\n}\n</style>\n<div class=\"d-apps\" data-kid=\"1\" data-name=\"job applications page container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top bar with brand and nav\">\n        <div class=\"top-inner\" data-kid=\"1-1-1\" data-name=\"header inner layout row\">\n            <a aria-label=\"DigosJobs home\" class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand link to home\" href=\"/\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand letter mark badge\">\n                    D\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DigosJobs\n                </span>\n                <span class=\"brand-city\" data-kid=\"1-1-1-1-3\" data-name=\"brand city label\">\n                    Digos City\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"find jobs nav link\" href=\"/jobs\">\n                    Find jobs\n                </a>\n                <a aria-current=\"page\" data-kid=\"1-1-1-2-2\" data-name=\"applications nav link (current page)\" href=\"/applicant\">\n                    Applications\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"employer portal nav link\" href=\"/employer\">\n                    Employer portal\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"page-heading\" data-kid=\"1-2-1\" data-name=\"page heading row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"heading text container\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name='page headline \"Your applications\"'>\n                    Your applications\n                </h1>\n                <p class=\"intro\" data-kid=\"1-2-1-1-2\" data-name=\"page intro description\">\n                    Check the latest status for jobs you’ve applied to.\n                </p>\n            </div>\n            <span class=\"heading-meta\" data-kid=\"1-2-1-2\" data-name=\"location meta label\">\n                Digos City\n            </span>\n        </div>\n        <div class=\"content-grid\" data-kid=\"1-2-2\" data-name=\"two-column content grid\">\n            <article aria-labelledby=\"application-title\" class=\"application\" data-kid=\"1-2-2-1\" data-name=\"application detail card\">\n                <div class=\"application-head\" data-kid=\"1-2-2-1-1\" data-name=\"application card header\">\n                    <div class=\"role-line\" data-kid=\"1-2-2-1-1-1\" data-name=\"role and status row\" style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:18px\">\n                        <div data-kid=\"1-2-2-1-1-1-1\" data-name=\"job title and company container\">\n                            <h2 class=\"role\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"job role title\" id=\"application-title\">\n                                Store Manager\n                            </h2>\n                            <p class=\"company\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"company name text\">\n                                Digos Central Mall\n                            </p>\n                        </div>\n                        <span class=\"status\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"application status pill\">\n                            <span aria-hidden=\"true\" class=\"status-dot\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"status indicator dot\">\n                            </span>\n                            Under review\n                        </span>\n                    </div>\n                    <div class=\"job-facts\" data-kid=\"1-2-2-1-1-2\" data-name=\"job facts row\">\n                        <span class=\"fact\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"job location fact\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            Zone 1 (Poblacion)\n                        </span>\n                        <span class=\"fact\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"job type fact\">\n                            <i aria-hidden=\"true\" class=\"icon-briefcase-business\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"briefcase icon\">\n                            </i>\n                            Full-time\n                        </span>\n                        <span class=\"fact amount\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"job pay range fact\">\n                            ₱15k–₱20k / month\n                        </span>\n                    </div>\n                </div>\n                <div class=\"history\" data-kid=\"1-2-2-1-2\" data-name=\"application history section\">\n                    <h3 class=\"section-title\" data-kid=\"1-2-2-1-2-1\" data-name=\"history section title\">\n                        Application history\n                    </h3>\n                    <ol class=\"timeline\" data-kid=\"1-2-2-1-2-2\" data-name=\"application timeline list\">\n                        <li class=\"event\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"timeline event: application submitted\">\n                            <span aria-hidden=\"true\" class=\"event-dot\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"timeline event dot (active)\">\n                            </span>\n                            <strong class=\"event-title\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"timeline event title\">\n                                Application submitted\n                            </strong>\n                            <div class=\"event-date\" data-kid=\"1-2-2-1-2-2-1-3\" data-name=\"timeline event date\">\n                                Oct 2, 2026 · 10:00 AM\n                            </div>\n                        </li>\n                        <li class=\"event\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"timeline event: under review\">\n                            <span aria-hidden=\"true\" class=\"event-dot\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"timeline event dot\">\n                            </span>\n                            <strong class=\"event-title\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"timeline event title\">\n                                Under review\n                            </strong>\n                            <p class=\"event-note\" data-kid=\"1-2-2-1-2-2-2-3\" data-name=\"timeline event note\">\n                                The employer is currently reviewing your profile.\n                            </p>\n                        </li>\n                    </ol>\n                </div>\n                <div class=\"application-foot\" data-kid=\"1-2-2-1-3\" data-name=\"application footer disclaimer\">\n                    Application status is shown as provided by the employer.\n                </div>\n            </article>\n            <aside aria-label=\"Application details and next steps\" class=\"side\" data-kid=\"1-2-2-2\" data-name=\"side details sidebar\">\n                <section class=\"side-section\" data-kid=\"1-2-2-2-1\" data-name=\"latest update side section\">\n                    <h2 class=\"side-title\" data-kid=\"1-2-2-2-1-1\" data-name=\"latest update section title\">\n                        Latest update\n                    </h2>\n                    <p class=\"side-copy\" data-kid=\"1-2-2-2-1-2\" data-name=\"latest update description\">\n                        Your application is under review. No further update is shown yet.\n                    </p>\n                </section>\n                <section class=\"side-section\" data-kid=\"1-2-2-2-2\" data-name=\"return to job side section\">\n                    <h2 class=\"side-title\" data-kid=\"1-2-2-2-2-1\" data-name=\"return to job section title\">\n                        Return to the job\n                    </h2>\n                    <p class=\"side-copy\" data-kid=\"1-2-2-2-2-2\" data-name=\"return to job description\">\n                        Review the Store Manager listing and the information shared by Digos Central Mall.\n                    </p>\n                    <div class=\"side-job\" data-kid=\"1-2-2-2-2-3\" data-name=\"job summary grid\">\n                        <span data-kid=\"1-2-2-2-2-3-1\" data-name=\"pay label\">\n                            Pay\n                        </span>\n                        <strong data-kid=\"1-2-2-2-2-3-2\" data-name=\"pay value\">\n                            ₱15k–₱20k / month\n                        </strong>\n                        <span data-kid=\"1-2-2-2-2-3-3\" data-name=\"location label\">\n                            Location\n                        </span>\n                        <strong data-kid=\"1-2-2-2-2-3-4\" data-name=\"location value\">\n                            Zone 1 (Poblacion)\n                        </strong>\n                    </div>\n                    <a class=\"action\" data-kid=\"1-2-2-2-2-4\" data-name=\"view job call-to-action button\" href=\"/jobs?jobId=1\">\n                        View Store Manager job\n                        <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"arrow up-right icon\">\n                        </i>\n                    </a>\n                </section>\n                <section class=\"side-section\" data-kid=\"1-2-2-2-3\" data-name=\"while you wait side section\">\n                    <h2 class=\"side-title\" data-kid=\"1-2-2-2-3-1\" data-name=\"while you wait section title\">\n                        While you wait\n                    </h2>\n                    <p class=\"side-copy\" data-kid=\"1-2-2-2-3-2\" data-name=\"while you wait description\">\n                        Browse other openings in Digos City.\n                    </p>\n                    <a class=\"text-link\" data-kid=\"1-2-2-2-3-3\" data-name=\"find more jobs text link\" href=\"/jobs\">\n                        Find more jobs\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </section>\n            </aside>\n        </div>\n    </main>\n    <footer class=\"footer\" data-kid=\"1-3\" data-name=\"page footer\">\n        <span data-kid=\"1-3-1\" data-name=\"footer brand text\">\n            DigosJobs · Digos City\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"footer disclaimer text\">\n            Application status reflects the information provided by the employer.\n        </span>\n    </footer>\n</div>\n",
      "comments": [],
