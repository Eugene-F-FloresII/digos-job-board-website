      "contentHeight": 1000
    },
    "var_50740b48f4a5": {
      "type": "variant",
      "label": "C · Job detail mobile",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 14840,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#2b2622] text-[#f7f5f0] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:Inter,system-ui,sans-serif\">\n    <header class=\"sticky top-0 z-20 border-b border-[#3f3a36] bg-[#2b2622] px-5\" data-kid=\"1-1\" data-name=\"sticky site header bar\">\n        <div class=\"mx-auto flex h-14 max-w-[720px] items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header inner layout container\">\n            <a class=\"flex items-center gap-2 text-[15px] font-semibold tracking-[-0.3px] text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-1\" data-name=\"site logo with brand wordmark\" href=\"#jobs\">\n                <span class=\"flex h-7 w-7 items-center justify-center rounded-[3px] bg-[#f7f5f0] text-[13px] font-semibold text-[#2b2622]\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram square\">\n                    D\n                </span>\n                DigosJobs\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-5 text-[13px] font-medium\" data-kid=\"1-1-1-2\" data-name=\"primary navigation links\">\n                <a aria-current=\"page\" class=\"text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"active jobs navigation link\" href=\"#jobs\">\n                    Jobs\n                </a>\n                <a class=\"text-[#aea69c] no-underline\" data-kid=\"1-1-1-2-2\" data-name=\"applications navigation link\" href=\"#applications\">\n                    Applications\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[720px] px-5 pb-32 pt-4\" data-kid=\"1-2\" data-name=\"main job detail page content\">\n        <a class=\"inline-flex min-h-11 items-center gap-2 text-[13px] font-medium text-[#c9c0ad] no-underline\" data-kid=\"1-2-1\" data-name=\"back to jobs navigation link\" href=\"#jobs\">\n            <i aria-hidden=\"true\" class=\"icon-arrow-left text-[16px]\" data-kid=\"1-2-1-1\" data-name=\"left arrow icon\">\n            </i>\n            Back to jobs\n        </a>\n        <article class=\"pt-2\" data-kid=\"1-2-2\" data-name=\"job detail article container\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-1\" data-name=\"job title and status row\">\n                <div class=\"min-w-0\" data-kid=\"1-2-2-1-1\" data-name=\"job identifying info block\">\n                    <h1 class=\"m-0 text-[26px] font-medium leading-[1.12] tracking-[-0.8px] text-[#f7f5f0]\" data-kid=\"1-2-2-1-1-1\" data-name=\"job position headline\">\n                        Store Manager\n                    </h1>\n                    <p class=\"mt-1.5 text-[15px] leading-5 text-[#dad2c1]\" data-kid=\"1-2-2-1-1-2\" data-name=\"employer company name text\">\n                        Digos Central Mall\n                    </p>\n                </div>\n                <span class=\"mt-1 inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#3f3a36] px-2.5 py-1 text-[11px] font-medium text-[#dad2c1]\" data-kid=\"1-2-2-1-2\" data-name=\"verified status badge\">\n                    <i aria-hidden=\"true\" class=\"icon-badge-check text-[13px]\" data-kid=\"1-2-2-1-2-1\" data-name=\"verified checkmark icon\">\n                    </i>\n                    Verified\n                </span>\n            </div>\n            <p class=\"mt-1.5 text-[12px] leading-[18px] text-[#aea69c]\" data-kid=\"1-2-2-2\" data-name=\"verification note text\">\n                Employer documents reviewed\n            </p>\n            <section aria-label=\"Job details\" class=\"mt-5 border-y border-[#3f3a36] py-3.5\" data-kid=\"1-2-2-3\" data-name=\"job details section\">\n                <div class=\"grid grid-cols-2 gap-x-3 gap-y-3\" data-kid=\"1-2-2-3-1\" data-name=\"job details two-column grid\">\n                    <div data-kid=\"1-2-2-3-1-1\" data-name=\"pay detail field container\">\n                        <p class=\"mb-0.5 text-[11px] leading-4 text-[#aea69c]\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"pay field label\">\n                            Pay\n                        </p>\n                        <p class=\"m-0 whitespace-nowrap text-[13px] font-medium leading-5 text-[#f7f5f0]\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"pay range value text\" style=\"font-family:'DM Mono',monospace\">\n                            ₱15k–₱20k / month\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-2-3-1-2\" data-name=\"work type detail field container\">\n                        <p class=\"mb-0.5 text-[11px] leading-4 text-[#aea69c]\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"work type field label\">\n                            Work type\n                        </p>\n                        <p class=\"m-0 text-[13px] font-medium leading-5 text-[#f7f5f0]\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"work type value text\">\n                            Full-time\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-2-3-1-3\" data-name=\"location detail field container\">\n                        <p class=\"mb-0.5 text-[11px] leading-4 text-[#aea69c]\" data-kid=\"1-2-2-3-1-3-1\" data-name=\"location field label\">\n                            Location\n                        </p>\n                        <p class=\"m-0 text-[13px] font-medium leading-5 text-[#f7f5f0]\" data-kid=\"1-2-2-3-1-3-2\" data-name=\"location value text\">\n                            Zone 1 (Poblacion)\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-2-3-1-4\" data-name=\"work setup detail field container\">\n                        <p class=\"mb-0.5 text-[11px] leading-4 text-[#aea69c]\" data-kid=\"1-2-2-3-1-4-1\" data-name=\"work setup field label\">\n                            Work setup\n                        </p>\n                        <p class=\"m-0 text-[13px] leading-5 text-[#c9c0ad]\" data-kid=\"1-2-2-3-1-4-2\" data-name=\"work setup value text\">\n                            Not specified\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mb-0 mt-3 flex items-start gap-2 border-t border-[#3f3a36] pt-2.5 text-[13px] leading-5 text-[#c9c0ad]\" data-kid=\"1-2-2-3-2\" data-name=\"walk location detail row\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin mt-0.5 shrink-0 text-[15px]\" data-kid=\"1-2-2-3-2-1\" data-name=\"map pin icon\">\n                    </i>\n                    Walk from Public Market\n                </p>\n            </section>\n            <section class=\"mt-5\" data-kid=\"1-2-2-4\" data-name=\"requirements section\">\n                <h2 class=\"mb-2 text-[16px] font-medium leading-6 tracking-[-0.2px] text-[#f7f5f0]\" data-kid=\"1-2-2-4-1\" data-name=\"requirements section heading\">\n                    What you’ll need to apply\n                </h2>\n                <ul class=\"m-0 list-none space-y-2 p-0 text-[13px] leading-[19px] text-[#dad2c1]\" data-kid=\"1-2-2-4-2\" data-name=\"requirements bullet list\">\n                    <li class=\"flex gap-2.5\" data-kid=\"1-2-2-4-2-1\" data-name=\"requirement list item\">\n                        <span class=\"mt-[7px] h-1 w-1 shrink-0 rounded-full bg-[#aea69c]\" data-kid=\"1-2-2-4-2-1-1\" data-name=\"requirement bullet dot\">\n                        </span>\n                        <span data-kid=\"1-2-2-4-2-1-2\" data-name=\"requirement requirement text\">\n                            Resident of Digos City, preferably near Zone 1 (Poblacion).\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2.5\" data-kid=\"1-2-2-4-2-2\" data-name=\"requirement list item\">\n                        <span class=\"mt-[7px] h-1 w-1 shrink-0 rounded-full bg-[#aea69c]\" data-kid=\"1-2-2-4-2-2-1\" data-name=\"requirement bullet dot\">\n                        </span>\n                        <span data-kid=\"1-2-2-4-2-2-2\" data-name=\"requirement requirement text\">\n                            At least 6 months of experience in a related field.\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2.5\" data-kid=\"1-2-2-4-2-3\" data-name=\"requirement list item\">\n                        <span class=\"mt-[7px] h-1 w-1 shrink-0 rounded-full bg-[#aea69c]\" data-kid=\"1-2-2-4-2-3-1\" data-name=\"requirement bullet dot\">\n                        </span>\n                        <span data-kid=\"1-2-2-4-2-3-2\" data-name=\"requirement requirement text\">\n                            Strong communication skills and a customer-first attitude.\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2.5\" data-kid=\"1-2-2-4-2-4\" data-name=\"requirement list item\">\n                        <span class=\"mt-[7px] h-1 w-1 shrink-0 rounded-full bg-[#aea69c]\" data-kid=\"1-2-2-4-2-4-1\" data-name=\"requirement bullet dot\">\n                        </span>\n                        <span data-kid=\"1-2-2-4-2-4-2\" data-name=\"requirement requirement text\">\n                            Available to start immediately.\n                        </span>\n                    </li>\n                </ul>\n            </section>\n            <section class=\"mt-5 border-t border-[#3f3a36] pt-4\" data-kid=\"1-2-2-5\" data-name=\"about role section\">\n                <h2 class=\"mb-1.5 text-[16px] font-medium leading-6 tracking-[-0.2px] text-[#f7f5f0]\" data-kid=\"1-2-2-5-1\" data-name=\"about role section heading\">\n                    About the role\n                </h2>\n                <p class=\"m-0 text-[13px] leading-5 text-[#c9c0ad]\" data-kid=\"1-2-2-5-2\" data-name=\"about role description text\">\n                    Support daily store operations, customer service, and local inventory. The employer is looking for someone who lives nearby and can commit to the standard operating hours.\n                </p>\n            </section>\n        </article>\n    </main>\n    <footer class=\"fixed inset-x-0 bottom-0 z-20 border-t border-[#3f3a36] bg-[#2b2622] px-5 pb-3 pt-2.5\" data-kid=\"1-3\" data-name=\"fixed bottom footer action bar\">\n        <div class=\"mx-auto max-w-[720px]\" data-kid=\"1-3-1\" data-name=\"footer action bar inner container\">\n            <a class=\"flex min-h-11 w-full items-center justify-center gap-2 rounded-[3px] bg-[#f7f5f0] px-4 text-[14px] font-medium text-[#2b2622] no-underline\" data-kid=\"1-3-1-1\" data-name=\"primary apply call-to-action button\" href=\"#apply\">\n                Apply for Store Manager\n                <i aria-hidden=\"true\" class=\"icon-arrow-right text-[16px]\" data-kid=\"1-3-1-1-1\" data-name=\"right arrow icon\">\n                </i>\n            </a>\n            <p class=\"mb-0 mt-1.5 text-center text-[11px] leading-4 text-[#aea69c]\" data-kid=\"1-3-1-2\" data-name=\"footer apply instruction text\">\n                Use the Digos Talent Form. A résumé is optional.\n            </p>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-11T13:23:17.077297+00:00",
      "modified": "2026-10-11T13:24:08.026922+00:00",
      "id": "var_50740b48f4a5",
      "contentHeight": 1000
    },
    "var_7a4e471d25ae": {
      "type": "variant",
      "label": "C · Find a job",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 15330,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<div class=\"djb-site min-h-screen bg-[#2b2622] text-[#f7f5f0] antialiased\" data-kid=\"1\" data-name=\"page layout wrapper with dark theme\" style=\"font-family:Inter,system-ui,sans-serif\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n    .djb-site { min-height:100vh; font-family:Inter,system-ui,sans-serif; }\n    .djb-wrap { width:min(1120px, calc(100% - 64px)); margin-inline:auto; }\n    .djb-header { height:68px; border-bottom:1px solid #3f3a36; display:flex; align-items:center; }\n    .djb-nav { display:flex; align-items:center; gap:34px; }\n    .djb-nav a { color:#c9c0ad; font-size:14px; text-decoration:none; transition:color 160ms ease; }\n    .djb-nav a:hover,.djb-nav a:focus-visible { color:#f7f5f0; }\n    .djb-nav a[aria-current=\"page\"] { color:#f7f5f0; }\n    .djb-logo { display:flex; gap:11px; align-items:center; color:#f7f5f0; text-decoration:none; font-weight:500; font-size:15px; letter-spacing:-.02em; }\n    .djb-mark { width:28px; height:28px; display:grid; place-items:center; border:1px solid #aea69c; border-radius:4px; font-size:13px; font-weight:500; }\n    .djb-content { padding-top:54px; padding-bottom:64px; }\n    .djb-intro { max-width:670px; }\n    .djb-intro h1 { margin:0; color:#f7f5f0; font-size:48px; line-height:1.08; letter-spacing:-1.3px; font-weight:400; }\n    .djb-intro p { color:#c9c0ad; font-size:16px; line-height:1.65; margin:15px 0 0; max-width:560px; }\n    .djb-search { margin-top:30px; background:#383330; border:1px solid #3f3a36; border-radius:5px; padding:18px; display:grid; grid-template-columns:minmax(200px,1.15fr) minmax(180px,.85fr) auto; align-items:end; gap:14px; }\n    .djb-field label { display:block; color:#dad2c1; font-size:13px; font-weight:500; margin:0 0 7px; }\n    .djb-input { display:flex; align-items:center; gap:9px; height:43px; padding:0 12px; border:1px solid #514b46; border-radius:3px; background:#2b2622; color:#f7f5f0; }\n    .djb-input i { color:#aea69c; font-size:15px; }\n    .djb-input span { color:#aea69c; font-size:14px; }\n    .djb-input strong { color:#f7f5f0; font-size:14px; font-weight:400; }\n    .djb-search-btn { height:43px; padding:0 19px; border:1px solid #f7f5f0; border-radius:3px; background:#f7f5f0; color:#2b2622; font:500 14px Inter,system-ui,sans-serif; white-space:nowrap; cursor:pointer; }\n    .djb-section-head { margin-top:44px; padding-bottom:14px; border-bottom:1px solid #3f3a36; display:flex; align-items:flex-end; justify-content:space-between; gap:20px; }\n    .djb-section-head h2 { margin:0; font-size:21px; line-height:1.3; font-weight:500; letter-spacing:-.35px; }\n    .djb-text-link { color:#dad2c1; font-size:14px; text-decoration:underline; text-underline-offset:4px; text-decoration-color:#6d655d; }\n    .djb-text-link:hover,.djb-text-link:focus-visible { color:#f7f5f0; }\n    .djb-job { border-bottom:1px solid #3f3a36; padding:18px 2px 17px; display:grid; grid-template-columns:minmax(250px,1.25fr) minmax(190px,.8fr) minmax(220px,.9fr) 112px; align-items:center; column-gap:22px; text-decoration:none; color:inherit; }\n    .djb-job:hover .djb-title,.djb-job:focus-visible .djb-title { text-decoration:underline; text-underline-offset:4px; }\n    .djb-title { color:#f7f5f0; font-size:16px; line-height:1.4; font-weight:500; }\n    .djb-company { color:#dad2c1; font-size:14px; margin-top:3px; }\n    .djb-fact { display:flex; align-items:center; gap:8px; color:#c9c0ad; font-size:13px; line-height:1.5; }\n    .djb-fact i { flex:none; font-size:14px; color:#aea69c; }\n    .djb-pay { text-align:right; color:#f7f5f0; font:500 14px 'DM Mono',monospace; white-space:nowrap; }\n    .djb-meta { margin-top:6px; color:#aea69c; font-size:12px; }\n    .djb-proof { margin-top:28px; padding-top:17px; border-top:1px solid #3f3a36; display:flex; align-items:flex-start; gap:10px; color:#aea69c; font-size:13px; line-height:1.6; max-width:840px; }\n    .djb-proof i { color:#dad2c1; font-size:15px; margin-top:2px; }\n    .djb-footer { margin-top:55px; border-top:1px solid #3f3a36; padding-top:18px; display:flex; justify-content:space-between; gap:16px; color:#aea69c; font-size:12px; }\n    .djb-footer a { color:#c9c0ad; text-decoration:none; }\n    .djb-footer a:hover,.djb-footer a:focus-visible { color:#f7f5f0; text-decoration:underline; }\n    @media(max-width:900px) {\n      .djb-wrap { width:min(100% - 40px, 720px); }\n      .djb-job { grid-template-columns:minmax(210px,1.1fr) minmax(150px,.8fr) minmax(180px,.9fr); row-gap:10px; }\n      .djb-pay { grid-column:2; text-align:left; }\n      .djb-meta { display:inline; margin-left:5px; }\n    }\n    @media(max-width:620px) {\n      .djb-wrap { width:calc(100% - 36px); }\n      .djb-header { height:60px; }\n      .djb-nav { gap:16px; }\n      .djb-nav a { font-size:12px; }\n      .djb-logo { font-size:14px; gap:8px; }\n      .djb-mark { width:26px; height:26px; }\n      .djb-content { padding-top:36px; padding-bottom:40px; }\n      .djb-intro h1 { font-size:35px; line-height:1.1; letter-spacing:-.9px; }\n      .djb-intro p { margin-top:12px; font-size:15px; }\n      .djb-search { margin-top:22px; padding:14px; grid-template-columns:1fr; gap:12px; }\n      .djb-search-btn { width:100%; }\n      .djb-section-head { margin-top:34px; align-items:center; }\n      .djb-section-head h2 { font-size:19px; }\n      .djb-job { grid-template-columns:1fr auto; column-gap:12px; row-gap:7px; padding:16px 0; }\n      .djb-job-main { grid-column:1 / -1; }\n      .djb-fact { font-size:12px; }\n      .djb-job .djb-fact:nth-child(3) { grid-column:1; }\n      .djb-pay { grid-column:2; grid-row:2; text-align:right; font-size:12px; }\n      .djb-meta { display:block; margin-left:0; }\n      .djb-footer { flex-direction:column; margin-top:38px; }\n    }\n    </style>\n    <header class=\"djb-header\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"djb-wrap flex items-center justify-between gap-8\" data-kid=\"1-1-1\" data-name=\"header inner layout container\">\n            <a aria-label=\"DigosJobs home\" class=\"djb-logo\" data-kid=\"1-1-1-1\" data-name=\"site logo link with D mark\" href=\"/\">\n                <span class=\"djb-mark\" data-kid=\"1-1-1-1-1\" data-name=\"logo square mark with letter D\">\n                    D\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"logo site name text\">\n                    DigosJobs\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"djb-nav\" data-kid=\"1-1-1-2\" data-name=\"main site navigation links\">\n                <a aria-current=\"page\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link Jobs (current page)\" href=\"/jobs\">\n                    Jobs\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"navigation link Applications\" href=\"/applicant\">\n                    Applications\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"navigation link Employer\" href=\"/employer\">\n                    Employer\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"djb-wrap djb-content\" data-kid=\"1-2\" data-name=\"main content container\">\n        <section aria-labelledby=\"page-title\" class=\"djb-intro\" data-kid=\"1-2-1\" data-name=\"intro heading section\">\n            <h1 data-kid=\"1-2-1-1\" data-name=\"hero headline text\" id=\"page-title\">\n                Find a job in Digos City.\n            </h1>\n            <p data-kid=\"1-2-1-2\" data-name=\"hero description paragraph\">\n                Browse local openings by role, pay, and area. See the details that help you decide before you apply.\n            </p>\n        </section>\n        <form action=\"/jobs\" class=\"djb-search\" data-kid=\"1-2-2\" data-name=\"job search form\" method=\"get\">\n            <div class=\"djb-field\" data-kid=\"1-2-2-1\" data-name=\"role keyword search field\">\n                <label data-kid=\"1-2-2-1-1\" data-name=\"role keyword field label\" for=\"role-search\">\n                    Role or keyword\n                </label>\n                <div class=\"djb-input\" data-kid=\"1-2-2-1-2\" data-name=\"field input container with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-search\" data-kid=\"1-2-2-1-2-1\" data-name=\"search magnifying glass icon\">\n                    </i>\n                    <input class=\"min-w-0 w-full bg-transparent text-[14px] text-[#f7f5f0] placeholder:text-[#aea69c] outline-hidden\" data-kid=\"1-2-2-1-2-2\" data-name=\"role keyword search input\" id=\"role-search\" name=\"q\" placeholder=\"e.g. Barista\" type=\"search\"/>\n                </div>\n            </div>\n            <div class=\"djb-field\" data-kid=\"1-2-2-2\" data-name=\"barangay area filter field\">\n                <label data-kid=\"1-2-2-2-1\" data-name=\"barangay area field label\" for=\"area-search\">\n                    Barangay or area\n                </label>\n                <div class=\"djb-input\" data-kid=\"1-2-2-2-2\" data-name=\"dropdown input container with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-2-2-2-1\" data-name=\"map pin dropdown icon\">\n                    </i>\n                    <select class=\"min-w-0 w-full appearance-none bg-transparent text-[14px] text-[#f7f5f0] outline-hidden\" data-kid=\"1-2-2-2-2-2\" data-name=\"area select dropdown\" id=\"area-search\" name=\"area\">\n                        <option class=\"bg-[#383330]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"All areas option\">\n                            All areas\n                        </option>\n                        <option class=\"bg-[#383330]\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"Zone 1 Poblacion option\">\n                            Zone 1 (Poblacion)\n                        </option>\n                        <option class=\"bg-[#383330]\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"Tres de Mayo option\">\n                            Tres de Mayo\n                        </option>\n                        <option class=\"bg-[#383330]\" data-kid=\"1-2-2-2-2-2-4\" data-name=\"Matti Area option\">\n                            Matti Area\n                        </option>\n                        <option class=\"bg-[#383330]\" data-kid=\"1-2-2-2-2-2-5\" data-name=\"Cogon option\">\n                            Cogon\n                        </option>\n                    </select>\n                </div>\n            </div>\n            <button class=\"djb-search-btn\" data-kid=\"1-2-2-3\" data-name=\"search submit button\" type=\"submit\">\n                Search jobs\n            </button>\n        </form>\n        <section aria-labelledby=\"open-roles-title\" data-kid=\"1-2-3\" data-name=\"open positions section\">\n            <div class=\"djb-section-head\" data-kid=\"1-2-3-1\" data-name=\"section heading row\">\n                <h2 data-kid=\"1-2-3-1-1\" data-name=\"section heading text\" id=\"open-roles-title\">\n                    Open positions\n                </h2>\n                <a class=\"djb-text-link\" data-kid=\"1-2-3-1-2\" data-name=\"see all jobs link with arrow\" href=\"/jobs\">\n                    See all jobs\n                    <span aria-hidden=\"true\" data-kid=\"1-2-3-1-2-1\" data-name=\"right arrow icon\">\n                        →\n                    </span>\n                </a>\n            </div>\n            <a class=\"djb-job\" data-kid=\"1-2-3-2\" data-name=\"job listing link row\" href=\"/jobs?jobId=1\">\n                <div class=\"djb-job-main\" data-kid=\"1-2-3-2-1\" data-name=\"job title and company container\">\n                    <div class=\"djb-title\" data-kid=\"1-2-3-2-1-1\" data-name=\"job title Store Manager\">\n                        Store Manager\n                    </div>\n                    <div class=\"djb-company\" data-kid=\"1-2-3-2-1-2\" data-name=\"company name Digos Central Mall\">\n                        Digos Central Mall\n                    </div>\n                </div>\n                <div class=\"djb-fact\" data-kid=\"1-2-3-2-2\" data-name=\"job location fact with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-3-2-2-1\" data-name=\"map pin location icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-2-2-2\" data-name=\"location text Zone 1 Poblacion\">\n                        Zone 1 (Poblacion)\n                    </span>\n                </div>\n                <div class=\"djb-fact\" data-kid=\"1-2-3-2-3\" data-name=\"job commute fact with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-bus-front\" data-kid=\"1-2-3-2-3-1\" data-name=\"bus front commuting icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-2-3-2\" data-name=\"commute text Walk from Public Market\">\n                        Walk from Public Market\n                    </span>\n                </div>\n                <div class=\"djb-pay\" data-kid=\"1-2-3-2-4\" data-name=\"job pay display\">\n                    ₱15k–₱20k\n                    <span class=\"djb-meta\" data-kid=\"1-2-3-2-4-1\" data-name=\"pay period metadata / mo\">\n                        / mo\n                    </span>\n                </div>\n            </a>\n            <a class=\"djb-job\" data-kid=\"1-2-3-3\" data-name=\"job listing link row\" href=\"/jobs?jobId=2\">\n                <div class=\"djb-job-main\" data-kid=\"1-2-3-3-1\" data-name=\"job title and company container\">\n                    <div class=\"djb-title\" data-kid=\"1-2-3-3-1-1\" data-name=\"job title Barista\">\n                        Barista\n                    </div>\n                    <div class=\"djb-company\" data-kid=\"1-2-3-3-1-2\" data-name=\"company name Kapehan sa Digos\">\n                        Kapehan sa Digos\n                    </div>\n                </div>\n                <div class=\"djb-fact\" data-kid=\"1-2-3-3-2\" data-name=\"job location fact with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-3-3-2-1\" data-name=\"map pin location icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-3-2-2\" data-name=\"location text Tres de Mayo\">\n                        Tres de Mayo\n                    </span>\n                </div>\n                <div class=\"djb-fact\" data-kid=\"1-2-3-3-3\" data-name=\"job commute fact with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-bus-front\" data-kid=\"1-2-3-3-3-1\" data-name=\"bus front commuting icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-3-3-2\" data-name=\"commute text 1 trike ride from Gaisano\">\n                        1 trike ride from Gaisano\n                    </span>\n                </div>\n                <div class=\"djb-pay\" data-kid=\"1-2-3-3-4\" data-name=\"job pay display\">\n                    ₱400\n                    <span class=\"djb-meta\" data-kid=\"1-2-3-3-4-1\" data-name=\"pay period metadata / day\">\n                        / day\n                    </span>\n                </div>\n            </a>\n            <a class=\"djb-job\" data-kid=\"1-2-3-4\" data-name=\"job listing link row\" href=\"/jobs?jobId=3\">\n                <div class=\"djb-job-main\" data-kid=\"1-2-3-4-1\" data-name=\"job title and company container\">\n                    <div class=\"djb-title\" data-kid=\"1-2-3-4-1-1\" data-name=\"job title Customer Service\">\n                        Customer Service\n                    </div>\n                    <div class=\"djb-company\" data-kid=\"1-2-3-4-1-2\" data-name=\"company name Local Telco Branch\">\n                        Local Telco Branch\n                    </div>\n                </div>\n                <div class=\"djb-fact\" data-kid=\"1-2-3-4-2\" data-name=\"job location fact with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-3-4-2-1\" data-name=\"map pin location icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-4-2-2\" data-name=\"location text Matti Area\">\n                        Matti Area\n                    </span>\n                </div>\n                <div class=\"djb-fact\" data-kid=\"1-2-3-4-3\" data-name=\"job landmark fact with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-map\" data-kid=\"1-2-3-4-3-1\" data-name=\"map landmark icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-4-3-2\" data-name=\"landmark text Near Capitol\">\n                        Near Capitol\n                    </span>\n                </div>\n                <div class=\"djb-pay\" data-kid=\"1-2-3-4-4\" data-name=\"job pay display\">\n                    ₱14k\n                    <span class=\"djb-meta\" data-kid=\"1-2-3-4-4-1\" data-name=\"pay period metadata / mo\">\n                        / mo\n                    </span>\n                </div>\n            </a>\n            <a class=\"djb-job\" data-kid=\"1-2-3-5\" data-name=\"job listing link row\" href=\"/jobs?jobId=4\">\n                <div class=\"djb-job-main\" data-kid=\"1-2-3-5-1\" data-name=\"job title and company container\">\n                    <div class=\"djb-title\" data-kid=\"1-2-3-5-1-1\" data-name=\"job title Delivery Rider\">\n                        Delivery Rider\n                    </div>\n                    <div class=\"djb-company\" data-kid=\"1-2-3-5-1-2\" data-name=\"company name QuickDeliver\">\n                        QuickDeliver\n                    </div>\n                </div>\n                <div class=\"djb-fact\" data-kid=\"1-2-3-5-2\" data-name=\"job location fact with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-3-5-2-1\" data-name=\"map pin location icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-5-2-2\" data-name=\"location text Cogon\">\n                        Cogon\n                    </span>\n                </div>\n                <div class=\"djb-fact\" data-kid=\"1-2-3-5-3\" data-name=\"job requirement fact with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-bike\" data-kid=\"1-2-3-5-3-1\" data-name=\"bike requirement icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-5-3-2\" data-name=\"requirement text Has own motorcycle\">\n                        Has own motorcycle\n                    </span>\n                </div>\n                <div class=\"djb-pay\" data-kid=\"1-2-3-5-4\" data-name=\"job pay display\">\n                    ₱12k\n                    <span class=\"djb-meta\" data-kid=\"1-2-3-5-4-1\" data-name=\"pay period metadata + tips\">\n                        + tips\n                    </span>\n                </div>\n            </a>\n        </section>\n        <p class=\"djb-proof\" data-kid=\"1-2-4\" data-name=\"verified employer trust note\">\n            <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-4-1\" data-name=\"shield check trust icon\">\n            </i>\n            <span data-kid=\"1-2-4-2\" data-name=\"trust note explanation text\">\n                A “Verified employer” label means DTI or Mayor’s Permit documents were reviewed. Jobs from employers without that label are still open to browse.\n            </span>\n        </p>\n        <footer class=\"djb-footer\" data-kid=\"1-2-5\" data-name=\"page footer bar\">\n            <span data-kid=\"1-2-5-1\" data-name=\"footer tagline text\">\n                Digos City job board\n            </span>\n            <span data-kid=\"1-2-5-2\" data-name=\"footer quick links container\">\n                <a data-kid=\"1-2-5-2-1\" data-name=\"footer link Already applied\" href=\"/applicant\">\n                    Already applied?\n                </a>\n                ·\n                <a data-kid=\"1-2-5-2-2\" data-name=\"footer link Posting a job\" href=\"/employer\">\n                    Posting a job?\n                </a>\n            </span>\n        </footer>\n    </main>\n</div>\n",
