      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.bulletin { min-height:100vh; background:#2b2622; color:#f7f5f0; font-family:Inter,system-ui,sans-serif; -webkit-font-smoothing:antialiased; }\n.bulletin * { box-sizing:border-box; }\n.bulletin a { color:inherit; text-decoration:none; }\n.bulletin button,.bulletin input,.bulletin select { font:inherit; }\n.b-shell { max-width:1400px; margin:0 auto; padding:0 38px; }\n.b-nav { height:68px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #3f3a36; }\n.b-brand { display:flex; align-items:center; gap:11px; color:#f7f5f0; font-size:15px; font-weight:600; letter-spacing:-.25px; }\n.b-mark { width:27px; height:27px; border:1px solid #aea69c; border-radius:3px; display:grid; place-items:center; font-size:12px; font-weight:500; }\n.b-navlinks { display:flex; align-items:center; gap:30px; height:100%; margin-left:46px; flex:1; }\n.b-navlink { height:100%; display:flex; align-items:center; color:#c9c0ad!important; font-size:13px; font-weight:500; border-bottom:1px solid transparent; }\n.b-navlink.active { color:#f7f5f0!important; border-bottom-color:#f7f5f0; }\n.b-navright { display:flex; align-items:center; gap:22px; color:#c9c0ad; font-size:13px; }\n.b-navright a:hover,.b-navlink:hover { color:#f7f5f0!important; }\n.b-navright .employer-link { color:#f7f5f0; }\n.b-mobile-nav { display:none; }\n.b-page-head { padding:37px 0 25px; display:flex; align-items:flex-end; justify-content:space-between; gap:32px; }\n.b-title { margin:0; font-size:32px; line-height:1.18; font-weight:500; letter-spacing:-1.05px; }\n.b-intro { margin:9px 0 0; max-width:570px; color:#c9c0ad; font-size:14px; line-height:1.6; }\n.b-head-note { max-width:300px; padding:0 0 2px 15px; border-left:1px solid #3f3a36; color:#aea69c; font-size:12px; line-height:1.6; }\n.b-search { display:grid; grid-template-columns:minmax(250px,1.5fr) minmax(190px,.8fr) minmax(175px,.72fr) auto; gap:10px; align-items:end; padding:15px 0 20px; border-top:1px solid #3f3a36; border-bottom:1px solid #3f3a36; }\n.b-field label { display:block; margin:0 0 7px; color:#c9c0ad; font-size:12px; font-weight:500; }\n.b-input-wrap { height:42px; display:flex; align-items:center; gap:9px; padding:0 12px; border:1px solid #3f3a36; border-radius:3px; background:#383330; color:#aea69c; }\n.b-input-wrap i { flex:none; font-size:15px; }\n.b-input-wrap input,.b-input-wrap select { min-width:0; width:100%; border:0; outline:none; background:transparent; color:#f7f5f0; font-size:13px; }\n.b-input-wrap input::placeholder { color:#aea69c; opacity:1; }\n.b-input-wrap select { appearance:none; cursor:pointer; }\n.b-input-wrap select option { color:#f7f5f0; background:#383330; }\n.b-search-button { height:42px; padding:0 18px; border:1px solid #f7f5f0; border-radius:3px; color:#2b2622; background:#f7f5f0; font-size:13px; font-weight:500; white-space:nowrap; cursor:pointer; }\n.b-search-button:hover { background:#dad2c1; }\n.b-search-button:focus-visible,.b-input-wrap:focus-within,.b-filter:focus-visible,.b-job:focus-visible,.b-action:focus-visible,.b-ghost:focus-visible { outline:2px solid #f7f5f0; outline-offset:3px; }\n.b-filterline { display:flex; align-items:center; justify-content:space-between; padding:15px 0 12px; gap:18px; }\n.b-filters { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }\n.b-filter { height:33px; padding:0 11px; border:1px solid #3f3a36; border-radius:3px; color:#c9c0ad; background:transparent; font-size:12px; cursor:pointer; }\n.b-filter.active { color:#f7f5f0; background:#383330; border-color:#aea69c; }\n.b-match-label { font-size:12px; color:#aea69c; white-space:nowrap; }\n.b-workspace { display:grid; grid-template-columns:420px minmax(0,1fr); min-height:665px; border-top:1px solid #3f3a36; border-bottom:1px solid #3f3a36; }\n.b-results { border-right:1px solid #3f3a36; padding:17px 18px 22px 0; }\n.b-group { margin-bottom:21px; }\n.b-group-title { display:flex; align-items:center; justify-content:space-between; padding:0 4px 8px 2px; margin-bottom:2px; color:#aea69c; font-size:11px; font-weight:500; letter-spacing:.02em; text-transform:uppercase; }\n.b-group-title span:last-child { font-family:'DM Mono',monospace; font-size:11px; font-weight:400; }\n.b-job { display:block; width:100%; padding:12px 12px 13px; border:0; border-bottom:1px solid #3f3a36; border-radius:0; background:transparent; color:#f7f5f0; text-align:left; cursor:pointer; }\n.b-job.selected { background:#383330; }\n.b-job:hover:not(.selected) { background:rgba(56,51,48,.55); }\n.b-job-top { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; }\n.b-job-title { margin:0; font-size:14px; line-height:1.4; font-weight:500; }\n.b-company { margin:3px 0 0; color:#c9c0ad; font-size:12px; }\n.b-job-kind { flex:none; color:#aea69c; font-size:11px; padding-top:2px; }\n.b-job-bottom { display:flex; justify-content:space-between; align-items:flex-end; gap:10px; margin-top:11px; }\n.b-pay { color:#f7f5f0; font-family:'DM Mono',monospace; font-size:13px; line-height:1.4; }\n.b-job-place { display:flex; align-items:center; gap:5px; color:#c9c0ad; font-size:11px; line-height:1.4; text-align:right; }\n.b-job-place i { font-size:13px; }\n.b-job-note { margin-top:7px; color:#aea69c; font-size:11px; line-height:1.45; }\n.b-status { display:inline-flex; align-items:center; gap:5px; color:#dad2c1; font-size:10px; white-space:nowrap; }\n.b-status i { font-size:12px; }\n.b-details { min-width:0; padding:23px 0 0 32px; display:flex; flex-direction:column; }\n.b-detail-overline { display:flex; align-items:center; gap:8px; margin:0 0 9px; color:#aea69c; font-size:11px; }\n.b-detail-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; padding:0 2px 18px 0; border-bottom:1px solid #3f3a36; }\n.b-detail-title { margin:0; color:#f7f5f0; font-size:27px; line-height:1.2; font-weight:500; letter-spacing:-.7px; }\n.b-detail-company { margin:6px 0 0; color:#c9c0ad; font-size:14px; }\n.b-employer-status { display:inline-flex; align-items:center; gap:6px; margin-top:10px; color:#dad2c1; font-size:11px; }\n.b-employer-status i { font-size:14px; }\n.b-apply-top { min-height:38px; padding:0 14px; border-radius:3px; border:1px solid #f7f5f0; background:#f7f5f0; color:#2b2622; font-size:12px; font-weight:500; white-space:nowrap; cursor:pointer; }\n.b-apply-top:hover { background:#dad2c1; }\n.b-fact-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-bottom:1px solid #3f3a36; }\n.b-fact { padding:13px 13px 13px 0; border-right:1px solid #3f3a36; min-width:0; }\n.b-fact + .b-fact { padding-left:14px; }\n.b-fact:last-child { border-right:0; }\n.b-fact-label { margin:0 0 6px; color:#aea69c; font-size:10px; text-transform:uppercase; letter-spacing:.035em; }\n.b-fact-value { margin:0; color:#f7f5f0; font-size:12px; line-height:1.45; font-weight:500; }\n.b-fact-value.mono { font-family:'DM Mono',monospace; font-size:13px; }\n.b-detail-columns { display:grid; grid-template-columns:minmax(0,1.12fr) minmax(260px,.88fr); gap:36px; padding:20px 25px 28px 0; }\n.b-section h3 { margin:0 0 10px; color:#f7f5f0; font-size:14px; line-height:1.4; font-weight:500; }\n.b-section p { margin:0; color:#c9c0ad; font-size:12px; line-height:1.7; max-width:610px; }\n.b-requirements { list-style:none; margin:0; padding:0; }\n.b-requirements li { position:relative; padding:0 0 8px 16px; color:#dad2c1; font-size:12px; line-height:1.5; }\n.b-requirements li:before { content:''; position:absolute; width:4px; height:4px; border-radius:50%; background:#aea69c; left:2px; top:7px; }\n.b-verify-note { margin-top:11px!important; padding-top:10px; border-top:1px solid #3f3a36; color:#aea69c!important; font-size:11px!important; }\n.b-detail-spacer { flex:1; min-height:20px; }\n.b-bottom { position:sticky; bottom:0; display:flex; align-items:center; justify-content:space-between; gap:18px; min-height:61px; padding:10px 0 10px 14px; border-top:1px solid #3f3a36; background:#2b2622; }\n.b-bottom-copy { color:#aea69c; font-size:11px; line-height:1.45; }\n.b-bottom-actions { display:flex; align-items:center; gap:15px; }\n.b-ghost { padding:9px 0; border:0; background:transparent; color:#c9c0ad; font-size:12px; text-decoration:underline; text-underline-offset:3px; cursor:pointer; }\n.b-action { min-height:39px; padding:0 16px; border:1px solid #f7f5f0; border-radius:3px; background:#f7f5f0; color:#2b2622; font-size:12px; font-weight:500; cursor:pointer; }\n.b-action:hover { background:#dad2c1; }\n.b-mobile-back { display:none; }\n.b-disclaimer { margin:13px 0 0; color:#aea69c; font-size:10px; line-height:1.5; }\n@media(max-width:1000px){ .b-shell{padding:0 24px}.b-workspace{grid-template-columns:360px minmax(0,1fr)}.b-details{padding-left:22px}.b-fact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.b-fact:nth-child(2){border-right:0}.b-fact:nth-child(n+3){border-top:1px solid #3f3a36}.b-fact:nth-child(3){padding-left:0}.b-detail-columns{gap:20px}.b-head-note{display:none} }\n@media(max-width:720px){.b-shell{padding:0 18px}.b-nav{height:58px}.b-navlinks,.b-navright{display:none}.b-mobile-nav{display:flex;align-items:center;gap:7px;color:#c9c0ad;font-size:12px}.b-mobile-nav i{font-size:16px}.b-page-head{padding:26px 0 18px;align-items:flex-start}.b-title{font-size:27px}.b-intro{font-size:13px}.b-search{grid-template-columns:1fr 1fr;gap:11px}.b-field:first-child{grid-column:1/-1}.b-search-button{grid-column:1/-1;width:100%;height:44px}.b-filterline{align-items:flex-start}.b-filters{gap:6px}.b-filter{height:36px}.b-match-label{display:none}.b-workspace{display:block;border-top:0}.b-results{display:none}.b-details{padding:0;border-top:1px solid #3f3a36}.b-mobile-back{display:inline-flex;align-items:center;gap:7px;padding:15px 0 17px;color:#c9c0ad;font-size:12px}.b-mobile-back i{font-size:14px}.b-detail-head{padding:0 0 15px;flex-direction:column;gap:14px}.b-detail-title{font-size:23px}.b-detail-company{font-size:13px}.b-apply-top{display:none}.b-fact-grid{grid-template-columns:1fr 1fr}.b-fact{padding:12px 9px 12px 0}.b-fact + .b-fact{padding-left:10px}.b-detail-columns{grid-template-columns:1fr;gap:19px;padding:18px 0 105px}.b-bottom{position:sticky;bottom:0;margin:0 -18px;padding:11px 18px;min-height:65px}.b-bottom-copy{max-width:165px}.b-bottom-actions{gap:0}.b-ghost{display:none}.b-action{width:100%;min-height:43px}.b-disclaimer{margin-top:10px} }\n@media(max-width:400px){.b-shell{padding-left:15px;padding-right:15px}.b-mobile-nav span{display:none}.b-filter{padding:0 8px;font-size:11px}.b-bottom{margin-left:-15px;margin-right:-15px;padding-left:15px;padding-right:15px}.b-bottom-copy{max-width:135px;font-size:10px}.b-fact-value{font-size:11px} }\n</style>\n<div class=\"bulletin\" data-kid=\"1\" data-name=\"bulletin page root container\">\n    <div class=\"b-shell\" data-kid=\"1-1\" data-name=\"page shell with max-width layout\">\n        <header aria-label=\"DigosJobs navigation\" class=\"b-nav\" data-kid=\"1-1-1\" data-name=\"top navigation header with brand and links\">\n            <a class=\"b-brand\" data-kid=\"1-1-1-1\" data-name=\"site brand with logomark and name\" href=\"#\">\n                <span class=\"b-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logomark tile\">\n                    D\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"site brand name\">\n                    DigosJobs\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"b-navlinks\" data-kid=\"1-1-1-2\" data-name=\"primary navigation links\">\n                <a aria-current=\"page\" class=\"b-navlink active\" data-kid=\"1-1-1-2-1\" data-name=\"active navigation link to jobs page\" href=\"#jobs\">\n                    Jobs\n                </a>\n                <a class=\"b-navlink\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link to applications page\" href=\"#applications\">\n                    Applications\n                </a>\n            </nav>\n            <div class=\"b-navright\" data-kid=\"1-1-1-3\" data-name=\"right side of navigation with employer link and location\">\n                <a class=\"employer-link\" data-kid=\"1-1-1-3-1\" data-name=\"employer portal navigation link\" href=\"#employer\">\n                    Employer portal\n                </a>\n                <span aria-hidden=\"true\" data-kid=\"1-1-1-3-2\" data-name=\"location label\">\n                    Digos City\n                </span>\n            </div>\n            <a aria-label=\"Open navigation\" class=\"b-mobile-nav\" data-kid=\"1-1-1-4\" data-name=\"mobile menu navigation toggle\" href=\"#mobile-menu\">\n                <i class=\"icon-menu-2\" data-kid=\"1-1-1-4-1\" data-name=\"menu hamburger icon\">\n                </i>\n                <span data-kid=\"1-1-1-4-2\" data-name=\"mobile menu label\">\n                    Menu\n                </span>\n            </a>\n        </header>\n        <main data-kid=\"1-1-2\" data-name=\"main content container\" id=\"jobs\">\n            <section class=\"b-page-head\" data-kid=\"1-1-2-1\" data-name=\"page header section with title, intro, and employer note\">\n                <div data-kid=\"1-1-2-1-1\" data-name=\"page title and intro container\">\n                    <h1 class=\"b-title\" data-kid=\"1-1-2-1-1-1\" data-name=\"page headline text\">\n                        Jobs open in Digos City\n                    </h1>\n                    <p class=\"b-intro\" data-kid=\"1-1-2-1-1-2\" data-name=\"page intro paragraph\">\n                        Compare pay, job type, and location before you apply. Browse first—no account is needed to see vacancies.\n                    </p>\n                </div>\n                <p class=\"b-head-note\" data-kid=\"1-1-2-1-2\" data-name=\"employer verification note in header\">\n                    Employer verification is based on document review. Jobs without a reviewed status remain visible.\n                </p>\n            </section>\n            <form aria-label=\"Find a job\" class=\"b-search\" data-kid=\"1-1-2-2\" data-name=\"search form to filter jobs\">\n                <div class=\"b-field\" data-kid=\"1-1-2-2-1\" data-name=\"search field for role or employer\">\n                    <label data-kid=\"1-1-2-2-1-1\" data-name=\"search field label\" for=\"role-search\">\n                        Search by role or employer\n                    </label>\n                    <div class=\"b-input-wrap\" data-kid=\"1-1-2-2-1-2\" data-name=\"search input wrapper with icon\">\n                        <i aria-hidden=\"true\" class=\"icon-search\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"search icon\">\n                        </i>\n                        <input data-kid=\"1-1-2-2-1-2-2\" data-name=\"role or employer search input field\" id=\"role-search\" placeholder=\"e.g. Store Manager\" type=\"search\"/>\n                    </div>\n                </div>\n                <div class=\"b-field\" data-kid=\"1-1-2-2-2\" data-name=\"area search field\">\n                    <label data-kid=\"1-1-2-2-2-1\" data-name=\"area search field label\" for=\"area-search\">\n                        Barangay or area\n                    </label>\n                    <div class=\"b-input-wrap\" data-kid=\"1-1-2-2-2-2\" data-name=\"area select input wrapper\">\n                        <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"map pin icon\">\n                        </i>\n                        <select data-kid=\"1-1-2-2-2-2-2\" data-name=\"area select dropdown\" id=\"area-search\">\n                            <option data-kid=\"1-1-2-2-2-2-2-1\" data-name=\"option to show all of Digos City\">\n                                All of Digos City\n                            </option>\n                            <option data-kid=\"1-1-2-2-2-2-2-2\" data-name=\"option to filter by Zone 1 Poblacion\">\n                                Zone 1 (Poblacion)\n                            </option>\n                            <option data-kid=\"1-1-2-2-2-2-2-3\" data-name=\"option to filter by Tres de Mayo\">\n                                Tres de Mayo\n                            </option>\n                            <option data-kid=\"1-1-2-2-2-2-2-4\" data-name=\"option to filter by Matti Area\">\n                                Matti Area\n                            </option>\n                            <option data-kid=\"1-1-2-2-2-2-2-5\" data-name=\"option to filter by Cogon\">\n                                Cogon\n                            </option>\n                        </select>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down\" data-kid=\"1-1-2-2-2-2-3\" data-name=\"dropdown open indicator icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"b-field\" data-kid=\"1-1-2-2-3\" data-name=\"employment type search field\">\n                    <label data-kid=\"1-1-2-2-3-1\" data-name=\"employment type field label\" for=\"type-search\">\n                        Employment type\n                    </label>\n                    <div class=\"b-input-wrap\" data-kid=\"1-1-2-2-3-2\" data-name=\"employment type select input wrapper\">\n                        <select data-kid=\"1-1-2-2-3-2-1\" data-name=\"employment type select dropdown\" id=\"type-search\">\n                            <option data-kid=\"1-1-2-2-3-2-1-1\" data-name=\"option for all employment types\">\n                                All types\n                            </option>\n                            <option data-kid=\"1-1-2-2-3-2-1-2\" data-name=\"option for full-time employment\">\n                                Full-time\n                            </option>\n                            <option data-kid=\"1-1-2-2-3-2-1-3\" data-name=\"option for daily gig employment\">\n                                Daily Gig\n                            </option>\n                            <option data-kid=\"1-1-2-2-3-2-1-4\" data-name=\"option for contract employment\">\n                                Contract\n                            </option>\n                        </select>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down\" data-kid=\"1-1-2-2-3-2-2\" data-name=\"dropdown open indicator icon\">\n                        </i>\n                    </div>\n                </div>\n                <button class=\"b-search-button\" data-kid=\"1-1-2-2-4\" data-name=\"show jobs search submit button\" type=\"button\">\n                    Show jobs\n                </button>\n            </form>\n            <div class=\"b-filterline\" data-kid=\"1-1-2-3\" data-name=\"job filter row with filter chips and match label\">\n                <div aria-label=\"Job filters\" class=\"b-filters\" data-kid=\"1-1-2-3-1\" data-name=\"job filter chips row\">\n                    <button class=\"b-filter active\" data-kid=\"1-1-2-3-1-1\" data-name=\"All opportunities filter chip (selected)\" type=\"button\">\n                        All opportunities\n                    </button>\n                    <button class=\"b-filter\" data-kid=\"1-1-2-3-1-2\" data-name=\"Verified employers filter chip\" type=\"button\">\n                        Verified employers\n                    </button>\n                    <button class=\"b-filter\" data-kid=\"1-1-2-3-1-3\" data-name=\"Monthly pay filter chip\" type=\"button\">\n                        Monthly pay\n                    </button>\n                    <button class=\"b-filter\" data-kid=\"1-1-2-3-1-4\" data-name=\"Daily or contract filter chip\" type=\"button\">\n                        Daily or contract\n                    </button>\n                </div>\n                <span class=\"b-match-label\" data-kid=\"1-1-2-3-2\" data-name=\"match count label\">\n                    Select a job to see its details\n                </span>\n            </div>\n            <section aria-label=\"Job opportunities and selected job\" class=\"b-workspace\" data-kid=\"1-1-2-4\" data-name=\"job workspace grid (listings + details)\">\n                <aside aria-label=\"Job listings\" class=\"b-results\" data-kid=\"1-1-2-4-1\" data-name=\"job listings results panel\">\n                    <section aria-labelledby=\"monthly-heading\" class=\"b-group\" data-kid=\"1-1-2-4-1-1\" data-name=\"monthly roles job group\">\n                        <h2 class=\"b-group-title\" data-kid=\"1-1-2-4-1-1-1\" data-name=\"monthly roles group title bar\" id=\"monthly-heading\">\n                            <span data-kid=\"1-1-2-4-1-1-1-1\" data-name=\"monthly roles group label\">\n                                Monthly roles\n                            </span>\n                        </h2>\n                        <button aria-current=\"true\" class=\"b-job selected\" data-kid=\"1-1-2-4-1-1-2\" data-name=\"selected Store Manager job card\" type=\"button\">\n                            <div class=\"b-job-top\" data-kid=\"1-1-2-4-1-1-2-1\" data-name=\"job card header row (title + verification)\">\n                                <div data-kid=\"1-1-2-4-1-1-2-1-1\" data-name=\"job card title and employer container\">\n                                    <h3 class=\"b-job-title\" data-kid=\"1-1-2-4-1-1-2-1-1-1\" data-name=\"job card role title Store Manager\">\n                                        Store Manager\n                                    </h3>\n                                    <p class=\"b-company\" data-kid=\"1-1-2-4-1-1-2-1-1-2\" data-name=\"job card employer name Digos Central Mall\">\n                                        Digos Central Mall\n                                    </p>\n                                </div>\n                                <span class=\"b-status\" data-kid=\"1-1-2-4-1-1-2-1-2\" data-name=\"verified employer status badge\">\n                                    <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-1-2-4-1-1-2-1-2-1\" data-name=\"verified shield check icon\">\n                                    </i>\n                                    Documents reviewed\n                                </span>\n                            </div>\n                            <div class=\"b-job-bottom\" data-kid=\"1-1-2-4-1-1-2-2\" data-name=\"job card footer row (pay + location)\">\n                                <span class=\"b-pay\" data-kid=\"1-1-2-4-1-1-2-2-1\" data-name=\"job card pay range\">\n                                    ₱15k–₱20k / month\n                                </span>\n                                <span class=\"b-job-place\" data-kid=\"1-1-2-4-1-1-2-2-2\" data-name=\"job card location label\">\n                                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-1-2-4-1-1-2-2-2-1\" data-name=\"map pin icon for job location\">\n                                    </i>\n                                    Zone 1 (Poblacion)\n                                </span>\n                            </div>\n                            <p class=\"b-job-note\" data-kid=\"1-1-2-4-1-1-2-3\" data-name=\"job card note line with hours and walking distance\">\n                                Full-time · Walk from Public Market\n                            </p>\n                        </button>\n                        <button class=\"b-job\" data-kid=\"1-1-2-4-1-1-3\" data-name=\"Customer Service job card\" type=\"button\">\n                            <div class=\"b-job-top\" data-kid=\"1-1-2-4-1-1-3-1\" data-name=\"job card header row (title + verification)\">\n                                <div data-kid=\"1-1-2-4-1-1-3-1-1\" data-name=\"job card title and employer container\">\n                                    <h3 class=\"b-job-title\" data-kid=\"1-1-2-4-1-1-3-1-1-1\" data-name=\"job card role title Customer Service\">\n                                        Customer Service\n                                    </h3>\n                                    <p class=\"b-company\" data-kid=\"1-1-2-4-1-1-3-1-1-2\" data-name=\"job card employer name Local Telco Branch\">\n                                        Local Telco Branch\n                                    </p>\n                                </div>\n                                <span class=\"b-status\" data-kid=\"1-1-2-4-1-1-3-1-2\" data-name=\"verified employer status badge\">\n                                    <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-1-2-4-1-1-3-1-2-1\" data-name=\"verified shield check icon\">\n                                    </i>\n                                    Documents reviewed\n                                </span>\n                            </div>\n                            <div class=\"b-job-bottom\" data-kid=\"1-1-2-4-1-1-3-2\" data-name=\"job card footer row (pay + location)\">\n                                <span class=\"b-pay\" data-kid=\"1-1-2-4-1-1-3-2-1\" data-name=\"job card pay amount\">\n                                    ₱14k / month\n                                </span>\n                                <span class=\"b-job-place\" data-kid=\"1-1-2-4-1-1-3-2-2\" data-name=\"job card location label\">\n                                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-1-2-4-1-1-3-2-2-1\" data-name=\"map pin icon for job location\">\n                                    </i>\n                                    Matti Area\n                                </span>\n                            </div>\n                            <p class=\"b-job-note\" data-kid=\"1-1-2-4-1-1-3-3\" data-name=\"job card note line with hours and proximity\">\n                                Full-time · Near Capitol\n                            </p>\n                        </button>\n                    </section>\n                    <section aria-labelledby=\"daily-heading\" class=\"b-group\" data-kid=\"1-1-2-4-1-2\" data-name=\"daily or contract work job group\">\n                        <h2 class=\"b-group-title\" data-kid=\"1-1-2-4-1-2-1\" data-name=\"daily or contract group title bar\" id=\"daily-heading\">\n                            <span data-kid=\"1-1-2-4-1-2-1-1\" data-name=\"daily or contract group label\">\n                                Daily or contract work\n                            </span>\n                        </h2>\n                        <button class=\"b-job\" data-kid=\"1-1-2-4-1-2-2\" data-name=\"Barista daily gig job card\" type=\"button\">\n                            <div class=\"b-job-top\" data-kid=\"1-1-2-4-1-2-2-1\" data-name=\"job card header row (title + verification)\">\n                                <div data-kid=\"1-1-2-4-1-2-2-1-1\" data-name=\"job card title and employer container\">\n                                    <h3 class=\"b-job-title\" data-kid=\"1-1-2-4-1-2-2-1-1-1\" data-name=\"job card role title Barista\">\n                                        Barista\n                                    </h3>\n                                    <p class=\"b-company\" data-kid=\"1-1-2-4-1-2-2-1-1-2\" data-name=\"job card employer name Kapehan sa Digos\">\n                                        Kapehan sa Digos\n                                    </p>\n                                </div>\n                                <span class=\"b-status\" data-kid=\"1-1-2-4-1-2-2-1-2\" data-name=\"verified employer status badge\">\n                                    <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-1-2-4-1-2-2-1-2-1\" data-name=\"verified shield check icon\">\n                                    </i>\n                                    Documents reviewed\n                                </span>\n                            </div>\n                            <div class=\"b-job-bottom\" data-kid=\"1-1-2-4-1-2-2-2\" data-name=\"job card footer row (pay + location)\">\n                                <span class=\"b-pay\" data-kid=\"1-1-2-4-1-2-2-2-1\" data-name=\"job card daily pay amount\">\n                                    ₱400 / day\n                                </span>\n                                <span class=\"b-job-place\" data-kid=\"1-1-2-4-1-2-2-2-2\" data-name=\"job card location label\">\n                                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-1-2-4-1-2-2-2-2-1\" data-name=\"map pin icon for job location\">\n                                    </i>\n                                    Tres de Mayo\n                                </span>\n                            </div>\n                            <p class=\"b-job-note\" data-kid=\"1-1-2-4-1-2-2-3\" data-name=\"job card note line with gig type and travel\">\n                                Daily Gig · 1 trike ride from Gaisano\n                            </p>\n                        </button>\n                        <button class=\"b-job\" data-kid=\"1-1-2-4-1-2-3\" data-name=\"Delivery Rider contract job card\" type=\"button\">\n                            <div class=\"b-job-top\" data-kid=\"1-1-2-4-1-2-3-1\" data-name=\"job card header row (title + verification)\">\n                                <div data-kid=\"1-1-2-4-1-2-3-1-1\" data-name=\"job card title and employer container\">\n                                    <h3 class=\"b-job-title\" data-kid=\"1-1-2-4-1-2-3-1-1-1\" data-name=\"job card role title Delivery Rider\">\n                                        Delivery Rider\n                                    </h3>\n                                    <p class=\"b-company\" data-kid=\"1-1-2-4-1-2-3-1-1-2\" data-name=\"job card employer name QuickDeliver\">\n                                        QuickDeliver\n                                    </p>\n                                </div>\n                                <span class=\"b-status\" data-kid=\"1-1-2-4-1-2-3-1-2\" data-name=\"unverified employer status badge\">\n                                    Not yet verified\n                                </span>\n                            </div>\n                            <div class=\"b-job-bottom\" data-kid=\"1-1-2-4-1-2-3-2\" data-name=\"job card footer row (pay + location)\">\n                                <span class=\"b-pay\" data-kid=\"1-1-2-4-1-2-3-2-1\" data-name=\"job card contract + tips pay amount\">\n                                    ₱12k + tips\n                                </span>\n                                <span class=\"b-job-place\" data-kid=\"1-1-2-4-1-2-3-2-2\" data-name=\"job card location label\">\n                                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-1-2-4-1-2-3-2-2-1\" data-name=\"map pin icon for job location\">\n                                    </i>\n                                    Cogon\n                                </span>\n                            </div>\n                            <p class=\"b-job-note\" data-kid=\"1-1-2-4-1-2-3-3\" data-name=\"job card note line with contract type and vehicle requirement\">\n                                Contract · Has own motorcycle\n                            </p>\n                        </button>\n                    </section>\n                </aside>\n                <article aria-labelledby=\"selected-title\" class=\"b-details\" data-kid=\"1-1-2-4-2\" data-name=\"selected job details panel\">\n                    <a class=\"b-mobile-back\" data-kid=\"1-1-2-4-2-1\" data-name=\"mobile back to jobs link\" href=\"#job-list\">\n                        <i aria-hidden=\"true\" class=\"icon-arrow-left\" data-kid=\"1-1-2-4-2-1-1\" data-name=\"left arrow icon\">\n                        </i>\n                        Back to jobs\n                    </a>\n                    <div class=\"b-detail-head\" data-kid=\"1-1-2-4-2-2\" data-name=\"detail header row (job info + apply button)\">\n                        <div data-kid=\"1-1-2-4-2-2-1\" data-name=\"detail job identity container\">\n                            <p class=\"b-detail-overline\" data-kid=\"1-1-2-4-2-2-1-1\" data-name=\"detail overline with category and contract type\">\n                                Selected job\n                                <span aria-hidden=\"true\" data-kid=\"1-1-2-4-2-2-1-1-1\" data-name=\"overline separator dot\">\n                                    ·\n                                </span>\n                                Full-time\n                            </p>\n                            <h2 class=\"b-detail-title\" data-kid=\"1-1-2-4-2-2-1-2\" data-name=\"detail job role title Store Manager\" id=\"selected-title\">\n                                Store Manager\n                            </h2>\n                            <p class=\"b-detail-company\" data-kid=\"1-1-2-4-2-2-1-3\" data-name=\"detail job employer name Digos Central Mall\">\n                                Digos Central Mall\n                            </p>\n                            <span class=\"b-employer-status\" data-kid=\"1-1-2-4-2-2-1-4\" data-name=\"verified employer status badge\">\n                                <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-1-2-4-2-2-1-4-1\" data-name=\"verified shield check icon\">\n                                </i>\n                                Employer documents reviewed\n                            </span>\n                        </div>\n                        <button class=\"b-apply-top\" data-kid=\"1-1-2-4-2-2-2\" data-name=\"primary Apply for Store Manager button (top)\" type=\"button\">\n                            Apply for Store Manager\n                        </button>\n                    </div>\n                    <div aria-label=\"Job facts\" class=\"b-fact-grid\" data-kid=\"1-1-2-4-2-3\" data-name=\"job facts summary grid (pay/area/getting-there/work-setup)\">\n                        <div class=\"b-fact\" data-kid=\"1-1-2-4-2-3-1\" data-name=\"pay fact cell\">\n                            <p class=\"b-fact-label\" data-kid=\"1-1-2-4-2-3-1-1\" data-name=\"pay fact label\">\n                                Pay\n                            </p>\n                            <p class=\"b-fact-value mono\" data-kid=\"1-1-2-4-2-3-1-2\" data-name=\"pay fact value (monospace)\">\n                                ₱15k–₱20k / month\n                            </p>\n                        </div>\n                        <div class=\"b-fact\" data-kid=\"1-1-2-4-2-3-2\" data-name=\"area fact cell\">\n                            <p class=\"b-fact-label\" data-kid=\"1-1-2-4-2-3-2-1\" data-name=\"area fact label\">\n                                Area\n                            </p>\n                            <p class=\"b-fact-value\" data-kid=\"1-1-2-4-2-3-2-2\" data-name=\"area fact value\">\n                                Zone 1 (Poblacion)\n                            </p>\n                        </div>\n                        <div class=\"b-fact\" data-kid=\"1-1-2-4-2-3-3\" data-name=\"getting there fact cell\">\n                            <p class=\"b-fact-label\" data-kid=\"1-1-2-4-2-3-3-1\" data-name=\"getting there fact label\">\n                                Getting there\n                            </p>\n                            <p class=\"b-fact-value\" data-kid=\"1-1-2-4-2-3-3-2\" data-name=\"getting there fact value\">\n                                Walk from Public Market\n                            </p>\n                        </div>\n                        <div class=\"b-fact\" data-kid=\"1-1-2-4-2-3-4\" data-name=\"work setup fact cell\">\n                            <p class=\"b-fact-label\" data-kid=\"1-1-2-4-2-3-4-1\" data-name=\"work setup fact label\">\n                                Work setup\n                            </p>\n                            <p class=\"b-fact-value\" data-kid=\"1-1-2-4-2-3-4-2\" data-name=\"work setup fact value\">\n                                Not specified\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"b-detail-columns\" data-kid=\"1-1-2-4-2-4\" data-name=\"detail two column body (about + requirements)\">\n                        <section class=\"b-section\" data-kid=\"1-1-2-4-2-4-1\" data-name=\"about the role section\">\n                            <h3 data-kid=\"1-1-2-4-2-4-1-1\" data-name=\"About the role section heading\">\n                                About the role\n                            </h3>\n                            <p data-kid=\"1-1-2-4-2-4-1-2\" data-name=\"about the role description paragraph\">\n                                We are looking for a reliable and energetic individual to join our team in Digos City. You will be responsible for daily operations, ensuring customer satisfaction, and managing local inventory. This role requires someone who lives nearby and can commit to our standard operating hours.\n                            </p>\n                            <p class=\"b-verify-note\" data-kid=\"1-1-2-4-2-4-1-3\" data-name=\"employer verification explanation note\">\n                                A “documents reviewed” label means the employer’s documents were reviewed. It is not a government endorsement.\n                            </p>\n                        </section>\n                        <section class=\"b-section\" data-kid=\"1-1-2-4-2-4-2\" data-name=\"requirements section\">\n                            <h3 data-kid=\"1-1-2-4-2-4-2-1\" data-name=\"requirements section heading\">\n                                What you’ll need to apply\n                            </h3>\n                            <ul class=\"b-requirements\" data-kid=\"1-1-2-4-2-4-2-2\" data-name=\"requirements bulleted list\">\n                                <li data-kid=\"1-1-2-4-2-4-2-2-1\" data-name=\"requirement item: Digos City resident\">\n                                    Resident of Digos City, preferably near Zone 1 (Poblacion).\n                                </li>\n                                <li data-kid=\"1-1-2-4-2-4-2-2-2\" data-name=\"requirement item: at least 6 months experience\">\n                                    At least 6 months of experience in a related field.\n                                </li>\n                                <li data-kid=\"1-1-2-4-2-4-2-2-3\" data-name=\"requirement item: communication skills\">\n                                    Strong communication skills and a customer-first attitude.\n                                </li>\n                                <li data-kid=\"1-1-2-4-2-4-2-2-4\" data-name=\"requirement item: available to start immediately\">\n                                    Available to start immediately.\n                                </li>\n                            </ul>\n                        </section>\n                    </div>\n                    <div class=\"b-detail-spacer\" data-kid=\"1-1-2-4-2-5\" data-name=\"flex spacer between content and bottom footer\">\n                    </div>\n                    <footer class=\"b-bottom\" data-kid=\"1-1-2-4-2-6\" data-name=\"sticky bottom action bar\">\n                        <span class=\"b-bottom-copy\" data-kid=\"1-1-2-4-2-6-1\" data-name=\"resume note microcopy\">\n                            Use the Digos Talent Form. A résumé is optional.\n                        </span>\n                        <div class=\"b-bottom-actions\" data-kid=\"1-1-2-4-2-6-2\" data-name=\"bottom action buttons container\">\n                            <button class=\"b-ghost\" data-kid=\"1-1-2-4-2-6-2-1\" data-name=\"save job ghost link button\" type=\"button\">\n                                Save job\n                            </button>\n                            <button class=\"b-action\" data-kid=\"1-1-2-4-2-6-2-2\" data-name=\"primary Apply for Store Manager button (bottom)\" type=\"button\">\n                                Apply for Store Manager\n                            </button>\n                        </div>\n                    </footer>\n                </article>\n            </section>\n            <p class=\"b-disclaimer\" data-kid=\"1-1-2-5\" data-name=\"footer disclaimer text\">\n                Job information is shown as provided. Contact the employer to confirm details before making arrangements.\n            </p>\n        </main>\n    </div>\n</div>\n",
      "comments": [],
