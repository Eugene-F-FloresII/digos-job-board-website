      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#2b2622] text-[#f7f5f0] font-[Inter,system-ui,sans-serif] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#3f3a36] bg-[#2b2622]\" data-kid=\"1-1\" data-name=\"header bar with brand and navigation\">\n        <div class=\"mx-auto flex h-[58px] max-w-[720px] items-center justify-between px-5\" data-kid=\"1-1-1\" data-name=\"brand bar container\">\n            <a aria-label=\"DigosJobs home\" class=\"flex items-center gap-2.5 no-underline text-[#f7f5f0]\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"#\">\n                <span class=\"flex h-7 w-7 items-center justify-center rounded-[3px] bg-[#f7f5f0] text-[14px] font-semibold text-[#2b2622]\" data-kid=\"1-1-1-1-1\" data-name=\"logo monogram badge\">\n                    D\n                </span>\n                <span class=\"text-[15px] font-medium tracking-[-0.2px]\" data-kid=\"1-1-1-1-2\" data-name=\"site name text\">\n                    DigosJobs\n                </span>\n            </a>\n            <span class=\"text-[12px] text-[#c9c0ad]\" data-kid=\"1-1-1-2\" data-name=\"location label text\">\n                Digos City\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"mx-auto flex h-[42px] max-w-[720px] items-stretch justify-between px-5 text-[13px]\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n            <a aria-current=\"page\" class=\"flex items-center border-b-2 border-[#f7f5f0] px-2 font-medium text-[#f7f5f0] no-underline\" data-kid=\"1-1-2-1\" data-name=\"jobs nav link\" href=\"#\">\n                Jobs\n            </a>\n            <a class=\"flex items-center border-b-2 border-transparent px-2 text-[#aea69c] no-underline\" data-kid=\"1-1-2-2\" data-name=\"applications nav link\" href=\"#\">\n                Applications\n            </a>\n            <a class=\"flex items-center border-b-2 border-transparent px-2 text-[#aea69c] no-underline\" data-kid=\"1-1-2-3\" data-name=\"employer nav link\" href=\"#\">\n                Employer\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto max-w-[720px] px-5 pb-32\" data-kid=\"1-2\" data-name=\"main content area\">\n        <a class=\"mt-6 inline-flex min-h-11 items-center gap-2 text-[14px] font-medium text-[#dad2c1] no-underline\" data-kid=\"1-2-1\" data-name=\"back to jobs link\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-arrow-left h-4 w-4 text-[#aea69c]\" data-kid=\"1-2-1-1\" data-name=\"arrow left icon\">\n            </i>\n            <span data-kid=\"1-2-1-2\" data-name=\"back link text\">\n                Back to jobs\n            </span>\n        </a>\n        <section aria-labelledby=\"job-title\" class=\"pt-5\" data-kid=\"1-2-2\" data-name=\"job title section\">\n            <p class=\"mb-3 text-[12px] leading-5 text-[#aea69c]\" data-kid=\"1-2-2-1\" data-name=\"job meta line with shift and zone\">\n                Full-time\n                <span aria-hidden=\"true\" class=\"px-1.5 text-[#3f3a36]\" data-kid=\"1-2-2-1-1\" data-name=\"slash separator\">\n                    /\n                </span>\n                Zone 1 (Poblacion)\n            </p>\n            <h1 class=\"max-w-[340px] text-[30px] font-normal leading-[1.12] tracking-[-1px] text-[#f7f5f0]\" data-kid=\"1-2-2-2\" data-name=\"job title heading\" id=\"job-title\">\n                Store Manager\n            </h1>\n            <div class=\"mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[15px] leading-6 text-[#dad2c1]\" data-kid=\"1-2-2-3\" data-name=\"job location row\">\n                <span class=\"font-medium text-[#f7f5f0]\" data-kid=\"1-2-2-3-1\" data-name=\"mall name text\">\n                    Digos Central Mall\n                </span>\n                <span aria-hidden=\"true\" class=\"text-[#3f3a36]\" data-kid=\"1-2-2-3-2\" data-name=\"dot separator\">\n                    ·\n                </span>\n                <span class=\"inline-flex items-center gap-1.5 text-[12px] text-[#c9c0ad]\" data-kid=\"1-2-2-3-3\" data-name=\"verification badge with icon\">\n                    <i aria-hidden=\"true\" class=\"icon-shield-check h-3.5 w-3.5 text-[#dad2c1]\" data-kid=\"1-2-2-3-3-1\" data-name=\"shield check icon\">\n                    </i>\n                    Employer documents reviewed\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Pay and location\" class=\"mt-7 border-y border-[#3f3a36] py-5\" data-kid=\"1-2-3\" data-name=\"pay and location section\">\n            <p class=\"text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1\" data-name=\"salary label\">\n                Salary\n            </p>\n            <p class=\"mt-1 font-[DM_Mono,monospace] text-[24px] font-normal leading-8 tracking-[-0.7px] text-[#f7f5f0]\" data-kid=\"1-2-3-2\" data-name=\"salary amount text\">\n                ₱15k–₱20k\n                <span class=\"font-[Inter,system-ui,sans-serif] text-[15px] tracking-normal text-[#c9c0ad]\" data-kid=\"1-2-3-2-1\" data-name=\"per month suffix\">\n                    / mo\n                </span>\n            </p>\n            <div class=\"mt-5 grid grid-cols-1 gap-4\" data-kid=\"1-2-3-3\" data-name=\"location details grid\">\n                <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-3-1\" data-name=\"location item row\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin mt-0.5 h-4 w-4 shrink-0 text-[#aea69c]\" data-kid=\"1-2-3-3-1-1\" data-name=\"map pin icon\">\n                    </i>\n                    <div data-kid=\"1-2-3-3-1-2\" data-name=\"location text block\">\n                        <p class=\"text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-3-1-2-1\" data-name=\"location label\">\n                            Location\n                        </p>\n                        <p class=\"mt-0.5 text-[14px] leading-5 text-[#f7f5f0]\" data-kid=\"1-2-3-3-1-2-2\" data-name=\"location value text\">\n                            Zone 1 (Poblacion)\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-3-2\" data-name=\"transit item row\">\n                    <i aria-hidden=\"true\" class=\"icon-bus-front mt-0.5 h-4 w-4 shrink-0 text-[#aea69c]\" data-kid=\"1-2-3-3-2-1\" data-name=\"bus icon\">\n                    </i>\n                    <div data-kid=\"1-2-3-3-2-2\" data-name=\"transit text block\">\n                        <p class=\"text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-3-2-2-1\" data-name=\"transit label\">\n                            Getting there\n                        </p>\n                        <p class=\"mt-0.5 text-[14px] leading-5 text-[#f7f5f0]\" data-kid=\"1-2-3-3-2-2-2\" data-name=\"transit value text\">\n                            Walk from Public Market\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-3-3\" data-name=\"work setup item row\">\n                    <i aria-hidden=\"true\" class=\"icon-briefcase-business mt-0.5 h-4 w-4 shrink-0 text-[#aea69c]\" data-kid=\"1-2-3-3-3-1\" data-name=\"briefcase icon\">\n                    </i>\n                    <div data-kid=\"1-2-3-3-3-2\" data-name=\"work setup text block\">\n                        <p class=\"text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-3-3-2-1\" data-name=\"work setup label\">\n                            Work setup\n                        </p>\n                        <p class=\"mt-0.5 text-[14px] leading-5 text-[#dad2c1]\" data-kid=\"1-2-3-3-3-2-2\" data-name=\"work setup value text\">\n                            Not specified\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"requirements-title\" class=\"pt-6\" data-kid=\"1-2-4\" data-name=\"requirements section\">\n            <h2 class=\"text-[17px] font-medium leading-6 tracking-[-0.2px] text-[#f7f5f0]\" data-kid=\"1-2-4-1\" data-name=\"requirements heading\" id=\"requirements-title\">\n                What you’ll need to apply\n            </h2>\n            <ul class=\"mt-4 space-y-3.5 pl-0 text-[14px] leading-[1.5] text-[#dad2c1]\" data-kid=\"1-2-4-2\" data-name=\"requirements list\">\n                <li class=\"flex gap-3\" data-kid=\"1-2-4-2-1\" data-name=\"requirement list item\">\n                    <span aria-hidden=\"true\" class=\"mt-[8px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#aea69c]\" data-kid=\"1-2-4-2-1-1\" data-name=\"bullet dot indicator\">\n                    </span>\n                    <span data-kid=\"1-2-4-2-1-2\" data-name=\"requirement text\">\n                        Resident of Digos City, preferably near Zone 1 (Poblacion).\n                    </span>\n                </li>\n                <li class=\"flex gap-3\" data-kid=\"1-2-4-2-2\" data-name=\"requirement list item\">\n                    <span aria-hidden=\"true\" class=\"mt-[8px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#aea69c]\" data-kid=\"1-2-4-2-2-1\" data-name=\"bullet dot indicator\">\n                    </span>\n                    <span data-kid=\"1-2-4-2-2-2\" data-name=\"requirement text\">\n                        At least 6 months of experience in a related field.\n                    </span>\n                </li>\n                <li class=\"flex gap-3\" data-kid=\"1-2-4-2-3\" data-name=\"requirement list item\">\n                    <span aria-hidden=\"true\" class=\"mt-[8px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#aea69c]\" data-kid=\"1-2-4-2-3-1\" data-name=\"bullet dot indicator\">\n                    </span>\n                    <span data-kid=\"1-2-4-2-3-2\" data-name=\"requirement text\">\n                        Strong communication skills and a customer-first attitude.\n                    </span>\n                </li>\n                <li class=\"flex gap-3\" data-kid=\"1-2-4-2-4\" data-name=\"requirement list item\">\n                    <span aria-hidden=\"true\" class=\"mt-[8px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#aea69c]\" data-kid=\"1-2-4-2-4-1\" data-name=\"bullet dot indicator\">\n                    </span>\n                    <span data-kid=\"1-2-4-2-4-2\" data-name=\"requirement text\">\n                        Available to start immediately.\n                    </span>\n                </li>\n            </ul>\n        </section>\n        <section aria-labelledby=\"about-title\" class=\"mt-7 border-t border-[#3f3a36] pt-5\" data-kid=\"1-2-5\" data-name=\"about work section\">\n            <h2 class=\"text-[17px] font-medium leading-6 tracking-[-0.2px] text-[#f7f5f0]\" data-kid=\"1-2-5-1\" data-name=\"about heading\" id=\"about-title\">\n                About this work\n            </h2>\n            <p class=\"mt-3 text-[14px] leading-[1.65] text-[#c9c0ad]\" data-kid=\"1-2-5-2\" data-name=\"about description text\">\n                We are looking for a reliable and energetic individual to join our team in Digos City. You will support daily operations, customer service, and local inventory, and be available for the standard operating hours.\n            </p>\n        </section>\n    </main>\n    <footer class=\"sticky bottom-0 border-t border-[#3f3a36] bg-[#2b2622] px-5 py-3.5\" data-kid=\"1-3\" data-name=\"sticky footer action bar\">\n        <div class=\"mx-auto flex max-w-[720px] items-center gap-3\" data-kid=\"1-3-1\" data-name=\"footer action row\">\n            <button aria-label=\"Save Store Manager job\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-[3px] border border-[#3f3a36] bg-transparent text-[#dad2c1]\" data-kid=\"1-3-1-1\" data-name=\"save job button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"icon-bookmark h-[18px] w-[18px]\" data-kid=\"1-3-1-1-1\" data-name=\"bookmark icon\">\n                </i>\n            </button>\n            <button class=\"flex h-11 flex-1 items-center justify-center rounded-[3px] bg-[#f7f5f0] px-4 text-[14px] font-medium text-[#2b2622]\" data-kid=\"1-3-1-2\" data-name=\"apply for job button\" type=\"button\">\n                Apply for Store Manager\n            </button>\n        </div>\n        <p class=\"mx-auto mt-2 max-w-[720px] text-center text-[12px] leading-4 text-[#aea69c]\" data-kid=\"1-3-2\" data-name=\"footer note text\">\n            Use the Digos Talent Form. A résumé is optional.\n        </p>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-11T13:20:40.634867+00:00",
      "modified": "2026-10-11T13:20:53.035545+00:00",
      "id": "var_d12d9d764812",
      "contentHeight": 1224
    },
    "var_06117cfdf746": {
      "type": "variant",
      "label": "A · Employer",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3570,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n.employer-page { font-family: 'Inter', sans-serif; }\n.mono-data { font-family: 'DM Mono', monospace; }\n@media (max-width: 900px) {\n  .desktop-nav { display: none !important; }\n  .mobile-nav { display: flex !important; }\n  .employer-content { padding: 36px 24px 88px !important; }\n  .employer-title-row { align-items: flex-start !important; }\n  .listing-row { grid-template-columns: 1fr auto !important; gap: 20px 16px !important; }\n  .listing-main { grid-column: 1 / -1 !important; }\n  .listing-action { grid-column: 1 / -1 !important; justify-content: flex-start !important; }\n  .role-facts { max-width: 100% !important; }\n}\n@media (max-width: 520px) {\n  .brand-caption { display: none !important; }\n  .mobile-nav { justify-content: space-between !important; padding-inline: 14px !important; }\n  .employer-content { padding: 28px 18px 96px !important; }\n  .employer-title-row { flex-direction: column !important; gap: 22px !important; }\n  .employer-title-row > a { width: 100% !important; justify-content: center !important; }\n  .listing-row { gap: 18px 10px !important; }\n  .listing-main h2 { font-size: 21px !important; }\n  .role-facts { line-height: 1.75 !important; }\n  .listing-action a { min-height: 44px !important; }\n}\n</style>\n<div class=\"employer-page min-h-[900px] bg-[#2b2622] text-[#f7f5f0] antialiased\" data-kid=\"1\" data-name=\"employer page layout container\">\n    <header class=\"border-b border-[#3f3a36] bg-[#2b2622]\" data-kid=\"1-1\" data-name=\"page header bar\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1240px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"header inner row\">\n            <a aria-label=\"DigosJobs home\" class=\"flex items-center gap-3 no-underline text-[#f7f5f0]\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-[4px] border border-[#aea69c] text-[15px] font-semibold tracking-[-0.04em]\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram badge\">\n                    D\n                </span>\n                <span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"brand name group\">\n                    <span class=\"text-[15px] font-semibold tracking-[-0.03em]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        DigosJobs\n                    </span>\n                    <span class=\"brand-caption mt-1 text-[11px] text-[#aea69c]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand caption text\">\n                        Digos City job board\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"desktop-nav flex h-full items-center gap-8 text-[14px] font-medium text-[#c9c0ad]\" data-kid=\"1-1-1-2\" data-name=\"primary desktop navigation\">\n                <a class=\"flex h-full items-center border-b border-transparent text-[#c9c0ad] no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"desktop nav link find jobs\" href=\"/jobs\">\n                    Find jobs\n                </a>\n                <a class=\"flex h-full items-center border-b border-transparent text-[#c9c0ad] no-underline\" data-kid=\"1-1-1-2-2\" data-name=\"desktop nav link applications\" href=\"/applicant\">\n                    Applications\n                </a>\n                <a aria-current=\"page\" class=\"flex h-full items-center border-b border-[#f7f5f0] text-[#f7f5f0] no-underline\" data-kid=\"1-1-1-2-3\" data-name=\"desktop nav link employer portal active\" href=\"/employer\">\n                    Employer portal\n                </a>\n            </nav>\n            <a class=\"hidden items-center gap-2 text-[13px] font-medium text-[#c9c0ad] no-underline lg:flex\" data-kid=\"1-1-1-3\" data-name=\"location label link\" href=\"/jobs\">\n                <i aria-hidden=\"true\" class=\"icon-map-pin text-[15px]\" data-kid=\"1-1-1-3-1\" data-name=\"map pin icon\">\n                </i>\n                Digos City\n            </a>\n        </div>\n        <nav aria-label=\"Mobile navigation\" class=\"mobile-nav hidden items-center justify-around border-t border-[#3f3a36] px-5 py-3 text-[13px] text-[#c9c0ad]\" data-kid=\"1-1-2\" data-name=\"mobile navigation bar\">\n            <a class=\"min-h-[44px] flex items-center text-[#c9c0ad] no-underline\" data-kid=\"1-1-2-1\" data-name=\"mobile nav link find jobs\" href=\"/jobs\">\n                Find jobs\n            </a>\n            <a class=\"min-h-[44px] flex items-center text-[#c9c0ad] no-underline\" data-kid=\"1-1-2-2\" data-name=\"mobile nav link applications\" href=\"/applicant\">\n                Applications\n            </a>\n            <a aria-current=\"page\" class=\"min-h-[44px] flex items-center border-b border-[#f7f5f0] text-[#f7f5f0] no-underline\" data-kid=\"1-1-2-3\" data-name=\"mobile nav link employer active\" href=\"/employer\">\n                Employer\n            </a>\n        </nav>\n    </header>\n    <main class=\"employer-content mx-auto max-w-[1160px] px-8 pb-24 pt-[58px]\" data-kid=\"1-2\" data-name=\"employer page main content\">\n        <div class=\"employer-title-row mb-[58px] flex items-end justify-between gap-8\" data-kid=\"1-2-1\" data-name=\"employer title row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"employer title group\">\n                <div class=\"mb-4 flex items-center gap-2 text-[13px] text-[#c9c0ad]\" data-kid=\"1-2-1-1-1\" data-name=\"verified employer indicator row\">\n                    <span class=\"inline-flex h-5 w-5 items-center justify-center rounded-full border border-[#aea69c] text-[11px]\" data-kid=\"1-2-1-1-1-1\" data-name=\"verified check icon badge\">\n                        <i aria-hidden=\"true\" class=\"icon-check\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"checkmark icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-1-1-1-2\" data-name=\"verified employer label\">\n                        Verified employer\n                    </span>\n                    <span class=\"text-[#6f675f]\" data-kid=\"1-2-1-1-1-3\" data-name=\"separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-1-1-1-4\" data-name=\"city location label\">\n                        Digos City\n                    </span>\n                </div>\n                <h1 class=\"m-0 text-[36px] font-medium leading-[1.15] tracking-[-0.045em] text-[#f7f5f0]\" data-kid=\"1-2-1-1-2\" data-name=\"employer headline\">\n                    Digos Central Mall\n                </h1>\n                <p class=\"mb-0 mt-3 text-[15px] leading-6 text-[#aea69c]\" data-kid=\"1-2-1-1-3\" data-name=\"employer subtitle description\">\n                    Manage your published jobs and drafts.\n                </p>\n            </div>\n            <a class=\"inline-flex min-h-[44px] shrink-0 items-center gap-2 rounded-[3px] bg-[#f7f5f0] px-5 text-[14px] font-medium text-[#2b2622] no-underline\" data-kid=\"1-2-1-2\" data-name=\"post a job call-to-action button\" href=\"/employer/new\">\n                <i aria-hidden=\"true\" class=\"icon-plus text-[16px]\" data-kid=\"1-2-1-2-1\" data-name=\"plus icon\">\n                </i>\n                Post a job\n            </a>\n        </div>\n        <section aria-labelledby=\"published-heading\" class=\"mb-[54px]\" data-kid=\"1-2-2\" data-name=\"published jobs section\">\n            <div class=\"mb-2 flex items-baseline justify-between border-b border-[#3f3a36] pb-4\" data-kid=\"1-2-2-1\" data-name=\"published section header row\">\n                <h2 class=\"m-0 text-[20px] font-medium tracking-[-0.025em] text-[#f7f5f0]\" data-kid=\"1-2-2-1-1\" data-name=\"published section heading\" id=\"published-heading\">\n                    Published\n                </h2>\n                <span class=\"mono-data text-[12px] text-[#aea69c]\" data-kid=\"1-2-2-1-2\" data-name=\"published job count label\">\n                    1 job\n                </span>\n            </div>\n            <article class=\"listing-row grid grid-cols-[minmax(0,1fr)_190px_220px] items-center gap-8 border-b border-[#3f3a36] py-7\" data-kid=\"1-2-2-2\" data-name=\"published job listing row\">\n                <div class=\"listing-main min-w-0\" data-kid=\"1-2-2-2-1\" data-name=\"published job detail group\">\n                    <div class=\"mb-2 flex flex-wrap items-center gap-x-3 gap-y-2\" data-kid=\"1-2-2-2-1-1\" data-name=\"job title and status row\">\n                        <h2 class=\"m-0 text-[23px] font-medium leading-tight tracking-[-0.03em] text-[#f7f5f0]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"job title heading\">\n                            Store Manager\n                        </h2>\n                        <span class=\"inline-flex items-center gap-1.5 text-[12px] font-medium text-[#dad2c1]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"active status badge\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#dad2c1]\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"status dot indicator\">\n                            </span>\n                            Active\n                        </span>\n                    </div>\n                    <p class=\"role-facts m-0 max-w-[690px] text-[14px] leading-6 text-[#c9c0ad]\" data-kid=\"1-2-2-2-1-2\" data-name=\"job facts summary text\">\n                        Full-time\n                        <span class=\"px-1.5 text-[#6f675f]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"facts separator dot\">\n                            ·\n                        </span>\n                        ₱15k–₱20k / month\n                        <span class=\"px-1.5 text-[#6f675f]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"facts separator dot\">\n                            ·\n                        </span>\n                        Zone 1 (Poblacion)\n                        <span class=\"px-1.5 text-[#6f675f]\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"facts separator dot\">\n                            ·\n                        </span>\n                        Walk from Public Market\n                    </p>\n                    <p class=\"m-0 mt-2 text-[12px] leading-5 text-[#aea69c]\" data-kid=\"1-2-2-2-1-3\" data-name=\"job posted date text\">\n                        Posted Oct 1\n                    </p>\n                </div>\n                <div class=\"text-right\" data-kid=\"1-2-2-2-2\" data-name=\"applicants count block\">\n                    <p class=\"mono-data m-0 text-[24px] leading-none tracking-[-0.04em] text-[#f7f5f0]\" data-kid=\"1-2-2-2-2-1\" data-name=\"applicants count number\">\n                        12\n                    </p>\n                    <p class=\"m-0 mt-2 text-[12px] text-[#aea69c]\" data-kid=\"1-2-2-2-2-2\" data-name=\"applicants count label\">\n                        applicants\n                    </p>\n                </div>\n                <div class=\"listing-action flex justify-end\" data-kid=\"1-2-2-2-3\" data-name=\"listing action group\">\n                    <a class=\"inline-flex min-h-[44px] items-center gap-2 rounded-[3px] border border-[#5a534c] px-4 text-[13px] font-medium text-[#f7f5f0] no-underline\" data-kid=\"1-2-2-2-3-1\" data-name=\"view applicants action button\" href=\"/employer/applicants?jobId=1\">\n                        View 12 applicants\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[14px]\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n            </article>\n        </section>\n        <section aria-labelledby=\"drafts-heading\" data-kid=\"1-2-3\" data-name=\"drafts section\">\n            <div class=\"mb-2 flex items-baseline justify-between border-b border-[#3f3a36] pb-4\" data-kid=\"1-2-3-1\" data-name=\"drafts section header row\">\n                <h2 class=\"m-0 text-[20px] font-medium tracking-[-0.025em] text-[#f7f5f0]\" data-kid=\"1-2-3-1-1\" data-name=\"drafts section heading\" id=\"drafts-heading\">\n                    Drafts\n                </h2>\n                <span class=\"mono-data text-[12px] text-[#aea69c]\" data-kid=\"1-2-3-1-2\" data-name=\"drafts job count label\">\n                    1 job\n                </span>\n            </div>\n            <article class=\"listing-row grid grid-cols-[minmax(0,1fr)_190px_220px] items-center gap-8 border-b border-[#3f3a36] py-7\" data-kid=\"1-2-3-2\" data-name=\"draft job listing row\">\n                <div class=\"listing-main min-w-0\" data-kid=\"1-2-3-2-1\" data-name=\"draft job detail group\">\n                    <div class=\"mb-2 flex flex-wrap items-center gap-x-3 gap-y-2\" data-kid=\"1-2-3-2-1-1\" data-name=\"draft title and status row\">\n                        <h2 class=\"m-0 text-[23px] font-medium leading-tight tracking-[-0.03em] text-[#f7f5f0]\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"draft job title heading\">\n                            Cashier\n                        </h2>\n                        <span class=\"inline-flex items-center gap-1.5 text-[12px] text-[#c9c0ad]\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"draft status badge\">\n                            <span class=\"h-1.5 w-1.5 rounded-full border border-[#aea69c]\" data-kid=\"1-2-3-2-1-1-2-1\" data-name=\"status dot indicator\">\n                            </span>\n                            Draft\n                        </span>\n                    </div>\n                    <p class=\"role-facts m-0 max-w-[690px] text-[14px] leading-6 text-[#c9c0ad]\" data-kid=\"1-2-3-2-1-2\" data-name=\"draft job facts summary text\">\n                        Part-time\n                        <span class=\"px-1.5 text-[#6f675f]\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"facts separator dot\">\n                            ·\n                        </span>\n                        0 applicants\n                    </p>\n                    <p class=\"m-0 mt-2 text-[12px] leading-5 text-[#aea69c]\" data-kid=\"1-2-3-2-1-3\" data-name=\"draft last edited text\">\n                        Last edited 2h ago\n                    </p>\n                </div>\n                <div data-kid=\"1-2-3-2-2\" data-name=\"empty applicants block placeholder\">\n                </div>\n                <div class=\"listing-action flex justify-end\" data-kid=\"1-2-3-2-3\" data-name=\"listing action group\">\n                    <a class=\"inline-flex min-h-[44px] items-center gap-2 rounded-[3px] border border-[#5a534c] px-4 text-[13px] font-medium text-[#f7f5f0] no-underline\" data-kid=\"1-2-3-2-3-1\" data-name=\"continue editing action button\" href=\"/employer/edit?jobId=2\">\n                        Continue editing\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[14px]\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n            </article>\n        </section>\n        <footer class=\"mt-[68px] flex flex-wrap items-center justify-between gap-4 border-t border-[#3f3a36] pt-5 text-[12px] text-[#aea69c]\" data-kid=\"1-2-4\" data-name=\"page footer bar\">\n            <span data-kid=\"1-2-4-1\" data-name=\"footer left label\">\n                Digos City job board\n            </span>\n            <span data-kid=\"1-2-4-2\" data-name=\"footer right label\">\n                Employer workspace\n            </span>\n        </footer>\n    </main>\n</div>\n",
