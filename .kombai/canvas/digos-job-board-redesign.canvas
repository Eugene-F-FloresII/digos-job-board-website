      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n*{box-sizing:border-box}\nbody{margin:0;background:#2b2622;color:#f7f5f0;font-family:Inter,system-ui,sans-serif}\n.shell{min-height:100vh;background:#2b2622;color:#f7f5f0;font-family:Inter,system-ui,sans-serif}\n.topbar{height:68px;border-bottom:1px solid #3f3a36;display:flex;align-items:center;justify-content:space-between;padding:0 42px}\n.brand{display:flex;align-items:center;gap:12px;color:#f7f5f0;text-decoration:none;font-size:15px;font-weight:600;letter-spacing:-.3px}\n.brand-mark{width:30px;height:30px;border:1px solid #6a6259;border-radius:4px;display:grid;place-items:center;font-size:12px;font-weight:600}\n.nav{display:flex;gap:28px;align-items:center;margin-left:42px;margin-right:auto}\n.nav a{color:#c9c0ad;text-decoration:none;font-size:13px;line-height:20px;padding:8px 0}\n.nav a.active{color:#f7f5f0;border-bottom:1px solid #f7f5f0}\n.nav a:hover{color:#f7f5f0}\n.user{display:flex;align-items:center;gap:10px;color:#dad2c1;font-size:13px}\n.avatar{width:30px;height:30px;border:1px solid #625b53;border-radius:50%;display:grid;place-items:center;color:#f7f5f0;font-size:11px;font-weight:600}\n.mobile-menu{display:none;color:#f7f5f0;font-size:20px}\n.main{max-width:1180px;margin:0 auto;padding:56px 32px 80px}\n.heading-row{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:36px;gap:24px}\nh1{font-size:34px;line-height:1.15;letter-spacing:-1.2px;font-weight:500;margin:0;color:#f7f5f0}\n.intro{margin:9px 0 0;color:#c9c0ad;font-size:15px;line-height:24px}\n.profile-link{color:#dad2c1;text-decoration:none;font-size:13px;border-bottom:1px solid #6b635a;padding:0 0 5px;white-space:nowrap}\n.profile-link:hover{color:#f7f5f0;border-color:#f7f5f0}\n.columns{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.8fr);gap:64px;align-items:start}\n.section-title{font-size:17px;line-height:24px;font-weight:500;margin:0 0 20px;color:#f7f5f0;letter-spacing:-.25px}\n.application{border-top:1px solid #625b53;border-bottom:1px solid #3f3a36;padding:22px 0 24px}\n.app-top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}\n.job-name{font-size:21px;line-height:28px;font-weight:500;letter-spacing:-.45px;margin:0;color:#f7f5f0}\n.employer{margin:5px 0 0;font-size:14px;line-height:21px;color:#c9c0ad}\n.status{display:inline-flex;align-items:center;gap:8px;color:#f7f5f0;font-size:13px;line-height:20px;font-weight:500;white-space:nowrap;padding-top:3px}\n.status-dot{width:7px;height:7px;border-radius:50%;background:#dad2c1;display:inline-block}\n.facts{display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:20px;color:#aea69c;font-size:13px;line-height:20px}\n.fact{display:flex;align-items:center;gap:8px}\n.fact i{font-size:14px;color:#c9c0ad}\n.action-row{margin-top:20px;display:flex;align-items:center;gap:20px}\n.button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:42px;padding:0 16px;border-radius:3px;border:1px solid transparent;background:#f7f5f0;color:#2b2622;font-size:13px;line-height:20px;font-weight:500;text-decoration:none;cursor:pointer}\n.button:hover{background:#dad2c1}\n.text-link{color:#dad2c1;text-decoration:none;font-size:13px;line-height:20px}\n.text-link:hover{color:#f7f5f0;text-decoration:underline;text-underline-offset:4px}\n.status-panel{padding:24px 0 4px}\n.status-kicker{font-size:13px;color:#aea69c;line-height:20px;margin:0 0 12px}\n.status-title{font-size:19px;line-height:27px;font-weight:500;letter-spacing:-.35px;margin:0;color:#f7f5f0}\n.status-description{max-width:540px;color:#c9c0ad;font-size:14px;line-height:23px;margin:8px 0 0}\n.timeline{margin:28px 0 0;list-style:none;padding:0;position:relative}\n.timeline:before{content:'';position:absolute;left:7px;top:12px;bottom:15px;width:1px;background:#625b53}\n.step{display:grid;grid-template-columns:16px 1fr;gap:14px;position:relative;padding:0 0 22px}\n.step:last-child{padding-bottom:0}\n.step-dot{width:15px;height:15px;border-radius:50%;border:1px solid #aea69c;background:#2b2622;z-index:1;margin-top:3px;display:grid;place-items:center;color:#2b2622;font-size:9px}\n.step.complete .step-dot{background:#dad2c1;border-color:#dad2c1}\n.step.current .step-dot{background:#2b2622;border:4px solid #f7f5f0}\n.step-name{font-size:14px;line-height:21px;font-weight:500;color:#f7f5f0;margin:0}\n.step-copy{font-size:12px;line-height:18px;color:#aea69c;margin:3px 0 0}\n.note{border-top:1px solid #3f3a36;margin-top:32px;padding-top:18px;color:#aea69c;font-size:12px;line-height:19px}\n.side{border-left:1px solid #3f3a36;padding-left:30px}\n.side h2{font-size:16px;font-weight:500;line-height:24px;margin:0 0 10px;color:#f7f5f0}\n.side p{font-size:13px;line-height:21px;color:#c9c0ad;margin:0}\n.side-link{display:inline-flex;align-items:center;gap:8px;margin-top:18px;color:#f7f5f0;text-decoration:none;font-size:13px;line-height:20px;border-bottom:1px solid #625b53;padding-bottom:5px}\n.side-link:hover{border-color:#f7f5f0}\n.help{margin-top:35px;border-top:1px solid #3f3a36;padding-top:18px}\n.help p{font-size:12px;line-height:19px;color:#aea69c;margin:0}\n.footer{max-width:1180px;margin:0 auto;border-top:1px solid #3f3a36;padding:18px 32px 28px;color:#aea69c;font-size:12px;display:flex;justify-content:space-between}\n@media(max-width:760px){.topbar{height:60px;padding:0 18px}.nav{display:flex;gap:16px;margin-left:20px;margin-right:0;flex:1;justify-content:flex-end}.nav a{font-size:12px}.nav a:nth-child(3){display:none}.user{display:none}.mobile-menu{display:none}.main{padding:35px 20px 48px}.heading-row{align-items:flex-start;margin-bottom:29px}.profile-link{display:none}h1{font-size:29px;line-height:35px}.intro{font-size:14px}.columns{grid-template-columns:1fr;gap:34px}.side{border-left:0;border-top:1px solid #3f3a36;padding:22px 0 0}.footer{padding:16px 20px 24px;gap:10px;flex-wrap:wrap}.section-title{margin-bottom:15px}.status-panel{padding-top:20px}}\n@media(max-width:430px){.topbar{padding:0 15px}.brand{font-size:14px;gap:8px}.brand-mark{width:28px;height:28px}.nav{gap:12px}.nav a{font-size:11px}.nav a:nth-child(2){display:none}.main{padding:28px 18px 42px}.heading-row{margin-bottom:23px}h1{font-size:27px}.application{padding-top:18px}.app-top{display:block}.status{margin-top:12px}.facts{gap:9px 16px;margin-top:16px}.action-row{align-items:flex-start;flex-direction:column;gap:14px}.button{width:100%;min-height:46px}.timeline{margin-top:24px}.step{padding-bottom:20px}.side{margin-top:2px}.footer{font-size:11px}}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n        <a aria-label=\"DigosJobs home\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"site brand link\" href=\"#jobs\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram mark\">\n                D\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand wordmark text\">\n                DigosJobs\n            </span>\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation links\">\n            <a data-kid=\"1-1-2-1\" data-name=\"jobs navigation link\" href=\"#jobs\">\n                Jobs\n            </a>\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-2-2\" data-name=\"applications navigation link (active)\" href=\"#applications\">\n                Applications\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"employer navigation link\" href=\"#employer\">\n                Employer\n            </a>\n        </nav>\n        <div class=\"user\" data-kid=\"1-1-3\" data-name=\"user account indicator\">\n            <span aria-hidden=\"true\" class=\"avatar\" data-kid=\"1-1-3-1\" data-name=\"user avatar initials\">\n                JS\n            </span>\n            <span data-kid=\"1-1-3-2\" data-name=\"user role label\">\n                Job seeker\n            </span>\n        </div>\n        <span aria-label=\"Open navigation\" class=\"mobile-menu\" data-kid=\"1-1-4\" data-name=\"mobile menu toggle\">\n            <i class=\"icon-menu\" data-kid=\"1-1-4-1\" data-name=\"menu hamburger icon\">\n            </i>\n        </span>\n    </header>\n    <main class=\"main\" data-kid=\"1-2\" data-name=\"main application content\" id=\"applications\">\n        <div class=\"heading-row\" data-kid=\"1-2-1\" data-name=\"page heading row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title block\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"page headline\">\n                    Your applications\n                </h1>\n                <p class=\"intro\" data-kid=\"1-2-1-1-2\" data-name=\"page intro text\">\n                    Check the latest status and what to do next.\n                </p>\n            </div>\n            <a class=\"profile-link\" data-kid=\"1-2-1-2\" data-name=\"digital bio-data profile link\" href=\"#profile\">\n                View your Digital Bio-Data\n                <i class=\"icon-arrow-up-right\" data-kid=\"1-2-1-2-1\" data-name=\"arrow-up-right icon\" style=\"font-size:13px;margin-left:4px\">\n                </i>\n            </a>\n        </div>\n        <div class=\"columns\" data-kid=\"1-2-2\" data-name=\"two-column application layout\">\n            <section aria-labelledby=\"application-heading\" data-kid=\"1-2-2-1\" data-name=\"application status section\">\n                <h2 class=\"section-title\" data-kid=\"1-2-2-1-1\" data-name=\"section title heading\" id=\"application-heading\">\n                    Application status\n                </h2>\n                <article class=\"application\" data-kid=\"1-2-2-1-2\" data-name=\"application detail card\">\n                    <div class=\"app-top\" data-kid=\"1-2-2-1-2-1\" data-name=\"application header row\">\n                        <div data-kid=\"1-2-2-1-2-1-1\" data-name=\"job title block\">\n                            <h3 class=\"job-name\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"job name heading\">\n                                Store Manager\n                            </h3>\n                            <p class=\"employer\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"employer name text\">\n                                Digos Central Mall\n                            </p>\n                        </div>\n                        <div class=\"status\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"application status badge\">\n                            <span class=\"status-dot\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"status indicator dot\">\n                            </span>\n                            Under review\n                        </div>\n                    </div>\n                    <div class=\"facts\" data-kid=\"1-2-2-1-2-2\" data-name=\"application facts row\">\n                        <span class=\"fact\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"location fact\">\n                            <i class=\"icon-map-pin\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            Zone 1 (Poblacion)\n                        </span>\n                        <span class=\"fact\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"salary fact\">\n                            <i class=\"icon-wallet\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"wallet icon\">\n                            </i>\n                            ₱15k–₱20k / month\n                        </span>\n                        <span class=\"fact\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"application date fact\">\n                            <i class=\"icon-calendar-days\" data-kid=\"1-2-2-1-2-2-3-1\" data-name=\"calendar icon\">\n                            </i>\n                            Applied Oct 2, 2026\n                        </span>\n                    </div>\n                    <div class=\"action-row\" data-kid=\"1-2-2-1-2-3\" data-name=\"application action row\">\n                        <a class=\"button\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"view job primary button\" href=\"#job-details\">\n                            View Store Manager job\n                            <i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </a>\n                        <a class=\"text-link\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"browse jobs text link\" href=\"#jobs\">\n                            Browse more jobs\n                        </a>\n                    </div>\n                    <div class=\"status-panel\" data-kid=\"1-2-2-1-2-4\" data-name=\"status update panel\">\n                        <p class=\"status-kicker\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"status kicker label\">\n                            Latest known update\n                        </p>\n                        <h3 class=\"status-title\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"status title heading\">\n                            The employer is reviewing your application\n                        </h3>\n                        <p class=\"status-description\" data-kid=\"1-2-2-1-2-4-3\" data-name=\"status description text\">\n                            Your application was submitted on Oct 2, 2026 at 10:00 AM and is currently under review. No further update is shown yet.\n                        </p>\n                    </div>\n                    <ol aria-label=\"Application history\" class=\"timeline\" data-kid=\"1-2-2-1-2-5\" data-name=\"application history timeline\">\n                        <li class=\"step complete\" data-kid=\"1-2-2-1-2-5-1\" data-name=\"completed timeline step\">\n                            <span class=\"step-dot\" data-kid=\"1-2-2-1-2-5-1-1\" data-name=\"completed step dot\">\n                                <i class=\"icon-check\" data-kid=\"1-2-2-1-2-5-1-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                            </span>\n                            <div data-kid=\"1-2-2-1-2-5-1-2\" data-name=\"step content block\">\n                                <p class=\"step-name\" data-kid=\"1-2-2-1-2-5-1-2-1\" data-name=\"step name text\">\n                                    Application submitted\n                                </p>\n                                <p class=\"step-copy\" data-kid=\"1-2-2-1-2-5-1-2-2\" data-name=\"step timestamp text\">\n                                    Oct 2, 2026 · 10:00 AM\n                                </p>\n                            </div>\n                        </li>\n                        <li class=\"step current\" data-kid=\"1-2-2-1-2-5-2\" data-name=\"current timeline step\">\n                            <span class=\"step-dot\" data-kid=\"1-2-2-1-2-5-2-1\" data-name=\"current step dot\">\n                            </span>\n                            <div data-kid=\"1-2-2-1-2-5-2-2\" data-name=\"step content block\">\n                                <p class=\"step-name\" data-kid=\"1-2-2-1-2-5-2-2-1\" data-name=\"step name text\">\n                                    Under review\n                                </p>\n                                <p class=\"step-copy\" data-kid=\"1-2-2-1-2-5-2-2-2\" data-name=\"step description text\">\n                                    The employer is reviewing your profile.\n                                </p>\n                            </div>\n                        </li>\n                    </ol>\n                    <p class=\"note\" data-kid=\"1-2-2-1-2-6\" data-name=\"footer note text\">\n                        You can return to this page to check for updates. No response time has been provided.\n                    </p>\n                </article>\n            </section>\n            <aside aria-label=\"Next steps\" class=\"side\" data-kid=\"1-2-2-2\" data-name=\"while you wait sidebar\">\n                <h2 data-kid=\"1-2-2-2-1\" data-name=\"sidebar heading\">\n                    While you wait\n                </h2>\n                <p data-kid=\"1-2-2-2-2\" data-name=\"sidebar description text\">\n                    Explore other local openings while this employer reviews your application.\n                </p>\n                <a class=\"side-link\" data-kid=\"1-2-2-2-3\" data-name=\"sidebar browse jobs link\" href=\"#jobs\">\n                    Browse jobs in Digos\n                    <i class=\"icon-arrow-right\" data-kid=\"1-2-2-2-3-1\" data-name=\"arrow right icon\">\n                    </i>\n                </a>\n                <div class=\"help\" data-kid=\"1-2-2-2-4\" data-name=\"help section\">\n                    <p data-kid=\"1-2-2-2-4-1\" data-name=\"help text\">\n                        Your Digital Bio-Data is the information you shared when you applied. Update your profile from its own page.\n                    </p>\n                    <a class=\"side-link\" data-kid=\"1-2-2-2-4-2\" data-name=\"open digital bio-data link\" href=\"#profile\">\n                        Open Digital Bio-Data\n                        <i class=\"icon-arrow-right\" data-kid=\"1-2-2-2-4-2-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </div>\n            </aside>\n        </div>\n    </main>\n    <footer class=\"footer\" data-kid=\"1-3\" data-name=\"footer bar\">\n        <span data-kid=\"1-3-1\" data-name=\"footer location text\">\n            DigosJobs · Digos City\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"footer disclaimer text\">\n            Application status is shown as provided by the employer.\n        </span>\n    </footer>\n</div>\n",
      "comments": [],
