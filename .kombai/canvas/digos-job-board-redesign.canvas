      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\nbody { margin: 0; }\n.jobs-app { min-height: 100vh; background: #2b2622; color: #f7f5f0; font-family: Inter, system-ui, sans-serif; }\n.topbar { height: 68px; display: flex; align-items: center; justify-content: space-between; padding: 0 48px; border-bottom: 1px solid #3f3a36; }\n.brand { display: flex; align-items: center; gap: 12px; color: #f7f5f0; text-decoration: none; }\n.brand-mark { width: 30px; height: 30px; border: 1px solid #aea69c; display: grid; place-items: center; font-size: 12px; font-weight: 600; letter-spacing: -.04em; border-radius: 4px; }\n.brand-name { font-size: 15px; font-weight: 500; letter-spacing: -.02em; }\n.brand-city { margin-left: 8px; padding-left: 12px; border-left: 1px solid #3f3a36; color: #aea69c; font-size: 12px; }\n.nav { display:flex; gap: 8px; height: 100%; align-items: center; }\n.nav a { color: #c9c0ad; text-decoration: none; padding: 10px 12px; font-size: 13px; border-radius: 3px; }\n.nav a.active { color:#f7f5f0; background:#383330; }\n.nav a:hover { color:#f7f5f0; }\n.account-link { color:#dad2c1; font-size:13px; text-decoration:none; }\nmain { max-width: 1344px; margin: 0 auto; padding: 34px 32px 48px; }\n.heading-row { display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:24px; }\nh1 { margin:0; font-size:30px; line-height:1.2; font-weight:500; letter-spacing:-.045em; }\n.page-intro { margin:7px 0 0; font-size:14px; color:#c9c0ad; }\n.heading-meta { display:flex; align-items:center; gap:8px; color:#aea69c; font-size:12px; }\n.heading-meta i { font-size:15px; }\n.searchbar { display:grid; grid-template-columns:minmax(200px,1.4fr) minmax(180px,1fr) 110px; align-items:end; gap:12px; padding:16px; margin-bottom:18px; background:#383330; border:1px solid #3f3a36; border-radius:6px; }\n.field label { display:block; margin:0 0 7px; color:#dad2c1; font-size:12px; font-weight:500; }\n.input-wrap { height:40px; display:flex; align-items:center; gap:9px; padding:0 11px; border:1px solid #514a44; border-radius:3px; background:#2b2622; color:#aea69c; }\n.input-wrap i { font-size:15px; }\n.input-wrap input { width:100%; border:0; outline:0; background:transparent; color:#f7f5f0; font:400 13px Inter, sans-serif; }\n.input-wrap input::placeholder { color:#aea69c; opacity:1; }\n.input-wrap:focus-within { outline:2px solid #f7f5f0; outline-offset:2px; }\n.search-button { height:40px; border:0; border-radius:3px; padding:0 14px; background:#f7f5f0; color:#2b2622; font:500 13px Inter, sans-serif; cursor:pointer; }\n.search-button:hover { background:#dad2c1; }\n.layout { min-height:640px; display:grid; grid-template-columns: 398px minmax(0,1fr); border:1px solid #3f3a36; border-radius:6px; overflow:hidden; background:#2b2622; }\n.list-column { border-right:1px solid #3f3a36; min-width:0; }\n.list-heading { display:flex; align-items:center; justify-content:space-between; padding:15px 18px; border-bottom:1px solid #3f3a36; background:#383330; }\n.list-heading h2 { margin:0; font-size:13px; font-weight:500; }\n.list-heading span { color:#aea69c; font:12px 'DM Mono', monospace; }\n.job-row { display:block; position:relative; padding:17px 18px 16px; color:#f7f5f0; text-decoration:none; border-bottom:1px solid #3f3a36; transition:background .15s ease; }\n.job-row:hover { background:#383330; }\n.job-row.selected { background:#383330; }\n.job-row.selected:before { position:absolute; inset:0 auto 0 0; width:2px; background:#f7f5f0; content:''; }\n.row-top { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; }\n.job-title { font-size:15px; font-weight:500; letter-spacing:-.02em; }\n.posted { color:#aea69c; font-size:11px; white-space:nowrap; }\n.company { display:flex; gap:7px; align-items:center; margin-top:5px; color:#c9c0ad; font-size:13px; }\n.company .icon-shield-check { color:#dad2c1; font-size:13px; }\n.row-facts { display:flex; justify-content:space-between; gap:10px; align-items:center; margin-top:14px; }\n.pay { font:13px 'DM Mono', monospace; color:#f7f5f0; }\n.location { display:flex; gap:5px; align-items:center; color:#c9c0ad; font-size:11px; text-align:right; }\n.location i { font-size:13px; }\n.type-label { display:inline-block; margin-top:11px; color:#aea69c; font-size:11px; }\n.details { position:relative; min-width:0; }\n.detail-head { padding:26px 32px 22px; border-bottom:1px solid #3f3a36; background:#383330; }\n.back-mobile { display:none; }\n.detail-kicker { display:flex; gap:8px; align-items:center; margin-bottom:12px; color:#dad2c1; font-size:12px; }\n.verified { padding-left:8px; border-left:1px solid #514a44; color:#c9c0ad; }\n.detail-head h2 { margin:0; font-weight:500; font-size:28px; line-height:1.2; letter-spacing:-.045em; }\n.employer { display:flex; gap:7px; align-items:center; margin-top:7px; color:#dad2c1; font-size:14px; }\n.verified-check { display:inline-flex; gap:5px; align-items:center; color:#f7f5f0; }\n.verified-check i { font-size:14px; }\n.facts { display:grid; grid-template-columns: repeat(3,minmax(0,1fr)); margin-top:24px; border-top:1px solid #514a44; border-bottom:1px solid #514a44; }\n.fact { padding:12px 14px 12px 0; }\n.fact + .fact { border-left:1px solid #514a44; padding-left:16px; }\n.fact-label { display:block; color:#aea69c; font-size:11px; margin-bottom:6px; }\n.fact-value { display:block; color:#f7f5f0; font-size:13px; line-height:1.4; }\n.fact-value.pay-value { font-family:'DM Mono',monospace; }\n.detail-content { max-width:800px; padding:24px 32px 120px; }\n.detail-content section + section { margin-top:24px; }\n.detail-content h3 { margin:0 0 11px; font-size:15px; font-weight:500; letter-spacing:-.015em; }\n.detail-content p { max-width:68ch; margin:0; color:#c9c0ad; font-size:13px; line-height:1.7; }\n.requirements { display:grid; grid-template-columns:1fr 1fr; gap:9px 24px; padding:0; margin:0; list-style:none; }\n.requirements li { position:relative; padding-left:17px; color:#dad2c1; font-size:13px; line-height:1.5; }\n.requirements li:before { position:absolute; top:8px; left:1px; width:4px; height:4px; background:#aea69c; border-radius:50%; content:''; }\n.detail-actions { position:absolute; bottom:0; left:0; right:0; display:flex; justify-content:space-between; align-items:center; gap:16px; padding:15px 28px; border-top:1px solid #3f3a36; background:#2b2622; }\n.action-note { color:#aea69c; font-size:12px; }\n.action-group { display:flex; gap:9px; }\n.button-secondary,.button-primary { min-height:40px; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:0 14px; border-radius:3px; font:500 13px Inter,sans-serif; text-decoration:none; cursor:pointer; }\n.button-secondary { border:1px solid #514a44; background:transparent; color:#dad2c1; }\n.button-secondary:hover { background:#383330; }\n.button-primary { border:1px solid #f7f5f0; background:#f7f5f0; color:#2b2622; }\n.button-primary:hover { background:#dad2c1; border-color:#dad2c1; }\n.button-primary i,.button-secondary i { font-size:15px; }\n.footer-note { margin:15px 0 0; color:#aea69c; font-size:11px; }\n@media (max-width: 900px) { .topbar { padding:0 22px; } main { padding:28px 22px; } .layout { grid-template-columns: 340px minmax(0,1fr); } .detail-head { padding:22px 24px 18px; } .detail-content { padding:22px 24px 120px; } .detail-actions { padding:13px 20px; } .requirements { grid-template-columns:1fr; } }\n@media (max-width: 680px) { .topbar { height:60px; padding:0 16px; } .brand-city { display:none; } .nav { gap:0; } .nav a { padding:9px 8px; font-size:12px; } .account-link { display:none; } main { padding:22px 14px 32px; } .heading-row { align-items:flex-start; flex-direction:column; gap:10px; margin-bottom:18px; } h1 { font-size:25px; } .searchbar { grid-template-columns:1fr; padding:13px; gap:12px; } .search-button { width:100%; } .layout { display:flex; flex-direction:column; min-height:auto; } .list-column { border-right:0; border-bottom:1px solid #3f3a36; } .job-row { padding:13px 15px; } .job-row:not(.selected) { display:none; } .details { min-height:570px; } .detail-head { padding:19px 16px 17px; } .back-mobile { display:inline-flex; align-items:center; gap:7px; margin-bottom:20px; color:#dad2c1; font-size:12px; text-decoration:none; } .detail-head h2 { font-size:24px; } .facts { grid-template-columns:1fr 1fr; } .fact { padding:11px 8px 11px 0; } .fact + .fact { padding-left:10px; } .fact:nth-child(3) { border-left:0; padding-left:0; border-top:1px solid #514a44; } .detail-content { padding:19px 16px 145px; } .requirements { gap:8px; } .detail-actions { padding:12px 14px; align-items:stretch; flex-direction:column; gap:9px; } .action-note { font-size:11px; } .action-group { display:grid; grid-template-columns:1fr auto; } .button-primary,.button-secondary { min-height:44px; } .footer-note { margin-top:11px; } }\n</style>\n<div class=\"jobs-app\" data-kid=\"1\" data-name=\"jobs marketplace page container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top bar with brand navigation and account link\">\n        <a aria-label=\"DigosJobs home\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"DigosJobs brand link\" href=\"#jobs\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram mark\">\n                D\n            </span>\n            <span class=\"brand-name\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                DigosJobs\n            </span>\n            <span class=\"brand-city\" data-dynamic=\"true\" data-kid=\"1-1-1-3\" data-name=\"brand city locality label\" data-reason=\"text replaced by job-selection script (was Digos City)\">\n                Digos City\n            </span>\n        </a>\n        <nav aria-label=\"Main navigation\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-2-1\" data-name=\"jobs navigation link (active page)\" href=\"#jobs\">\n                Jobs\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"applications navigation link\" href=\"#applications\">\n                Applications\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"employer navigation link\" href=\"#employer\">\n                Employer\n            </a>\n        </nav>\n        <a class=\"account-link\" data-kid=\"1-1-3\" data-name=\"applicant view account link\" href=\"#applications\">\n            Applicant view\n        </a>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area for job browsing\">\n        <div class=\"heading-row\" data-kid=\"1-2-1\" data-name=\"page heading row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title block\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"page headline\">\n                    Jobs in Digos City\n                </h1>\n                <p class=\"page-intro\" data-kid=\"1-2-1-1-2\" data-name=\"page intro subtitle\">\n                    Compare the work, pay and location before you apply.\n                </p>\n            </div>\n            <div class=\"heading-meta\" data-kid=\"1-2-1-2\" data-name=\"heading meta note with icon\">\n                <i class=\"icon-map-pin\" data-kid=\"1-2-1-2-1\" data-name=\"map pin icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"heading meta caption text\">\n                    Search by role and barangay\n                </span>\n            </div>\n        </div>\n        <form aria-label=\"Search jobs\" class=\"searchbar\" data-kid=\"1-2-2\" data-name=\"job search filter form\">\n            <div class=\"field\" data-kid=\"1-2-2-1\" data-name=\"role or keyword search field\">\n                <label data-kid=\"1-2-2-1-1\" data-name=\"role or keyword field label\" for=\"role-search\">\n                    Role or keyword\n                </label>\n                <div class=\"input-wrap\" data-kid=\"1-2-2-1-2\" data-name=\"role or keyword input wrapper\">\n                    <i class=\"icon-search\" data-kid=\"1-2-2-1-2-1\" data-name=\"search icon\">\n                    </i>\n                    <input data-kid=\"1-2-2-1-2-2\" data-name=\"role or keyword text input\" id=\"role-search\" placeholder=\"e.g. Store Manager\" type=\"search\"/>\n                </div>\n            </div>\n            <div class=\"field\" data-kid=\"1-2-2-2\" data-name=\"barangay or area search field\">\n                <label data-kid=\"1-2-2-2-1\" data-name=\"barangay or area field label\" for=\"barangay-select\">\n                    Barangay or area\n                </label>\n                <div class=\"input-wrap\" data-kid=\"1-2-2-2-2\" data-name=\"barangay or area input wrapper\">\n                    <i class=\"icon-map-pin\" data-kid=\"1-2-2-2-2-1\" data-name=\"map pin icon\">\n                    </i>\n                    <input data-kid=\"1-2-2-2-2-2\" data-name=\"barangay or area text input\" id=\"barangay-select\" placeholder=\"All areas in Digos\" type=\"text\"/>\n                </div>\n            </div>\n            <button class=\"search-button\" data-kid=\"1-2-2-3\" data-name=\"search jobs submit button\" type=\"button\">\n                Search jobs\n            </button>\n        </form>\n        <section aria-label=\"Job listings and selected job details\" class=\"layout\" data-kid=\"1-2-3\" data-name=\"job listings and details split layout\">\n            <aside aria-label=\"Job results\" class=\"list-column\" data-kid=\"1-2-3-1\" data-name=\"job results list column\">\n                <div class=\"list-heading\" data-kid=\"1-2-3-1-1\" data-name=\"job list column heading\">\n                    <h2 data-kid=\"1-2-3-1-1-1\" data-name=\"available jobs list title\">\n                        Available jobs\n                    </h2>\n                    <span data-kid=\"1-2-3-1-1-2\" data-name=\"listed pay column label\">\n                        Listed pay\n                    </span>\n                </div>\n                <a aria-current=\"true\" class=\"job-row selected\" data-kid=\"1-2-3-1-2\" data-name=\"Store Manager job listing row (selected)\" href=\"#store-manager\">\n                    <div class=\"row-top\" data-kid=\"1-2-3-1-2-1\" data-name=\"job row top with title and post time\">\n                        <span class=\"job-title\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"job listing title\">\n                            Store Manager\n                        </span>\n                        <span class=\"posted\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"posted time label\">\n                            2h ago\n                        </span>\n                    </div>\n                    <div class=\"company\" data-kid=\"1-2-3-1-2-2\" data-name=\"job listing company name with verified icon\">\n                        Digos Central Mall\n                        <i aria-label=\"Verified employer\" class=\"icon-shield-check\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"verified employer shield check icon\">\n                        </i>\n                    </div>\n                    <div class=\"row-facts\" data-kid=\"1-2-3-1-2-3\" data-name=\"job row pay and location facts\">\n                        <span class=\"pay\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"job listing pay amount\">\n                            ₱15k–₱20k / mo\n                        </span>\n                        <span class=\"location\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"job listing location with icon\">\n                            <i class=\"icon-map-pin\" data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"map pin location icon\">\n                            </i>\n                            Zone 1, Poblacion\n                        </span>\n                    </div>\n                    <span class=\"type-label\" data-kid=\"1-2-3-1-2-4\" data-name=\"job listing employment type label\">\n                        Full-time · Walk from Public Market\n                    </span>\n                </a>\n                <a class=\"job-row\" data-kid=\"1-2-3-1-3\" data-name=\"Barista job listing row\" href=\"#barista\">\n                    <div class=\"row-top\" data-kid=\"1-2-3-1-3-1\" data-name=\"job row top with title and post time\">\n                        <span class=\"job-title\" data-kid=\"1-2-3-1-3-1-1\" data-name=\"job listing title\">\n                            Barista\n                        </span>\n                        <span class=\"posted\" data-kid=\"1-2-3-1-3-1-2\" data-name=\"posted time label\">\n                            5h ago\n                        </span>\n                    </div>\n                    <div class=\"company\" data-kid=\"1-2-3-1-3-2\" data-name=\"job listing company name with verified icon\">\n                        Kapehan sa Digos\n                        <i aria-label=\"Verified employer\" class=\"icon-shield-check\" data-kid=\"1-2-3-1-3-2-1\" data-name=\"verified employer shield check icon\">\n                        </i>\n                    </div>\n                    <div class=\"row-facts\" data-kid=\"1-2-3-1-3-3\" data-name=\"job row pay and location facts\">\n                        <span class=\"pay\" data-kid=\"1-2-3-1-3-3-1\" data-name=\"job listing pay amount\">\n                            ₱400 / day\n                        </span>\n                        <span class=\"location\" data-kid=\"1-2-3-1-3-3-2\" data-name=\"job listing location with icon\">\n                            <i class=\"icon-map-pin\" data-kid=\"1-2-3-1-3-3-2-1\" data-name=\"map pin location icon\">\n                            </i>\n                            Tres de Mayo\n                        </span>\n                    </div>\n                    <span class=\"type-label\" data-kid=\"1-2-3-1-3-4\" data-name=\"job listing employment type label\">\n                        Daily gig · 1 trike ride from Gaisano\n                    </span>\n                </a>\n                <a class=\"job-row\" data-kid=\"1-2-3-1-4\" data-name=\"Customer Service job listing row\" href=\"#customer-service\">\n                    <div class=\"row-top\" data-kid=\"1-2-3-1-4-1\" data-name=\"job row top with title and post time\">\n                        <span class=\"job-title\" data-kid=\"1-2-3-1-4-1-1\" data-name=\"job listing title\">\n                            Customer Service\n                        </span>\n                        <span class=\"posted\" data-kid=\"1-2-3-1-4-1-2\" data-name=\"posted time label\">\n                            1d ago\n                        </span>\n                    </div>\n                    <div class=\"company\" data-kid=\"1-2-3-1-4-2\" data-name=\"job listing company name with verified icon\">\n                        Local Telco Branch\n                        <i aria-label=\"Verified employer\" class=\"icon-shield-check\" data-kid=\"1-2-3-1-4-2-1\" data-name=\"verified employer shield check icon\">\n                        </i>\n                    </div>\n                    <div class=\"row-facts\" data-kid=\"1-2-3-1-4-3\" data-name=\"job row pay and location facts\">\n                        <span class=\"pay\" data-kid=\"1-2-3-1-4-3-1\" data-name=\"job listing pay amount\">\n                            ₱14k / mo\n                        </span>\n                        <span class=\"location\" data-kid=\"1-2-3-1-4-3-2\" data-name=\"job listing location with icon\">\n                            <i class=\"icon-map-pin\" data-kid=\"1-2-3-1-4-3-2-1\" data-name=\"map pin location icon\">\n                            </i>\n                            Matti Area\n                        </span>\n                    </div>\n                    <span class=\"type-label\" data-kid=\"1-2-3-1-4-4\" data-name=\"job listing employment type label\">\n                        Full-time · Near Capitol\n                    </span>\n                </a>\n                <a class=\"job-row\" data-kid=\"1-2-3-1-5\" data-name=\"Delivery Rider job listing row\" href=\"#delivery-rider\">\n                    <div class=\"row-top\" data-kid=\"1-2-3-1-5-1\" data-name=\"job row top with title and post time\">\n                        <span class=\"job-title\" data-kid=\"1-2-3-1-5-1-1\" data-name=\"job listing title\">\n                            Delivery Rider\n                        </span>\n                        <span class=\"posted\" data-kid=\"1-2-3-1-5-1-2\" data-name=\"posted time label\">\n                            2d ago\n                        </span>\n                    </div>\n                    <div class=\"company\" data-kid=\"1-2-3-1-5-2\" data-name=\"job listing company name\">\n                        QuickDeliver\n                    </div>\n                    <div class=\"row-facts\" data-kid=\"1-2-3-1-5-3\" data-name=\"job row pay and location facts\">\n                        <span class=\"pay\" data-kid=\"1-2-3-1-5-3-1\" data-name=\"job listing pay amount\">\n                            ₱12k + tips\n                        </span>\n                        <span class=\"location\" data-kid=\"1-2-3-1-5-3-2\" data-name=\"job listing location with icon\">\n                            <i class=\"icon-map-pin\" data-kid=\"1-2-3-1-5-3-2-1\" data-name=\"map pin location icon\">\n                            </i>\n                            Cogon\n                        </span>\n                    </div>\n                    <span class=\"type-label\" data-kid=\"1-2-3-1-5-4\" data-name=\"job listing employment type label\">\n                        Contract · Own motorcycle required\n                    </span>\n                </a>\n            </aside>\n            <article aria-labelledby=\"job-title\" class=\"details\" data-kid=\"1-2-3-2\" data-name=\"selected job detail article\" id=\"store-manager\">\n                <div class=\"detail-head\" data-kid=\"1-2-3-2-1\" data-name=\"job detail header block\">\n                    <a class=\"back-mobile\" data-kid=\"1-2-3-2-1-1\" data-name=\"mobile back to jobs link\" href=\"#jobs\">\n                        <i class=\"icon-arrow-left\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"left arrow icon\">\n                        </i>\n                        Back to jobs\n                    </a>\n                    <div class=\"detail-kicker\" data-kid=\"1-2-3-2-1-2\" data-name=\"detail kicker with verification note\">\n                        <span data-kid=\"1-2-3-2-1-2-1\" data-name=\"detail kicker label text\">\n                            Job details\n                        </span>\n                        <span class=\"verified\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"employer verification note text\">\n                            Employer documents reviewed\n                        </span>\n                    </div>\n                    <h2 data-dynamic=\"true\" data-kid=\"1-2-3-2-1-3\" data-name=\"job detail headline\" data-reason=\"text rewritten by job-selection script (was Store Manager)\" id=\"job-title\">\n                        Store Manager\n                    </h2>\n                    <div class=\"employer\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-4\" data-name=\"job detail employer name with verification badge\" data-reason=\"text rewritten by job-selection script (was Digos Central Mall)\">\n                        Digos Central Mall\n                        <span class=\"verified-check\" data-kid=\"1-2-3-2-1-4-1\" data-name=\"verified employer badge with icon\">\n                            <i class=\"icon-shield-check\" data-kid=\"1-2-3-2-1-4-1-1\" data-name=\"verified employer shield check icon\">\n                            </i>\n                            Verified employer\n                        </span>\n                    </div>\n                    <div aria-label=\"Job facts\" class=\"facts\" data-kid=\"1-2-3-2-1-5\" data-name=\"job facts grid (pay, type, location, setup)\">\n                        <div class=\"fact\" data-kid=\"1-2-3-2-1-5-1\" data-name=\"pay fact cell\">\n                            <span class=\"fact-label\" data-kid=\"1-2-3-2-1-5-1-1\" data-name=\"pay fact label\">\n                                Pay\n                            </span>\n                            <span class=\"fact-value pay-value\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-5-1-2\" data-name=\"pay fact value\" data-reason=\"text rewritten by job-selection script (was monthly pay range)\">\n                                ₱15k–₱20k / mo\n                            </span>\n                        </div>\n                        <div class=\"fact\" data-kid=\"1-2-3-2-1-5-2\" data-name=\"work type fact cell\">\n                            <span class=\"fact-label\" data-kid=\"1-2-3-2-1-5-2-1\" data-name=\"work type fact label\">\n                                Work type\n                            </span>\n                            <span class=\"fact-value\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-5-2-2\" data-name=\"work type fact value\" data-reason=\"text rewritten by job-selection script (was Full-time)\">\n                                Full-time\n                            </span>\n                        </div>\n                        <div class=\"fact\" data-kid=\"1-2-3-2-1-5-3\" data-name=\"location fact cell\">\n                            <span class=\"fact-label\" data-kid=\"1-2-3-2-1-5-3-1\" data-name=\"location fact label\">\n                                Location\n                            </span>\n                            <span class=\"fact-value\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-5-3-2\" data-name=\"location fact value\" data-reason=\"text rewritten by job-selection script (was Zone 1 Poblacion)\">\n                                Zone 1 (Poblacion)\n                            </span>\n                        </div>\n                        <div class=\"fact\" data-kid=\"1-2-3-2-1-5-4\" data-name=\"getting there fact cell\">\n                            <span class=\"fact-label\" data-kid=\"1-2-3-2-1-5-4-1\" data-name=\"getting there fact label\">\n                                Getting there\n                            </span>\n                            <span class=\"fact-value\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-5-4-2\" data-name=\"getting there fact value\" data-reason=\"text rewritten by job-selection script (was walk description)\">\n                                Walk from Public Market\n                            </span>\n                        </div>\n                        <div class=\"fact\" data-kid=\"1-2-3-2-1-5-5\" data-name=\"work setup fact cell\">\n                            <span class=\"fact-label\" data-kid=\"1-2-3-2-1-5-5-1\" data-name=\"work setup fact label\">\n                                Work setup\n                            </span>\n                            <span class=\"fact-value\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-5-5-2\" data-name=\"work setup fact value\" data-reason=\"text rewritten by job-selection script (was Not specified)\">\n                                Not specified\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"detail-content\" data-kid=\"1-2-3-2-2\" data-name=\"job detail body content\">\n                    <section data-kid=\"1-2-3-2-2-1\" data-name=\"application requirements section\">\n                        <h3 data-kid=\"1-2-3-2-2-1-1\" data-name=\"requirements section heading\">\n                            What you’ll need to apply\n                        </h3>\n                        <ul class=\"requirements\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"requirements bulleted list\">\n                            <li data-dynamic=\"true\" data-kid=\"1-2-3-2-2-1-2-1\" data-name=\"requirement item\" data-reason=\"text rewritten by job-selection script (was residency requirement)\">\n                                Resident of Digos City, preferably near Zone 1 (Poblacion).\n                            </li>\n                            <li data-dynamic=\"true\" data-kid=\"1-2-3-2-2-1-2-2\" data-name=\"requirement item\" data-reason=\"text rewritten by job-selection script (was experience requirement)\">\n                                At least 6 months of related experience.\n                            </li>\n                            <li data-dynamic=\"true\" data-kid=\"1-2-3-2-2-1-2-3\" data-name=\"requirement item\" data-reason=\"text rewritten by job-selection script (was communication skills requirement)\">\n                                Strong communication skills and a customer-first attitude.\n                            </li>\n                            <li data-dynamic=\"true\" data-kid=\"1-2-3-2-2-1-2-4\" data-name=\"requirement item\" data-reason=\"text rewritten by job-selection script (was start-date requirement)\">\n                                Available to start immediately.\n                            </li>\n                        </ul>\n                    </section>\n                    <section data-kid=\"1-2-3-2-2-2\" data-name=\"about this work section\">\n                        <h3 data-kid=\"1-2-3-2-2-2-1\" data-name=\"about this work section heading\">\n                            About this work\n                        </h3>\n                        <p data-dynamic=\"true\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"about this work description paragraph\" data-reason=\"text rewritten by job-selection script (was Store Manager paragraph)\">\n                            Join the team at Digos Central Mall to support daily store operations, customer service and local inventory. The employer’s listing describes a nearby, full-time role.\n                        </p>\n                    </section>\n                </div>\n                <div class=\"detail-actions\" data-kid=\"1-2-3-2-3\" data-name=\"job detail sticky action bar\">\n                    <span class=\"action-note\" data-dynamic=\"true\" data-kid=\"1-2-3-2-3-1\" data-name=\"action bar helper note\" data-reason=\"text rewritten by job-selection script (was Store Manager form note)\">\n                        Apply using the Digos Talent Form. A résumé is optional.\n                    </span>\n                    <div class=\"action-group\" data-kid=\"1-2-3-2-3-2\" data-name=\"action button group\">\n                        <button class=\"button-secondary\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"save for later secondary button\" type=\"button\">\n                            Save for later\n                        </button>\n                        <a class=\"button-primary\" data-dynamic=\"true\" data-kid=\"1-2-3-2-3-2-2\" data-name=\"apply for Store Manager primary button\" data-reason=\"label text and href rewritten by job-selection script (was Store Manager)\" href=\"#apply\">\n                            Apply for Store Manager\n                            <i class=\"icon-arrow-right\" data-kid=\"1-2-3-2-3-2-2-1\" data-name=\"right arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </article>\n        </section>\n        <p class=\"footer-note\" data-kid=\"1-2-4\" data-name=\"footer disclaimer note\">\n            Job information is shown as provided. Confirm details with the employer before making arrangements.\n        </p>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-11T13:23:21.161546+00:00",
