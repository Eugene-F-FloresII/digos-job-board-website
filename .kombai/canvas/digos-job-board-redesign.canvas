      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.d-page { min-height:100vh; background:#2b2622; color:#f7f5f0; font-family:Inter,system-ui,sans-serif; }\n.d-page * { box-sizing:border-box; }\n.d-header { height:68px; border-bottom:1px solid #3f3a36; display:flex; align-items:center; justify-content:space-between; padding:0 48px; }\n.d-brand { display:flex; align-items:center; gap:10px; color:#f7f5f0; text-decoration:none; font-size:14px; font-weight:500; }\n.d-mark { display:grid; place-items:center; width:30px; height:30px; border:1px solid #aea69c; border-radius:3px; font-size:13px; }\n.d-city { color:#aea69c; font-size:12px; margin-left:12px; }\n.d-nav { display:flex; align-items:center; gap:34px; }\n.d-nav a { color:#c9c0ad; font-size:13px; text-decoration:none; padding:25px 0 23px; border-bottom:1px solid transparent; }\n.d-nav a[aria-current=page] { color:#f7f5f0; border-color:#f7f5f0; }\n.d-shell { max-width:1360px; margin:0 auto; padding:30px 40px 24px; }\n.d-headline { display:flex; justify-content:space-between; align-items:flex-end; gap:32px; margin:0 0 22px; }\n.d-headline h1 { margin:0; font-size:30px; font-weight:400; letter-spacing:-1px; line-height:1.15; }\n.d-headline p { margin:8px 0 0; color:#c9c0ad; font-size:14px; line-height:21px; }\n.d-count { color:#aea69c; font-family:'DM Mono',monospace; font-size:12px; white-space:nowrap; padding-bottom:4px; }\n.d-search { display:grid; grid-template-columns:minmax(300px,1.6fr) minmax(220px,.7fr) auto; gap:14px; align-items:end; padding:17px 0 19px; border-top:1px solid #3f3a36; border-bottom:1px solid #3f3a36; }\n.d-field label { display:block; color:#dad2c1; font-size:12px; margin-bottom:7px; }\n.d-control { height:43px; width:100%; padding:0 12px; border:1px solid #3f3a36; border-radius:3px; background:#383330; color:#f7f5f0; font:400 13px Inter,system-ui,sans-serif; display:flex; align-items:center; gap:10px; }\n.d-control input { width:100%; border:0; outline:0; background:transparent; color:#f7f5f0; font:inherit; }\n.d-control input::placeholder { color:#aea69c; opacity:1; }\n.d-control select { width:100%; border:0; outline:0; background:#383330; color:#f7f5f0; font:inherit; appearance:none; }\n.d-button { height:43px; border:1px solid #f7f5f0; border-radius:3px; padding:0 19px; background:#f7f5f0; color:#2b2622; font:500 13px Inter,system-ui,sans-serif; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:9px; cursor:pointer; white-space:nowrap; }\n.d-button:focus-visible,.d-control:focus-within,.d-nav a:focus-visible,.d-row:focus-visible { outline:2px solid #f7f5f0; outline-offset:3px; }\n.d-filterbar { display:flex; align-items:center; justify-content:space-between; min-height:53px; gap:16px; }\n.d-filters { display:flex; gap:8px; flex-wrap:wrap; }\n.d-filter { border:1px solid #3f3a36; border-radius:3px; background:transparent; color:#c9c0ad; font:400 12px Inter,system-ui,sans-serif; padding:8px 11px; }\n.d-filter[aria-pressed=true] { color:#f7f5f0; border-color:#aea69c; background:#383330; }\n.d-filter-note { font-size:12px; color:#aea69c; white-space:nowrap; }\n.d-results-layout { display:grid; grid-template-columns:minmax(350px, .82fr) minmax(0,1.45fr); border:1px solid #3f3a36; border-radius:4px; min-height:610px; overflow:hidden; }\n.d-results { border-right:1px solid #3f3a36; background:#2b2622; }\n.d-results-top { min-height:43px; display:flex; justify-content:space-between; align-items:center; padding:0 17px; border-bottom:1px solid #3f3a36; color:#dad2c1; font-size:12px; }\n.d-results-top span:last-child { color:#aea69c; font:400 11px 'DM Mono',monospace; }\n.d-row { display:block; padding:15px 17px 14px; border-bottom:1px solid #3f3a36; color:inherit; text-decoration:none; }\n.d-row.is-active { background:#383330; box-shadow:inset 2px 0 0 #f7f5f0; }\n.d-row-top { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }\n.d-role { margin:0; font-size:15px; font-weight:500; line-height:20px; }\n.d-posted { color:#aea69c; font-size:11px; white-space:nowrap; }\n.d-company { color:#c9c0ad; font-size:12px; margin-top:4px; }\n.d-pay { color:#f7f5f0; font:500 13px 'DM Mono',monospace; margin-top:11px; }\n.d-meta { display:flex; align-items:center; flex-wrap:wrap; column-gap:16px; row-gap:6px; color:#c9c0ad; font-size:11px; margin-top:8px; }\n.d-meta span { display:inline-flex; align-items:center; gap:5px; }\n.d-meta i { font-size:13px; color:#aea69c; }\n.d-verify { color:#dad2c1!important; }\n.d-detail { display:flex; flex-direction:column; background:#383330; }\n.d-detail-main { padding:23px 26px 20px; flex:1; }\n.d-detail-head { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; padding-bottom:19px; border-bottom:1px solid #3f3a36; }\n.d-detail-title { margin:0; font-size:26px; line-height:32px; font-weight:400; letter-spacing:-.7px; }\n.d-detail-company { color:#dad2c1; font-size:14px; margin-top:6px; }\n.d-review { display:inline-flex; align-items:center; gap:7px; color:#dad2c1; font-size:12px; margin-top:10px; }\n.d-review i { color:#f7f5f0; font-size:14px; }\n.d-facts { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); margin:0; border-bottom:1px solid #3f3a36; }\n.d-fact { padding:14px 12px 15px 0; }\n.d-fact + .d-fact { padding-left:15px; border-left:1px solid #3f3a36; }\n.d-fact dt { color:#aea69c; font-size:11px; margin-bottom:7px; }\n.d-fact dd { margin:0; color:#f7f5f0; font-size:13px; line-height:19px; }\n.d-fact .mono { font-family:'DM Mono',monospace; font-size:12px; }\n.d-detail-copy { display:grid; grid-template-columns:1fr .82fr; gap:28px; padding-top:19px; }\n.d-detail-copy h2 { margin:0 0 8px; color:#f7f5f0; font-size:14px; font-weight:500; }\n.d-detail-copy p { margin:0; color:#c9c0ad; font-size:12px; line-height:19px; }\n.d-general { border-left:1px solid #3f3a36; padding-left:19px; }\n.d-general ul { margin:7px 0 0; padding-left:17px; color:#c9c0ad; font-size:12px; line-height:20px; }\n.d-general li { padding-left:2px; margin:4px 0; }\n.d-detail-footer { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:13px 25px; border-top:1px solid #3f3a36; }\n.d-footer-note { max-width:440px; color:#aea69c; font-size:11px; line-height:17px; }\n.d-bottomline { display:flex; justify-content:space-between; gap:16px; border-top:1px solid #3f3a36; margin-top:18px; padding-top:13px; color:#aea69c; font-size:11px; }\n.d-bottomline a { color:#c9c0ad; text-decoration:underline; text-underline-offset:3px; }\n@media(max-width:900px) {\n .d-header { padding:0 22px; }\n .d-shell { padding:26px 22px 22px; }\n .d-results-layout { grid-template-columns:minmax(290px,.9fr) minmax(0,1.1fr); }\n .d-facts { grid-template-columns:repeat(2,minmax(0,1fr)); }\n .d-fact:nth-child(3) { padding-left:0; border-left:0; }\n .d-fact:nth-child(3),.d-fact:nth-child(4) { border-top:1px solid #3f3a36; }\n}\n@media(max-width:680px) {\n .d-header { height:auto; min-height:60px; display:block; padding:11px 16px 0; }\n .d-head-top { display:flex; align-items:center; justify-content:space-between; height:34px; }\n .d-nav { height:40px; gap:24px; overflow-x:auto; }\n .d-nav a { padding:11px 0 10px; white-space:nowrap; font-size:12px; }\n .d-shell { padding:22px 16px 20px; }\n .d-headline { align-items:flex-start; margin-bottom:16px; }\n .d-headline h1 { font-size:26px; }\n .d-headline p { font-size:13px; line-height:19px; }\n .d-count { display:none; }\n .d-search { grid-template-columns:1fr; gap:11px; padding:14px 0 15px; }\n .d-button { width:100%; min-height:44px; }\n .d-filterbar { align-items:flex-start; flex-direction:column; padding:13px 0; gap:10px; }\n .d-filter-note { white-space:normal; }\n .d-results-layout { grid-template-columns:1fr; min-height:0; }\n .d-results { border-right:0; border-bottom:1px solid #3f3a36; }\n .d-row { padding:14px; }\n .d-detail-main { padding:20px 16px; }\n .d-detail-head { padding-bottom:15px; }\n .d-detail-title { font-size:23px; }\n .d-facts { grid-template-columns:1fr 1fr; }\n .d-fact { padding:12px 8px 12px 0; }\n .d-fact + .d-fact { padding-left:10px; }\n .d-fact:nth-child(3) { padding-left:0; }\n .d-detail-copy { grid-template-columns:1fr; gap:18px; }\n .d-general { border-left:0; border-top:1px solid #3f3a36; padding:15px 0 0; }\n .d-detail-footer { align-items:stretch; flex-direction:column; padding:14px 16px; }\n .d-bottomline { flex-direction:column; }\n}\n</style>\n<div class=\"d-page\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"d-header\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"d-head-top\" data-kid=\"1-1-1\" data-name=\"header top row with brand and tagline\">\n            <a aria-label=\"DigosJobs home\" class=\"d-brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/\">\n                <span class=\"d-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand mark letter D\">\n                    D\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DigosJobs\n                </span>\n                <span class=\"d-city\" data-kid=\"1-1-1-1-3\" data-name=\"brand city tag\">\n                    Digos City\n                </span>\n            </a>\n            <span class=\"d-count\" data-kid=\"1-1-1-2\" data-name=\"local job board tagline\" style=\"padding:0\">\n                Local job board\n            </span>\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"d-nav\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n            <a aria-current=\"page\" data-kid=\"1-1-2-1\" data-name=\"jobs navigation link\" href=\"/jobs\">\n                Jobs\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"applications navigation link\" href=\"/applicant\">\n                Applications\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"employer portal navigation link\" href=\"/employer\">\n                Employer portal\n            </a>\n        </nav>\n    </header>\n    <main class=\"d-shell\" data-kid=\"1-2\" data-name=\"main content shell\">\n        <section class=\"d-headline\" data-kid=\"1-2-1\" data-name=\"page headline section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"headline text container\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"hero headline text\">\n                    Find work that fits your day in Digos.\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"hero subtitle text\">\n                    Compare pay, area, and the way to get there before you apply.\n                </p>\n            </div>\n            <div class=\"d-count\" data-kid=\"1-2-1-2\" data-name=\"job count indicator\">\n                4 local opportunities shown\n            </div>\n        </section>\n        <form action=\"/jobs\" class=\"d-search\" data-kid=\"1-2-2\" data-name=\"job search form\" method=\"get\">\n            <div class=\"d-field\" data-kid=\"1-2-2-1\" data-name=\"search keyword field\">\n                <label data-kid=\"1-2-2-1-1\" data-name=\"role keyword field label\" for=\"role-query\">\n                    Role or keyword\n                </label>\n                <div class=\"d-control\" data-kid=\"1-2-2-1-2\" data-name=\"keyword input control\">\n                    <i aria-hidden=\"true\" class=\"icon-search\" data-kid=\"1-2-2-1-2-1\" data-name=\"search magnifier icon\">\n                    </i>\n                    <input data-kid=\"1-2-2-1-2-2\" data-name=\"keyword input field\" id=\"role-query\" name=\"q\" placeholder=\"e.g. cashier, driver, barista\" type=\"search\"/>\n                </div>\n            </div>\n            <div class=\"d-field\" data-kid=\"1-2-2-2\" data-name=\"area filter field\">\n                <label data-kid=\"1-2-2-2-1\" data-name=\"area field label\" for=\"barangay-select\">\n                    Barangay or area\n                </label>\n                <div class=\"d-control\" data-kid=\"1-2-2-2-2\" data-name=\"area dropdown control\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-2-2-2-1\" data-name=\"map pin icon\">\n                    </i>\n                    <select data-kid=\"1-2-2-2-2-2\" data-name=\"area selection dropdown\" id=\"barangay-select\" name=\"area\">\n                        <option data-kid=\"1-2-2-2-2-2-1\" data-name=\"all areas option\">\n                            All Digos City\n                        </option>\n                        <option data-kid=\"1-2-2-2-2-2-2\" data-name=\"Zone 1 Poblacion option\">\n                            Zone 1 (Poblacion)\n                        </option>\n                        <option data-kid=\"1-2-2-2-2-2-3\" data-name=\"Tres de Mayo option\">\n                            Tres de Mayo\n                        </option>\n                        <option data-kid=\"1-2-2-2-2-2-4\" data-name=\"Matti Area option\">\n                            Matti Area\n                        </option>\n                        <option data-kid=\"1-2-2-2-2-2-5\" data-name=\"Cogon option\">\n                            Cogon\n                        </option>\n                    </select>\n                </div>\n            </div>\n            <button class=\"d-button\" data-kid=\"1-2-2-3\" data-name=\"search submit button\" type=\"submit\">\n                <i aria-hidden=\"true\" class=\"icon-search\" data-kid=\"1-2-2-3-1\" data-name=\"search magnifier icon\">\n                </i>\n                Search jobs\n            </button>\n        </form>\n        <div class=\"d-filterbar\" data-kid=\"1-2-3\" data-name=\"filter bar row\">\n            <div aria-label=\"Job filters\" class=\"d-filters\" data-kid=\"1-2-3-1\" data-name=\"job filter button group\">\n                <button aria-pressed=\"true\" class=\"d-filter\" data-kid=\"1-2-3-1-1\" data-name=\"all opportunities filter button\" type=\"button\">\n                    All opportunities\n                </button>\n                <button aria-pressed=\"false\" class=\"d-filter\" data-kid=\"1-2-3-1-2\" data-name=\"documents reviewed filter button\" type=\"button\">\n                    Documents reviewed\n                </button>\n                <button aria-pressed=\"false\" class=\"d-filter\" data-kid=\"1-2-3-1-3\" data-name=\"daily gigs filter button\" type=\"button\">\n                    Daily gigs\n                </button>\n            </div>\n            <span class=\"d-filter-note\" data-kid=\"1-2-3-2\" data-name=\"filter help note text\">\n                Browse first. No account is needed to view jobs.\n            </span>\n        </div>\n        <section aria-label=\"Job results and selected job details\" class=\"d-results-layout\" data-kid=\"1-2-4\" data-name=\"job results and detail layout\">\n            <div class=\"d-results\" data-kid=\"1-2-4-1\" data-name=\"job results list panel\">\n                <div class=\"d-results-top\" data-kid=\"1-2-4-1-1\" data-name=\"results list header bar\">\n                    <span data-kid=\"1-2-4-1-1-1\" data-name=\"results list title\">\n                        Available jobs in Digos City\n                    </span>\n                    <span data-kid=\"1-2-4-1-1-2\" data-name=\"results shown count\">\n                        4 shown\n                    </span>\n                </div>\n                <a aria-current=\"true\" class=\"d-row is-active\" data-kid=\"1-2-4-1-2\" data-name=\"active job list row\" href=\"/jobs?jobId=1\">\n                    <div class=\"d-row-top\" data-kid=\"1-2-4-1-2-1\" data-name=\"job row header row\">\n                        <h2 class=\"d-role\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"job title heading\">\n                            Store Manager\n                        </h2>\n                        <span class=\"d-posted\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"posted time label\">\n                            2h ago\n                        </span>\n                    </div>\n                    <div class=\"d-company\" data-kid=\"1-2-4-1-2-2\" data-name=\"job company name\">\n                        Digos Central Mall\n                    </div>\n                    <div class=\"d-pay\" data-kid=\"1-2-4-1-2-3\" data-name=\"job pay amount\">\n                        ₱15k–₱20k\n                        <span data-kid=\"1-2-4-1-2-3-1\" data-name=\"pay period label\" style=\"font:400 11px Inter,sans-serif;color:#c9c0ad\">\n                            / month\n                        </span>\n                    </div>\n                    <div class=\"d-meta\" data-kid=\"1-2-4-1-2-4\" data-name=\"job meta row\">\n                        <span data-kid=\"1-2-4-1-2-4-1\" data-name=\"job location meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-4-1-2-4-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            Zone 1 (Poblacion)\n                        </span>\n                        <span data-kid=\"1-2-4-1-2-4-2\" data-name=\"job type meta item\">\n                            Full-time\n                        </span>\n                        <span data-kid=\"1-2-4-1-2-4-3\" data-name=\"commute info meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-bus\" data-kid=\"1-2-4-1-2-4-3-1\" data-name=\"bus icon\">\n                            </i>\n                            Walk from Public Market\n                        </span>\n                        <span class=\"d-verify\" data-kid=\"1-2-4-1-2-4-4\" data-name=\"documents reviewed verification badge\">\n                            <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-4-1-2-4-4-1\" data-name=\"shield check icon\">\n                            </i>\n                            Documents reviewed\n                        </span>\n                    </div>\n                </a>\n                <a class=\"d-row\" data-kid=\"1-2-4-1-3\" data-name=\"job list row\" href=\"/jobs?jobId=2\">\n                    <div class=\"d-row-top\" data-kid=\"1-2-4-1-3-1\" data-name=\"job row header row\">\n                        <h2 class=\"d-role\" data-kid=\"1-2-4-1-3-1-1\" data-name=\"job title heading\">\n                            Barista\n                        </h2>\n                        <span class=\"d-posted\" data-kid=\"1-2-4-1-3-1-2\" data-name=\"posted time label\">\n                            5h ago\n                        </span>\n                    </div>\n                    <div class=\"d-company\" data-kid=\"1-2-4-1-3-2\" data-name=\"job company name\">\n                        Kapehan sa Digos\n                    </div>\n                    <div class=\"d-pay\" data-kid=\"1-2-4-1-3-3\" data-name=\"job pay amount\">\n                        ₱400\n                        <span data-kid=\"1-2-4-1-3-3-1\" data-name=\"pay period label\" style=\"font:400 11px Inter,sans-serif;color:#c9c0ad\">\n                            / day\n                        </span>\n                    </div>\n                    <div class=\"d-meta\" data-kid=\"1-2-4-1-3-4\" data-name=\"job meta row\">\n                        <span data-kid=\"1-2-4-1-3-4-1\" data-name=\"job location meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-4-1-3-4-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            Tres de Mayo\n                        </span>\n                        <span data-kid=\"1-2-4-1-3-4-2\" data-name=\"job type meta item\">\n                            Daily gig\n                        </span>\n                        <span data-kid=\"1-2-4-1-3-4-3\" data-name=\"commute info meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-bus\" data-kid=\"1-2-4-1-3-4-3-1\" data-name=\"bus icon\">\n                            </i>\n                            1 trike ride from Gaisano\n                        </span>\n                        <span class=\"d-verify\" data-kid=\"1-2-4-1-3-4-4\" data-name=\"documents reviewed verification badge\">\n                            <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-4-1-3-4-4-1\" data-name=\"shield check icon\">\n                            </i>\n                            Documents reviewed\n                        </span>\n                    </div>\n                </a>\n                <a class=\"d-row\" data-kid=\"1-2-4-1-4\" data-name=\"job list row\" href=\"/jobs?jobId=3\">\n                    <div class=\"d-row-top\" data-kid=\"1-2-4-1-4-1\" data-name=\"job row header row\">\n                        <h2 class=\"d-role\" data-kid=\"1-2-4-1-4-1-1\" data-name=\"job title heading\">\n                            Customer Service\n                        </h2>\n                        <span class=\"d-posted\" data-kid=\"1-2-4-1-4-1-2\" data-name=\"posted time label\">\n                            1d ago\n                        </span>\n                    </div>\n                    <div class=\"d-company\" data-kid=\"1-2-4-1-4-2\" data-name=\"job company name\">\n                        Local Telco Branch\n                    </div>\n                    <div class=\"d-pay\" data-kid=\"1-2-4-1-4-3\" data-name=\"job pay amount\">\n                        ₱14k\n                        <span data-kid=\"1-2-4-1-4-3-1\" data-name=\"pay period label\" style=\"font:400 11px Inter,sans-serif;color:#c9c0ad\">\n                            / month\n                        </span>\n                    </div>\n                    <div class=\"d-meta\" data-kid=\"1-2-4-1-4-4\" data-name=\"job meta row\">\n                        <span data-kid=\"1-2-4-1-4-4-1\" data-name=\"job location meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-4-1-4-4-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            Matti Area\n                        </span>\n                        <span data-kid=\"1-2-4-1-4-4-2\" data-name=\"job type meta item\">\n                            Full-time\n                        </span>\n                        <span data-kid=\"1-2-4-1-4-4-3\" data-name=\"commute info meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-map\" data-kid=\"1-2-4-1-4-4-3-1\" data-name=\"map icon\">\n                            </i>\n                            Near Capitol\n                        </span>\n                        <span class=\"d-verify\" data-kid=\"1-2-4-1-4-4-4\" data-name=\"documents reviewed verification badge\">\n                            <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-4-1-4-4-4-1\" data-name=\"shield check icon\">\n                            </i>\n                            Documents reviewed\n                        </span>\n                    </div>\n                </a>\n                <a class=\"d-row\" data-kid=\"1-2-4-1-5\" data-name=\"job list row\" href=\"/jobs?jobId=4\">\n                    <div class=\"d-row-top\" data-kid=\"1-2-4-1-5-1\" data-name=\"job row header row\">\n                        <h2 class=\"d-role\" data-kid=\"1-2-4-1-5-1-1\" data-name=\"job title heading\">\n                            Delivery Rider\n                        </h2>\n                        <span class=\"d-posted\" data-kid=\"1-2-4-1-5-1-2\" data-name=\"posted time label\">\n                            2d ago\n                        </span>\n                    </div>\n                    <div class=\"d-company\" data-kid=\"1-2-4-1-5-2\" data-name=\"job company name\">\n                        QuickDeliver\n                    </div>\n                    <div class=\"d-pay\" data-kid=\"1-2-4-1-5-3\" data-name=\"job pay amount\">\n                        ₱12k + tips\n                        <span data-kid=\"1-2-4-1-5-3-1\" data-name=\"pay period label\" style=\"font:400 11px Inter,sans-serif;color:#c9c0ad\">\n                            / period not specified\n                        </span>\n                    </div>\n                    <div class=\"d-meta\" data-kid=\"1-2-4-1-5-4\" data-name=\"job meta row\">\n                        <span data-kid=\"1-2-4-1-5-4-1\" data-name=\"job location meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-4-1-5-4-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            Cogon\n                        </span>\n                        <span data-kid=\"1-2-4-1-5-4-2\" data-name=\"job type meta item\">\n                            Contract\n                        </span>\n                        <span data-kid=\"1-2-4-1-5-4-3\" data-name=\"commute info meta item\">\n                            <i aria-hidden=\"true\" class=\"icon-bike\" data-kid=\"1-2-4-1-5-4-3-1\" data-name=\"bicycle icon\">\n                            </i>\n                            Own motorcycle\n                        </span>\n                        <span data-kid=\"1-2-4-1-5-4-4\" data-name=\"verification not shown note\">\n                            Verification not shown\n                        </span>\n                    </div>\n                </a>\n            </div>\n            <article class=\"d-detail\" data-kid=\"1-2-4-2\" data-name=\"job detail panel\">\n                <div class=\"d-detail-main\" data-kid=\"1-2-4-2-1\" data-name=\"job detail main content\">\n                    <div class=\"d-detail-head\" data-kid=\"1-2-4-2-1-1\" data-name=\"job detail header row\">\n                        <div data-kid=\"1-2-4-2-1-1-1\" data-name=\"job detail title block\">\n                            <h2 class=\"d-detail-title\" data-kid=\"1-2-4-2-1-1-1-1\" data-name=\"job detail title heading\">\n                                Store Manager\n                            </h2>\n                            <div class=\"d-detail-company\" data-kid=\"1-2-4-2-1-1-1-2\" data-name=\"job detail company name\">\n                                Digos Central Mall\n                            </div>\n                            <div class=\"d-review\" data-kid=\"1-2-4-2-1-1-1-3\" data-name=\"documents reviewed verification note\">\n                                <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-4-2-1-1-1-3-1\" data-name=\"shield check icon\">\n                                </i>\n                                Employer documents reviewed\n                            </div>\n                        </div>\n                        <span class=\"d-count\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"job type label\">\n                            Full-time\n                        </span>\n                    </div>\n                    <dl class=\"d-facts\" data-kid=\"1-2-4-2-1-2\" data-name=\"job facts definition list\">\n                        <div class=\"d-fact\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"pay fact block\">\n                            <dt data-kid=\"1-2-4-2-1-2-1-1\" data-name=\"pay fact label\">\n                                Pay\n                            </dt>\n                            <dd class=\"mono\" data-kid=\"1-2-4-2-1-2-1-2\" data-name=\"pay fact value\">\n                                ₱15k–₱20k / month\n                            </dd>\n                        </div>\n                        <div class=\"d-fact\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"area fact block\">\n                            <dt data-kid=\"1-2-4-2-1-2-2-1\" data-name=\"area fact label\">\n                                Area\n                            </dt>\n                            <dd data-kid=\"1-2-4-2-1-2-2-2\" data-name=\"area fact value\">\n                                Zone 1 (Poblacion)\n                                <br data-kid=\"1-2-4-2-1-2-2-2-1\" data-name=\"line break in area value\"/>\n                                Digos City\n                            </dd>\n                        </div>\n                        <div class=\"d-fact\" data-kid=\"1-2-4-2-1-2-3\" data-name=\"commute fact block\">\n                            <dt data-kid=\"1-2-4-2-1-2-3-1\" data-name=\"commute fact label\">\n                                Getting there\n                            </dt>\n                            <dd data-kid=\"1-2-4-2-1-2-3-2\" data-name=\"commute fact value\">\n                                Walk from Public Market\n                            </dd>\n                        </div>\n                        <div class=\"d-fact\" data-kid=\"1-2-4-2-1-2-4\" data-name=\"work setup fact block\">\n                            <dt data-kid=\"1-2-4-2-1-2-4-1\" data-name=\"work setup fact label\">\n                                Work setup\n                            </dt>\n                            <dd data-kid=\"1-2-4-2-1-2-4-2\" data-name=\"work setup fact value\">\n                                Not specified\n                            </dd>\n                        </div>\n                    </dl>\n                    <div class=\"d-detail-copy\" data-kid=\"1-2-4-2-1-3\" data-name=\"job detail body copy\">\n                        <section data-kid=\"1-2-4-2-1-3-1\" data-name=\"about listing section\">\n                            <h2 data-kid=\"1-2-4-2-1-3-1-1\" data-name=\"about listing heading\">\n                                About this listing\n                            </h2>\n                            <p data-kid=\"1-2-4-2-1-3-1-2\" data-name=\"about listing text\">\n                                Role-specific duties are not included in this preview. Confirm the full job details with the employer before making arrangements.\n                            </p>\n                        </section>\n                        <section class=\"d-general\" data-kid=\"1-2-4-2-1-3-2\" data-name=\"general requirements section\">\n                            <h2 data-kid=\"1-2-4-2-1-3-2-1\" data-name=\"general requirements heading\">\n                                General sample requirements\n                            </h2>\n                            <p data-kid=\"1-2-4-2-1-3-2-2\" data-name=\"general requirements description\">\n                                These are the current general sample requirements, not employer-specific qualifications.\n                            </p>\n                            <ul data-kid=\"1-2-4-2-1-3-2-3\" data-name=\"general requirements list\">\n                                <li data-kid=\"1-2-4-2-1-3-2-3-1\" data-name=\"residency requirement item\">\n                                    Digos City resident, preferably near Zone 1 (Poblacion).\n                                </li>\n                                <li data-kid=\"1-2-4-2-1-3-2-3-2\" data-name=\"experience requirement item\">\n                                    At least 6 months of related experience.\n                                </li>\n                                <li data-kid=\"1-2-4-2-1-3-2-3-3\" data-name=\"communication skills requirement item\">\n                                    Strong communication skills and a customer-first attitude.\n                                </li>\n                                <li data-kid=\"1-2-4-2-1-3-2-3-4\" data-name=\"availability requirement item\">\n                                    Available to start immediately.\n                                </li>\n                            </ul>\n                        </section>\n                    </div>\n                </div>\n                <footer class=\"d-detail-footer\" data-kid=\"1-2-4-2-2\" data-name=\"job detail footer bar\">\n                    <span class=\"d-footer-note\" data-kid=\"1-2-4-2-2-1\" data-name=\"application footer note\">\n                        Apply using the Digos Talent Form. A résumé is optional. Starting the form does not submit an application.\n                    </span>\n                    <a class=\"d-button\" data-kid=\"1-2-4-2-2-2\" data-name=\"apply call-to-action button\" href=\"/jobs?jobId=1&apply=true\">\n                        Start the Digos Talent Form\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                </footer>\n            </article>\n        </section>\n        <footer class=\"d-bottomline\" data-kid=\"1-2-5\" data-name=\"page footer bar\">\n            <span data-kid=\"1-2-5-1\" data-name=\"documents reviewed disclaimer text\">\n                “Documents reviewed” means the employer’s submitted business documents were reviewed; it is not a government endorsement.\n            </span>\n            <span data-kid=\"1-2-5-2\" data-name=\"footer quick links container\">\n                <a data-kid=\"1-2-5-2-1\" data-name=\"check applications link\" href=\"/applicant\">\n                    Already applied? Check applications\n                </a>\n                ·\n                <a data-kid=\"1-2-5-2-2\" data-name=\"employer portal link\" href=\"/employer\">\n                    Posting a job? Employer portal\n                </a>\n            </span>\n        </footer>\n    </main>\n</div>\n",
