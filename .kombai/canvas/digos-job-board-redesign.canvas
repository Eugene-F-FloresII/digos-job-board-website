    "var_fce9df9a0ad3": {
      "type": "variant",
      "label": "C · Employer",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 18900,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root { color-scheme: dark; }\n.employer-screen { min-height: 100vh; background: #2b2622; color: #f7f5f0; font-family: Inter, system-ui, sans-serif; }\n.employer-topbar { min-height: 68px; border-bottom: 1px solid #3f3a36; }\n.employer-topbar-inner { max-width: 1200px; margin: 0 auto; min-height: 68px; padding: 0 32px; display:flex; align-items:center; justify-content:space-between; gap:32px; }\n.employer-brand { font-size:16px; font-weight:600; letter-spacing:-.35px; white-space:nowrap; }\n.employer-nav { display:flex; align-items:center; gap:30px; height:68px; }\n.employer-nav a { display:flex; align-items:center; height:100%; color:#aea69c; text-decoration:none; font-size:13px; font-weight:500; border-bottom:2px solid transparent; }\n.employer-nav a.active { color:#f7f5f0; border-color:#f7f5f0; }\n.employer-identity { color:#c9c0ad; font-size:13px; white-space:nowrap; }\n.employer-main { max-width:1200px; margin:0 auto; padding:44px 32px 80px; }\n.employer-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; padding-bottom:34px; border-bottom:1px solid #3f3a36; }\n.employer-heading h1 { margin:0; color:#f7f5f0; font-size:34px; line-height:1.12; letter-spacing:-1.1px; font-weight:500; }\n.employer-heading p { margin:9px 0 0; color:#c9c0ad; font-size:14px; line-height:21px; }\n.post-button { min-height:40px; padding:0 16px; display:inline-flex; align-items:center; justify-content:center; gap:9px; border:0; border-radius:3px; background:#f7f5f0; color:#2b2622; font:500 13px Inter,system-ui,sans-serif; text-decoration:none; white-space:nowrap; }\n.section-title { margin:0; font-size:18px; line-height:26px; font-weight:500; letter-spacing:-.25px; color:#f7f5f0; }\n.attention { padding:27px 0 35px; border-bottom:1px solid #3f3a36; }\n.attention-grid { display:grid; grid-template-columns:1fr 1fr; gap:44px; margin-top:19px; }\n.attention-item { min-height:82px; display:flex; align-items:flex-start; justify-content:space-between; gap:20px; padding:10px 0; }\n.attention-item + .attention-item { border-left:1px solid #3f3a36; padding-left:42px; }\n.attention-copy h3 { margin:0 0 7px; font-size:15px; line-height:21px; font-weight:500; color:#f7f5f0; }\n.attention-copy p { margin:0; font-size:13px; line-height:20px; color:#aea69c; }\n.attention-action { align-self:center; color:#f7f5f0; font-size:13px; line-height:20px; text-decoration:underline; text-decoration-color:#6d655d; text-underline-offset:4px; white-space:nowrap; }\n.listings { padding-top:33px; }\n.listings-head { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin-bottom:23px; }\n.listings-total { color:#aea69c; font-size:13px; }\n.list-group { margin-top:22px; }\n.group-head { display:flex; align-items:baseline; gap:10px; padding-bottom:10px; border-bottom:1px solid #3f3a36; color:#dad2c1; font-size:12px; letter-spacing:.04em; font-weight:500; text-transform:uppercase; }\n.group-count { color:#aea69c; font:400 12px 'DM Mono',monospace; letter-spacing:0; }\n.job-row { display:grid; grid-template-columns:minmax(220px,1.25fr) minmax(140px,.7fr) minmax(170px,.85fr) minmax(155px,.85fr) auto; align-items:center; gap:22px; min-height:78px; border-bottom:1px solid #3f3a36; }\n.job-name { font-size:15px; line-height:22px; font-weight:500; color:#f7f5f0; }\n.job-meta { color:#c9c0ad; font-size:13px; line-height:20px; }\n.job-meta.muted { color:#aea69c; }\n.job-action { justify-self:end; color:#f7f5f0; font-size:13px; text-decoration:none; white-space:nowrap; }\n.job-action span { padding-left:5px; color:#aea69c; }\n.company-note { margin-top:35px; color:#aea69c; font-size:12px; line-height:19px; }\n@media (max-width: 760px) {\n .employer-topbar-inner { min-height:auto; padding:0 20px; display:grid; grid-template-columns:1fr auto; row-gap:0; }\n .employer-topbar { min-height:0; }\n .employer-brand { padding:18px 0; }\n .employer-identity { font-size:12px; }\n .employer-nav { grid-column:1 / -1; height:46px; justify-content:space-between; gap:12px; border-top:1px solid #3f3a36; }\n .employer-nav a { font-size:12px; }\n .employer-main { padding:30px 20px 56px; }\n .employer-heading { align-items:flex-start; padding-bottom:25px; }\n .employer-heading h1 { font-size:28px; letter-spacing:-.8px; }\n .post-button { min-height:44px; padding:0 12px; font-size:12px; }\n .attention { padding:23px 0 27px; }\n .attention-grid { grid-template-columns:1fr; gap:0; margin-top:12px; }\n .attention-item { min-height:auto; align-items:flex-start; padding:15px 0; }\n .attention-item + .attention-item { border-left:0; border-top:1px solid #3f3a36; padding-left:0; }\n .attention-action { align-self:center; font-size:12px; text-align:right; }\n .listings { padding-top:27px; }\n .listings-head { align-items:flex-start; flex-direction:column; gap:4px; margin-bottom:20px; }\n .job-row { grid-template-columns:minmax(0,1fr) auto; gap:7px 14px; padding:15px 0; }\n .job-name { grid-column:1; }\n .job-row .role-meta { grid-column:1; }\n .job-row .count-meta { grid-column:1; }\n .job-row .date-meta { grid-column:1; }\n .job-action { grid-column:2; grid-row:1 / span 3; white-space:normal; max-width:118px; text-align:right; line-height:19px; }\n .company-note { margin-top:25px; }\n}\n</style>\n<div class=\"employer-screen\" data-kid=\"1\" data-name=\"employer dashboard page container\">\n    <header class=\"employer-topbar\" data-kid=\"1-1\" data-name=\"top navigation header\">\n        <div class=\"employer-topbar-inner\" data-kid=\"1-1-1\" data-name=\"top bar layout row\">\n            <a aria-label=\"DigosJobs home\" class=\"employer-brand\" data-kid=\"1-1-1-1\" data-name=\"brand home link\" href=\"#\">\n                DigosJobs\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"employer-nav\" data-kid=\"1-1-1-2\" data-name=\"primary navigation\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"jobs navigation link\" href=\"#jobs\">\n                    Jobs\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"applications navigation link\" href=\"#applications\">\n                    Applications\n                </a>\n                <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-1-2-3\" data-name=\"employer navigation link (active page)\" href=\"#employer\">\n                    Employer\n                </a>\n            </nav>\n            <div class=\"employer-identity\" data-kid=\"1-1-1-3\" data-name=\"employer identity label\">\n                Digos Central Mall\n            </div>\n        </div>\n    </header>\n    <main class=\"employer-main\" data-kid=\"1-2\" data-name=\"main employer workspace content\">\n        <section aria-labelledby=\"workspace-title\" class=\"employer-heading\" data-kid=\"1-2-1\" data-name=\"workspace heading section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"heading text block\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"workspace title\" id=\"workspace-title\">\n                    Employer workspace\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"workspace location subtitle\">\n                    Digos Central Mall · Digos City\n                </p>\n            </div>\n            <a class=\"post-button\" data-kid=\"1-2-1-2\" data-name=\"post a job call-to-action button\" href=\"#post-job\">\n                <i aria-hidden=\"true\" class=\"icon-plus\" data-kid=\"1-2-1-2-1\" data-name=\"plus icon\">\n                </i>\n                Post a job\n            </a>\n        </section>\n        <section aria-labelledby=\"attention-title\" class=\"attention\" data-kid=\"1-2-2\" data-name=\"needs attention section\">\n            <h2 class=\"section-title\" data-kid=\"1-2-2-1\" data-name=\"needs attention section title\" id=\"attention-title\">\n                Needs your attention\n            </h2>\n            <div class=\"attention-grid\" data-kid=\"1-2-2-2\" data-name=\"attention items grid\">\n                <div class=\"attention-item\" data-kid=\"1-2-2-2-1\" data-name=\"attention item for active job\">\n                    <div class=\"attention-copy\" data-kid=\"1-2-2-2-1-1\" data-name=\"attention item copy block\">\n                        <h3 data-kid=\"1-2-2-2-1-1-1\" data-name=\"attention item job title\">\n                            Store Manager\n                        </h3>\n                        <p data-kid=\"1-2-2-2-1-1-2\" data-name=\"attention item job summary\">\n                            12 applicants · Full-time · Posted Oct 1\n                        </p>\n                    </div>\n                    <a class=\"attention-action\" data-kid=\"1-2-2-2-1-2\" data-name=\"attention review applicants link\" href=\"#store-manager-applicants\">\n                        Review 12 applicants\n                        <span aria-hidden=\"true\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <div class=\"attention-item\" data-kid=\"1-2-2-2-2\" data-name=\"attention item for draft job\">\n                    <div class=\"attention-copy\" data-kid=\"1-2-2-2-2-1\" data-name=\"attention item copy block\">\n                        <h3 data-kid=\"1-2-2-2-2-1-1\" data-name=\"attention item job title\">\n                            Cashier\n                        </h3>\n                        <p data-kid=\"1-2-2-2-2-1-2\" data-name=\"attention item job summary\">\n                            Part-time · Draft\n                        </p>\n                    </div>\n                    <a class=\"attention-action\" data-kid=\"1-2-2-2-2-2\" data-name=\"attention continue draft link\" href=\"#cashier-draft\">\n                        Continue Cashier draft\n                        <span aria-hidden=\"true\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"listings-title\" class=\"listings\" data-kid=\"1-2-3\" data-name=\"job listings section\">\n            <div class=\"listings-head\" data-kid=\"1-2-3-1\" data-name=\"listings header row\">\n                <h2 class=\"section-title\" data-kid=\"1-2-3-1-1\" data-name=\"job listings section title\" id=\"listings-title\">\n                    Job listings\n                </h2>\n                <span class=\"listings-total\" data-kid=\"1-2-3-1-2\" data-name=\"listings total count summary\">\n                    2 total · 1 published · 1 draft\n                </span>\n            </div>\n            <div class=\"list-group\" data-kid=\"1-2-3-2\" data-name=\"published jobs group\" id=\"published\">\n                <div class=\"group-head\" data-kid=\"1-2-3-2-1\" data-name=\"group heading with count\">\n                    Published\n                    <span class=\"group-count\" data-kid=\"1-2-3-2-1-1\" data-name=\"published group count\">\n                        01\n                    </span>\n                </div>\n                <article class=\"job-row\" data-kid=\"1-2-3-2-2\" data-name=\"published job row card\" id=\"store-manager-applicants\">\n                    <div class=\"job-name\" data-kid=\"1-2-3-2-2-1\" data-name=\"job name field\">\n                        Store Manager\n                    </div>\n                    <div class=\"job-meta role-meta\" data-kid=\"1-2-3-2-2-2\" data-name=\"job employment type field\">\n                        Full-time\n                    </div>\n                    <div class=\"job-meta count-meta\" data-kid=\"1-2-3-2-2-3\" data-name=\"job applicant count field\">\n                        12 applicants\n                    </div>\n                    <div class=\"job-meta muted date-meta\" data-kid=\"1-2-3-2-2-4\" data-name=\"job posted date field\">\n                        Posted Oct 1\n                    </div>\n                    <a class=\"job-action\" data-kid=\"1-2-3-2-2-5\" data-name=\"view applicants action link\" href=\"#store-manager-applicants\">\n                        View applicants\n                        <span aria-hidden=\"true\" data-kid=\"1-2-3-2-2-5-1\" data-name=\"action arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </article>\n            </div>\n            <div class=\"list-group\" data-kid=\"1-2-3-3\" data-name=\"draft jobs group\" id=\"drafts\">\n                <div class=\"group-head\" data-kid=\"1-2-3-3-1\" data-name=\"group heading with count\">\n                    Drafts\n                    <span class=\"group-count\" data-kid=\"1-2-3-3-1-1\" data-name=\"draft group count\">\n                        01\n                    </span>\n                </div>\n                <article class=\"job-row\" data-kid=\"1-2-3-3-2\" data-name=\"draft job row card\" id=\"cashier-draft\">\n                    <div class=\"job-name\" data-kid=\"1-2-3-3-2-1\" data-name=\"job name field\">\n                        Cashier\n                    </div>\n                    <div class=\"job-meta role-meta\" data-kid=\"1-2-3-3-2-2\" data-name=\"job employment type field\">\n                        Part-time\n                    </div>\n                    <div class=\"job-meta count-meta\" data-kid=\"1-2-3-3-2-3\" data-name=\"job applicant count field\">\n                        0 applicants\n                    </div>\n                    <div class=\"job-meta muted date-meta\" data-kid=\"1-2-3-3-2-4\" data-name=\"job last edited date field\">\n                        Last edited 2h ago\n                    </div>\n                    <a class=\"job-action\" data-kid=\"1-2-3-3-2-5\" data-name=\"continue editing action link\" href=\"#cashier-draft\">\n                        Continue editing\n                        <span aria-hidden=\"true\" data-kid=\"1-2-3-3-2-5-1\" data-name=\"action arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </article>\n            </div>\n            <p class=\"company-note\" data-kid=\"1-2-3-4\" data-name=\"company overview note text\">\n                A local overview of your published roles, drafts, and applicant activity.\n            </p>\n        </section>\n    </main>\n</div>\n",
