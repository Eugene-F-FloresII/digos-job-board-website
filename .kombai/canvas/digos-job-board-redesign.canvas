    },
    "var_27da98d18fb7": {
      "type": "variant",
      "label": "D · Nearby discovery",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 20440,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.digos-page{min-height:100vh;background:#2b2622;color:#f7f5f0;font-family:Inter,system-ui,sans-serif}\n.digos-wrap{max-width:1248px;margin:0 auto;padding:0 36px}\n.digos-header{border-bottom:1px solid #3f3a36}\n.digos-nav{height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px}\n.digos-brand{display:flex;align-items:center;gap:12px;color:#f7f5f0;text-decoration:none;font-size:15px;font-weight:500;letter-spacing:-.2px}\n.digos-mark{width:34px;height:34px;border:1px solid #aea69c;display:grid;place-items:center;font-size:14px;font-weight:500;letter-spacing:-1px}\n.digos-brand-sub{font-size:12px;color:#aea69c;font-weight:400;margin-left:4px}\n.digos-links{display:flex;align-items:center;gap:34px}\n.digos-links a{color:#c9c0ad;text-decoration:none;font-size:13px;padding:26px 0 24px;border-bottom:1px solid transparent}\n.digos-links a.active{color:#f7f5f0;border-bottom-color:#f7f5f0}\n.digos-links a:hover{color:#f7f5f0}\n.digos-main{padding-top:52px;padding-bottom:60px}\n.digos-intro{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:44px;align-items:end;margin-bottom:36px}\n.digos-intro h1{font-size:46px;line-height:1.08;letter-spacing:-1.6px;font-weight:400;max-width:730px;margin:0}\n.digos-intro p{max-width:620px;margin:16px 0 0;color:#dad2c1;font-size:16px;line-height:1.6}\n.digos-location{display:flex;align-items:flex-start;gap:12px;border-left:1px solid #3f3a36;padding:8px 0 8px 18px;color:#c9c0ad;font-size:13px;line-height:1.55}\n.digos-location i{font-size:16px;color:#f7f5f0;margin-top:1px}\n.digos-location strong{display:block;color:#f7f5f0;font-weight:500;font-size:14px}\n.digos-search{display:grid;grid-template-columns:minmax(280px,1.65fr) minmax(220px,.8fr) 150px;gap:14px;align-items:end;background:#383330;border:1px solid #3f3a36;padding:18px;margin-bottom:33px}\n.digos-field label{display:block;color:#dad2c1;font-size:13px;line-height:20px;margin-bottom:7px}\n.digos-field input,.digos-field select{display:block;width:100%;height:48px;border:1px solid #514b46;border-radius:3px;background:#2b2622;color:#f7f5f0;font:400 14px Inter,system-ui,sans-serif;padding:0 13px;outline:none}\n.digos-field input::placeholder{color:#aea69c;opacity:1}\n.digos-field input:focus,.digos-field select:focus{border-color:#f7f5f0;box-shadow:0 0 0 2px rgba(247,245,240,.16)}\n.digos-searchbtn{height:48px;border:1px solid #f7f5f0;border-radius:3px;background:#f7f5f0;color:#2b2622;padding:0 19px;font:500 14px Inter,system-ui,sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px}\n.digos-searchbtn i{font-size:15px}\n.digos-sectionhead{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:10px}\n.digos-sectionhead h2{font-size:22px;font-weight:500;letter-spacing:-.5px;margin:0}\n.digos-sectionhead p{font-size:13px;color:#aea69c;margin:6px 0 0}\n.digos-job-head,.digos-job-row{display:grid;grid-template-columns:minmax(210px,1.25fr) minmax(155px,.8fr) minmax(155px,.8fr) minmax(225px,1.1fr) 122px;column-gap:18px;align-items:center}\n.digos-job-head{min-height:42px;border-bottom:1px solid #3f3a36;color:#aea69c;font-size:11px;letter-spacing:.04em}\n.digos-job-row{min-height:91px;border-bottom:1px solid #3f3a36;text-decoration:none;color:#f7f5f0;transition:background 150ms ease;position:relative;padding:10px 0}\n.digos-job-row:hover{background:#383330}\n.digos-job-row:focus-visible{outline:2px solid #f7f5f0;outline-offset:2px}\n.digos-role{min-width:0}\n.digos-role strong{display:block;font-size:16px;font-weight:500;line-height:1.4;letter-spacing:-.2px}\n.digos-role span{display:block;color:#c9c0ad;font-size:13px;margin-top:4px}\n.digos-role .digos-review{display:inline-flex;align-items:center;gap:5px;color:#aea69c;font-size:11px;margin-top:5px}\n.digos-review i{font-size:13px;color:#dad2c1}\n.digos-pay strong{display:block;font-family:'DM Mono',monospace;font-weight:400;font-size:14px;line-height:1.4;letter-spacing:-.1px}\n.digos-pay span,.digos-area span,.digos-commute span{display:block;color:#aea69c;font-size:12px;margin-top:4px;line-height:1.35}\n.digos-area strong,.digos-commute strong{display:block;font-size:13px;line-height:1.4;font-weight:400;color:#dad2c1}\n.digos-area{display:flex;align-items:flex-start;gap:8px}\n.digos-area i{font-size:15px;color:#c9c0ad;margin-top:1px;flex:none}\n.digos-commute strong{font-weight:500}\n.digos-job-action{justify-self:end;color:#dad2c1;text-decoration:underline;text-decoration-color:#514b46;text-underline-offset:4px;font-size:12px;white-space:nowrap}\n.digos-job-action i{font-size:12px;margin-left:5px}\n.digos-note{display:flex;align-items:flex-start;gap:10px;margin-top:22px;max-width:830px;color:#aea69c;font-size:12px;line-height:1.6}\n.digos-note i{font-size:15px;color:#dad2c1;margin-top:1px;flex:none}\n.digos-note strong{color:#dad2c1;font-weight:500}\n.digos-footer{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid #3f3a36;margin-top:35px;padding-top:19px;color:#aea69c;font-size:12px}\n.digos-footer-links{display:flex;gap:24px;flex-wrap:wrap}\n.digos-footer a{color:#c9c0ad;text-decoration:none}\n.digos-footer a:hover{color:#f7f5f0;text-decoration:underline;text-underline-offset:3px}\n@media(max-width:900px){.digos-wrap{padding:0 24px}.digos-intro{grid-template-columns:1fr;gap:20px}.digos-location{border-left:0;border-top:1px solid #3f3a36;padding:14px 0 0}.digos-job-head{display:none}.digos-job-row{grid-template-columns:minmax(0,1fr) 170px;gap:9px 16px;padding:16px 0}.digos-role{grid-column:1}.digos-pay{grid-column:2;grid-row:1 / span 2;text-align:right}.digos-area{grid-column:1}.digos-commute{grid-column:1 / -1;display:flex;gap:8px;align-items:baseline}.digos-commute span{margin:0}.digos-job-action{position:absolute;right:0;bottom:15px}.digos-commute{padding-right:85px}}\n@media(max-width:600px){.digos-wrap{padding:0 18px}.digos-nav{height:auto;min-height:61px;display:block;padding-top:13px}.digos-brand{height:35px}.digos-brand-sub{margin-left:auto}.digos-links{height:42px;justify-content:space-between;gap:12px}.digos-links a{padding:12px 0 10px;font-size:12px}.digos-main{padding-top:31px;padding-bottom:38px}.digos-intro{gap:17px;margin-bottom:23px}.digos-intro h1{font-size:34px;line-height:1.1;letter-spacing:-1.1px}.digos-intro p{font-size:14px;line-height:1.55;margin-top:10px}.digos-location{font-size:12px}.digos-search{grid-template-columns:1fr;gap:12px;padding:14px;margin-bottom:28px}.digos-field input,.digos-field select,.digos-searchbtn{height:46px}.digos-sectionhead{align-items:flex-start;flex-direction:column;gap:3px;margin-bottom:7px}.digos-sectionhead h2{font-size:19px}.digos-job-row{grid-template-columns:minmax(0,1fr) 112px;gap:8px 9px;min-height:0;padding:15px 0}.digos-role strong{font-size:15px}.digos-role span{font-size:12px}.digos-role .digos-review{font-size:11px}.digos-pay strong{font-size:12px}.digos-pay span{font-size:11px}.digos-area strong,.digos-commute strong{font-size:12px}.digos-area span,.digos-commute span{font-size:11px}.digos-commute{padding-right:0;display:block}.digos-commute span{margin-top:3px}.digos-job-action{position:static;justify-self:start;grid-column:1 / -1;margin-top:3px;font-size:12px}.digos-note{font-size:11px;margin-top:19px}.digos-footer{align-items:flex-start;flex-direction:column;margin-top:28px;padding-top:15px}.digos-footer-links{gap:17px}}\n</style>\n<div class=\"digos-page\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"digos-header\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"digos-wrap digos-nav\" data-kid=\"1-1-1\" data-name=\"header navigation bar\">\n            <a aria-label=\"DigosJobs home\" class=\"digos-brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#jobs\">\n                <span aria-hidden=\"true\" class=\"digos-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram mark\">\n                    D\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DigosJobs\n                    <span class=\"digos-brand-sub\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand location subtitle\">\n                        Digos City\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"digos-links\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n                <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-1-2-1\" data-name=\"active navigation link (Find jobs)\" href=\"#jobs\">\n                    Find jobs\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"Applications navigation link\" href=\"#applications\">\n                    Applications\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"Employer portal navigation link\" href=\"#employer\">\n                    Employer portal\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"digos-wrap digos-main\" data-kid=\"1-2\" data-name=\"main content section\" id=\"jobs\">\n        <section aria-labelledby=\"page-title\" class=\"digos-intro\" data-kid=\"1-2-1\" data-name=\"intro section with headline and location\">\n            <div data-kid=\"1-2-1-1\" data-name=\"intro headline container\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"hero headline text\" id=\"page-title\">\n                    Find work that fits your day in Digos.\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"hero description text\">\n                    Search by role and barangay. Compare pay, location and how to get there before you apply.\n                </p>\n            </div>\n            <div class=\"digos-location\" data-kid=\"1-2-1-2\" data-name=\"location badge with icon\">\n                <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-1-2-1\" data-name=\"map pin icon\">\n                </i>\n                <div data-kid=\"1-2-1-2-2\" data-name=\"location text container\">\n                    <strong data-kid=\"1-2-1-2-2-1\" data-name=\"location title text\">\n                        Local job listings\n                    </strong>\n                    Digos City, Davao del Sur\n                </div>\n            </div>\n        </section>\n        <form action=\"#jobs\" class=\"digos-search\" data-kid=\"1-2-2\" data-name=\"job search form\">\n            <div class=\"digos-field\" data-kid=\"1-2-2-1\" data-name=\"role search field\">\n                <label data-kid=\"1-2-2-1-1\" data-name=\"role search label\" for=\"role-search\">\n                    Role or keyword\n                </label>\n                <input data-kid=\"1-2-2-1-2\" data-name=\"role search input field\" id=\"role-search\" name=\"q\" placeholder=\"e.g. cashier, driver, barista\" type=\"search\"/>\n            </div>\n            <div class=\"digos-field\" data-kid=\"1-2-2-2\" data-name=\"barangay area field\">\n                <label data-kid=\"1-2-2-2-1\" data-name=\"barangay area label\" for=\"barangay-search\">\n                    Barangay or area\n                </label>\n                <select data-kid=\"1-2-2-2-2\" data-name=\"barangay area select dropdown\" id=\"barangay-search\" name=\"area\">\n                    <option data-kid=\"1-2-2-2-2-1\" data-name=\"default all areas option\">\n                        All areas in Digos City\n                    </option>\n                    <option data-kid=\"1-2-2-2-2-2\" data-name=\"Zone 1 Poblacion option\">\n                        Zone 1 (Poblacion)\n                    </option>\n                    <option data-kid=\"1-2-2-2-2-3\" data-name=\"Tres de Mayo option\">\n                        Tres de Mayo\n                    </option>\n                    <option data-kid=\"1-2-2-2-2-4\" data-name=\"Matti Area option\">\n                        Matti Area\n                    </option>\n                    <option data-kid=\"1-2-2-2-2-5\" data-name=\"Cogon option\">\n                        Cogon\n                    </option>\n                </select>\n            </div>\n            <button class=\"digos-searchbtn\" data-kid=\"1-2-2-3\" data-name=\"find jobs search button\" type=\"submit\">\n                <i aria-hidden=\"true\" class=\"icon-search\" data-kid=\"1-2-2-3-1\" data-name=\"search magnifier icon\">\n                </i>\n                Find jobs\n            </button>\n        </form>\n        <section aria-labelledby=\"open-jobs-title\" data-kid=\"1-2-3\" data-name=\"jobs listing section\">\n            <div class=\"digos-sectionhead\" data-kid=\"1-2-3-1\" data-name=\"section header row\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"section heading container\">\n                    <h2 data-kid=\"1-2-3-1-1-1\" data-name=\"section title text\" id=\"open-jobs-title\">\n                        Jobs open in Digos City\n                    </h2>\n                    <p data-kid=\"1-2-3-1-1-2\" data-name=\"section subtitle text\">\n                        Pay, place, and commute details shown where provided.\n                    </p>\n                </div>\n            </div>\n            <div aria-hidden=\"true\" class=\"digos-job-head\" data-kid=\"1-2-3-2\" data-name=\"jobs table column header\">\n                <span data-kid=\"1-2-3-2-1\" data-name=\"role column header label\">\n                    Role and employer\n                </span>\n                <span data-kid=\"1-2-3-2-2\" data-name=\"pay column header label\">\n                    Pay and period\n                </span>\n                <span data-kid=\"1-2-3-2-3\" data-name=\"area column header label\">\n                    Area\n                </span>\n                <span data-kid=\"1-2-3-2-4\" data-name=\"commute column header label\">\n                    Getting there\n                </span>\n                <span data-kid=\"1-2-3-2-5\" data-name=\"action column empty header\">\n                </span>\n            </div>\n            <a aria-label=\"View Store Manager at Digos Central Mall\" class=\"digos-job-row\" data-kid=\"1-2-3-3\" data-name=\"job listing row (Store Manager)\" href=\"#store-manager\">\n                <span class=\"digos-role\" data-kid=\"1-2-3-3-1\" data-name=\"job role and employer cell\">\n                    <strong data-kid=\"1-2-3-3-1-1\" data-name=\"job title text\">\n                        Store Manager\n                    </strong>\n                    <span data-kid=\"1-2-3-3-1-2\" data-name=\"employer name text\">\n                        Digos Central Mall\n                    </span>\n                    <span class=\"digos-review\" data-kid=\"1-2-3-3-1-3\" data-name=\"document verification badge\">\n                        <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-3-3-1-3-1\" data-name=\"shield check icon\">\n                        </i>\n                        Documents reviewed\n                    </span>\n                </span>\n                <span class=\"digos-pay\" data-kid=\"1-2-3-3-2\" data-name=\"pay range cell\">\n                    <strong data-kid=\"1-2-3-3-2-1\" data-name=\"pay amount text\">\n                        ₱15k–₱20k\n                    </strong>\n                    <span data-kid=\"1-2-3-3-2-2\" data-name=\"pay period and type text\">\n                        per month · Full-time\n                    </span>\n                </span>\n                <span class=\"digos-area\" data-kid=\"1-2-3-3-3\" data-name=\"job location cell\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-3-3-3-1\" data-name=\"map pin icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-3-3-2\" data-name=\"location text container\">\n                        <strong data-kid=\"1-2-3-3-3-2-1\" data-name=\"area name text\">\n                            Zone 1\n                        </strong>\n                        <span data-kid=\"1-2-3-3-3-2-2\" data-name=\"city name text\">\n                            Poblacion\n                        </span>\n                    </span>\n                </span>\n                <span class=\"digos-commute\" data-kid=\"1-2-3-3-4\" data-name=\"commute info cell\">\n                    <span data-kid=\"1-2-3-3-4-1\" data-name=\"commute label text\">\n                        Getting there\n                    </span>\n                    <strong data-kid=\"1-2-3-3-4-2\" data-name=\"commute description text\">\n                        Walk from Public Market\n                    </strong>\n                </span>\n                <span class=\"digos-job-action\" data-kid=\"1-2-3-3-5\" data-name=\"view details action link\">\n                    View details\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-3-3-5-1\" data-name=\"arrow up right icon\">\n                    </i>\n                </span>\n            </a>\n            <a aria-label=\"View Barista at Kapehan sa Digos\" class=\"digos-job-row\" data-kid=\"1-2-3-4\" data-name=\"job listing row (Barista)\" href=\"#barista\">\n                <span class=\"digos-role\" data-kid=\"1-2-3-4-1\" data-name=\"job role and employer cell\">\n                    <strong data-kid=\"1-2-3-4-1-1\" data-name=\"job title text\">\n                        Barista\n                    </strong>\n                    <span data-kid=\"1-2-3-4-1-2\" data-name=\"employer name text\">\n                        Kapehan sa Digos\n                    </span>\n                    <span class=\"digos-review\" data-kid=\"1-2-3-4-1-3\" data-name=\"document verification badge\">\n                        <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-3-4-1-3-1\" data-name=\"shield check icon\">\n                        </i>\n                        Documents reviewed\n                    </span>\n                </span>\n                <span class=\"digos-pay\" data-kid=\"1-2-3-4-2\" data-name=\"pay range cell\">\n                    <strong data-kid=\"1-2-3-4-2-1\" data-name=\"pay amount text\">\n                        ₱400\n                    </strong>\n                    <span data-kid=\"1-2-3-4-2-2\" data-name=\"pay period and type text\">\n                        per day · Daily gig\n                    </span>\n                </span>\n                <span class=\"digos-area\" data-kid=\"1-2-3-4-3\" data-name=\"job location cell\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-3-4-3-1\" data-name=\"map pin icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-4-3-2\" data-name=\"location text container\">\n                        <strong data-kid=\"1-2-3-4-3-2-1\" data-name=\"area name text\">\n                            Tres de Mayo\n                        </strong>\n                        <span data-kid=\"1-2-3-4-3-2-2\" data-name=\"city name text\">\n                            Digos City\n                        </span>\n                    </span>\n                </span>\n                <span class=\"digos-commute\" data-kid=\"1-2-3-4-4\" data-name=\"commute info cell\">\n                    <span data-kid=\"1-2-3-4-4-1\" data-name=\"commute label text\">\n                        Getting there\n                    </span>\n                    <strong data-kid=\"1-2-3-4-4-2\" data-name=\"commute description text\">\n                        1 trike ride from Gaisano\n                    </strong>\n                </span>\n                <span class=\"digos-job-action\" data-kid=\"1-2-3-4-5\" data-name=\"view details action link\">\n                    View details\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-3-4-5-1\" data-name=\"arrow up right icon\">\n                    </i>\n                </span>\n            </a>\n            <a aria-label=\"View Customer Service at Local Telco Branch\" class=\"digos-job-row\" data-kid=\"1-2-3-5\" data-name=\"job listing row (Customer Service)\" href=\"#customer-service\">\n                <span class=\"digos-role\" data-kid=\"1-2-3-5-1\" data-name=\"job role and employer cell\">\n                    <strong data-kid=\"1-2-3-5-1-1\" data-name=\"job title text\">\n                        Customer Service\n                    </strong>\n                    <span data-kid=\"1-2-3-5-1-2\" data-name=\"employer name text\">\n                        Local Telco Branch\n                    </span>\n                    <span class=\"digos-review\" data-kid=\"1-2-3-5-1-3\" data-name=\"document verification badge\">\n                        <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-3-5-1-3-1\" data-name=\"shield check icon\">\n                        </i>\n                        Documents reviewed\n                    </span>\n                </span>\n                <span class=\"digos-pay\" data-kid=\"1-2-3-5-2\" data-name=\"pay range cell\">\n                    <strong data-kid=\"1-2-3-5-2-1\" data-name=\"pay amount text\">\n                        ₱14k\n                    </strong>\n                    <span data-kid=\"1-2-3-5-2-2\" data-name=\"pay period and type text\">\n                        per month · Full-time\n                    </span>\n                </span>\n                <span class=\"digos-area\" data-kid=\"1-2-3-5-3\" data-name=\"job location cell\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-3-5-3-1\" data-name=\"map pin icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-5-3-2\" data-name=\"location text container\">\n                        <strong data-kid=\"1-2-3-5-3-2-1\" data-name=\"area name text\">\n                            Matti Area\n                        </strong>\n                        <span data-kid=\"1-2-3-5-3-2-2\" data-name=\"city name text\">\n                            Digos City\n                        </span>\n                    </span>\n                </span>\n                <span class=\"digos-commute\" data-kid=\"1-2-3-5-4\" data-name=\"commute info cell\">\n                    <span data-kid=\"1-2-3-5-4-1\" data-name=\"commute label text\">\n                        Getting there\n                    </span>\n                    <strong data-kid=\"1-2-3-5-4-2\" data-name=\"commute description text\">\n                        Near Capitol\n                    </strong>\n                </span>\n                <span class=\"digos-job-action\" data-kid=\"1-2-3-5-5\" data-name=\"view details action link\">\n                    View details\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-3-5-5-1\" data-name=\"arrow up right icon\">\n                    </i>\n                </span>\n            </a>\n            <a aria-label=\"View Delivery Rider at QuickDeliver\" class=\"digos-job-row\" data-kid=\"1-2-3-6\" data-name=\"job listing row (Delivery Rider)\" href=\"#delivery-rider\">\n                <span class=\"digos-role\" data-kid=\"1-2-3-6-1\" data-name=\"job role and employer cell\">\n                    <strong data-kid=\"1-2-3-6-1-1\" data-name=\"job title text\">\n                        Delivery Rider\n                    </strong>\n                    <span data-kid=\"1-2-3-6-1-2\" data-name=\"employer name text\">\n                        QuickDeliver\n                        <span data-kid=\"1-2-3-6-1-2-1\" data-name=\"unverified badge text\" style=\"display:inline;color:#aea69c;font-size:11px;margin-left:4px\">\n                            Verification not shown\n                        </span>\n                    </span>\n                </span>\n                <span class=\"digos-pay\" data-kid=\"1-2-3-6-2\" data-name=\"pay range cell\">\n                    <strong data-kid=\"1-2-3-6-2-1\" data-name=\"pay amount text\">\n                        ₱12k + tips\n                    </strong>\n                    <span data-kid=\"1-2-3-6-2-2\" data-name=\"pay period and type text\">\n                        Contract · Period not specified\n                    </span>\n                </span>\n                <span class=\"digos-area\" data-kid=\"1-2-3-6-3\" data-name=\"job location cell\">\n                    <i aria-hidden=\"true\" class=\"icon-map-pin\" data-kid=\"1-2-3-6-3-1\" data-name=\"map pin icon\">\n                    </i>\n                    <span data-kid=\"1-2-3-6-3-2\" data-name=\"location text container\">\n                        <strong data-kid=\"1-2-3-6-3-2-1\" data-name=\"area name text\">\n                            Cogon\n                        </strong>\n                        <span data-kid=\"1-2-3-6-3-2-2\" data-name=\"city name text\">\n                            Digos City\n                        </span>\n                    </span>\n                </span>\n                <span class=\"digos-commute\" data-kid=\"1-2-3-6-4\" data-name=\"commute info cell\">\n                    <span data-kid=\"1-2-3-6-4-1\" data-name=\"commute label text\">\n                        Getting there\n                    </span>\n                    <strong data-kid=\"1-2-3-6-4-2\" data-name=\"commute description text\">\n                        Own motorcycle required\n                    </strong>\n                </span>\n                <span class=\"digos-job-action\" data-kid=\"1-2-3-6-5\" data-name=\"view details action link\">\n                    View details\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-2-3-6-5-1\" data-name=\"arrow up right icon\">\n                    </i>\n                </span>\n            </a>\n        </section>\n        <aside aria-label=\"Employer verification information\" class=\"digos-note\" data-kid=\"1-2-4\" data-name=\"employer verification note\">\n            <i aria-hidden=\"true\" class=\"icon-info\" data-kid=\"1-2-4-1\" data-name=\"info icon\">\n            </i>\n            <span data-kid=\"1-2-4-2\" data-name=\"note text container\">\n                <strong data-kid=\"1-2-4-2-1\" data-name=\"note title bold text\">\n                    Employer document review.\n                </strong>\n                “Documents reviewed” means business documents were checked by the platform. Jobs without this note remain visible; review employer details before applying.\n            </span>\n        </aside>\n        <footer class=\"digos-footer\" data-kid=\"1-2-5\" data-name=\"page footer bar\">\n            <span data-kid=\"1-2-5-1\" data-name=\"footer tagline text\">\n                DigosJobs · Local openings for Digos City\n            </span>\n            <div class=\"digos-footer-links\" data-kid=\"1-2-5-2\" data-name=\"footer links container\">\n                <a data-kid=\"1-2-5-2-1\" data-name=\"view applications footer link\" href=\"#applications\" id=\"applications\">\n                    Already applied? View applications\n                </a>\n                <a data-kid=\"1-2-5-2-2\" data-name=\"employer portal footer link\" href=\"#employer\" id=\"employer\">\n                    Posting a job? Employer portal\n                </a>\n            </div>\n        </footer>\n    </main>\n</div>\n",
